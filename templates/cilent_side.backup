* { box-sizing: border-box; margin: 0; padding: 0; }

        .vault-container { width: 100%; }

        .sticky-nav-wrapper {
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #1a1a1a;
            padding: 0.5rem 1.5rem;
            border-bottom: 2px solid #333;
            min-height: 60px;
        }

        /* Strictly constrained logo dimensions */
        .logo-container {
            display: flex;
            align-items: center;
            height: 40px; /* Forces container to standard nav height */
        }

        .logo-container img {
            height: 100%;       /* Fills container height */
            width: auto;        /* Keeps aspect ratio */
            max-width: 250px;   /* Prevents extreme stretching on ultra-wide screens */
            object-fit: contain;
            display: block;
        }
const navActions = document.querySelector('.nav-actions');
if (navActions) {
  await setElementStyles(navActions, {
    'flex-wrap': 'nowrap',
    'gap': '8px',
    'width': '100%',
    'box-sizing': 'border-box'
  });

  const children = Array.from(navActions.children);
  for (const child of children) {
    await setElementStyles(child, {
      'flex': '1 1 0%',
      'min-width': '0',
      'padding': '12px 4px',
      'font-size': '12px',
      'display': 'flex',
      'flex-direction': 'column',
      'align-items': 'center',
      'justify-content': 'center',
      'text-align': 'center',
      'word-break': 'break-word',
      'height': 'auto',
      'min-height': '80px'
    });
  }
}
