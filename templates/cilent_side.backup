                            <div style="flex-grow: 1; background: var(--input-bg); border-radius: 4px; padding: 8px 15px; display: flex; align-items: center; border: 1px solid var(--border-ui); min-width: 0;">
                                <label for="comms-input" class="visually-hidden" style="display: none;">Command Input</label>
                                <input type="text" id="comms-input" placeholder="e.g., 'Why is my engine knocking?'" style="width: 100%; border: none; background: transparent; outline: none; font-size: 0.9rem; color: var(--text-main); font-family: 'Inter'; padding: 5px 0; min-width: 0;">
                            </div>
                            <button onclick="sendToPersona()" aria-label="Send Message" style="background: var(--sanctified-blue); color: white; border: 1px solid var(--integrity-gold); width: 45px; height: 45px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: transform 0.2s;" onmousedown="this.style.transform='scale(0.9)'" onmouseup="this.style.transform='scale(1)'">
                                ➔
                            </button>
                        </div>

                        <div style="margin-top: 15px; font-size: 0.65rem; color: var(--text-muted); text-align: center; font-family: 'Courier Prime'; border-top: 1px solid var(--border-ui); padding-top: 10px;">
                            ⚠️ NOTE: The AI gives mechanical advice and system help. Final loan approvals and account changes are handled by the Laveto Management Team.
                        </div>
                    </div>
                </div>
            </div>
        </div>
            </div>
             </div>
         <div class="cockpit-split" style="margin-top: 40px; display: flex; flex-direction: column; align-items: center; max-width: 950px; margin-left: auto; margin-right: auto; width: 100%;">
    <!-- START COCKPIT LEFT -->
    <div class="cockpit-left" style="width: 100%; max-width: 100%; box-sizing: border-box;">
        {% if r.current_status == 'AWAITING PAYMENT' %}
        <div style="background: rgba(211, 47, 47, 0.05); border: 2px solid var(--critical-red); border-left: 6px solid var(--critical-red); padding: 30px; border-radius: 4px; margin-bottom: 30px; animation: pulse-red 2s infinite;">
            <h3 style="color: var(--critical-red); font-family: 'Montserrat'; text-transform: uppercase; letter-spacing: 2px; margin-top: 0; font-size: 1.4rem; text-align: center;">🚨 REPAIR AUTHORIZATION REQUIRED</h3>
            <p style="font-family: 'Inter'; font-size: 1.1rem; color: var(--text-main); margin-bottom: 25px; text-align: center;">
                Critical issues have been found on your vehicle. To begin sourcing parts and assign a mechanic, you must authorize a 50% upfront deposit from your Maintenance Fund.
            </p>
            <div style="display: flex; gap: 20px; align-items: center; background: #000; padding: 20px; border-radius: 2px; border: 1px dashed var(--critical-red); margin-bottom: 25px;">
                <div style="flex: 1; text-align: center; border-right: 1px solid #333;">
                    <div style="font-size: 0.8rem; color: #888; text-transform: uppercase; font-family: 'Courier Prime'; margin-bottom: 5px;">Total Repair Estimate</div>
                    <div style="font-size: 2rem; font-weight: 900; color: var(--critical-red); font-family: 'Courier Prime';">P{{ "{:,.2f}".format(r.target_repair_cost or 0) }}</div>
                </div>
                <div style="flex: 1; text-align: center;">
                    <div style="font-size: 0.8rem; color: #888; text-transform: uppercase; font-family: 'Courier Prime'; margin-bottom: 5px;">Required Deposit (50%)</div>
                    <div style="font-size: 2rem; font-weight: 900; color: var(--integrity-gold); font-family: 'Courier Prime';">P{{ "{:,.2f}".format((r.target_repair_cost or 0) * 0.5) }}</div>
                </div>
            </div>
            <form action="#" method="POST" onsubmit="return confirm('AUTHORIZE REPAIR? This will securely lock your 50% deposit and deploy our mechanics.');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn-touch" style="width: 100%; background: var(--integrity-gold); color: #000; font-weight: 900; font-family: 'Montserrat'; font-size: 1.2rem; letter-spacing: 2px; text-transform: uppercase; border: none; border-radius: 4px; box-shadow: 0 10px 20px rgba(197, 160, 89, 0.4); padding: 20px; transition: 0.3s;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                    🛡️ AUTHORIZE REPAIR & LOCK DEPOSIT
                </button>
            </form>
        </div>
        <a href="/hangar/client-dossier/{{ r.vin_dna }}?source=vault" class="btn-urgent-action">
            🚨 ACTION REQUIRED: REVIEW INSPECTION DETAILS
            <span class="click-badge">CLICK TO OPEN DOSSIER ➡</span>
        </a>

        {% elif r.current_status in ['ACTIVE EXECUTION', 'APPROVED', 'IN SERVICE', 'AWAITING PROCUREMENT'] %}
        <div style="background: rgba(40, 167, 69, 0.05); border: 2px solid var(--integrity-green); border-left: 6px solid var(--integrity-green); padding: 30px; border-radius: 4px; margin-bottom: 30px;">
            <h3 style="color: var(--integrity-green); font-family: 'Montserrat'; text-transform: uppercase; letter-spacing: 2px; margin-top: 0; font-size: 1.4rem;">✅ REPAIR FUNDED & DEPOSIT SECURED</h3>
            <p style="font-family: 'Courier Prime', monospace; font-size: 1.1rem; color: var(--text-main); margin-bottom: 0;">
                Your 50% deposit has been securely locked. The assigned Field Agent has been dispatched. The final payment will only be released once the repair passes the final inspection.
            </p>
        </div>

        {% elif r.current_status == 'COMPLETED' %}
        <div style="background: rgba(0, 51, 102, 0.05); border: 2px solid var(--sanctified-blue); border-left: 6px solid var(--sanctified-blue); padding: 30px; border-radius: 4px; margin-bottom: 30px;">
            <h3 style="color: var(--sanctified-blue); font-family: 'Montserrat'; text-transform: uppercase; letter-spacing: 2px; margin-top: 0; font-size: 1.4rem; text-align: center;">🏆 SANCTIFICATION COMPLETE</h3>
            <p style="font-family: 'Inter', sans-serif; font-size: 1.1rem; color: var(--text-main); margin-bottom: 0; text-align: center;">
                Your vehicle has been successfully restored. The Silence is verified and your asset is protected by the Gospel OS.
            </p>
        </div>
        {% endif %}

        <div style="background: #0a0000; border: 1px solid var(--critical-red); padding: 25px; border-radius: 4px; margin-bottom: 30px; box-shadow: 0 0 20px rgba(211,47,47,0.15); text-align: center; width: 100%; box-sizing: border-box;">
            <h3 style="margin: 0 0 10px 0; color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1.2rem; letter-spacing: 2px; text-transform: uppercase;">
                ⚠️ EMERGENCY DEPLOYMENT
            </h3>
            <p style="color: #ff9999; font-family: 'Inter', sans-serif; font-size: 0.85rem; margin-bottom: 20px; line-height: 1.5;">
                In the event of a critical mechanical failure, collision, or immediate security threat, deploy this beacon. It will instantly transmit your live GPS coordinates to Laveto Command and scramble the nearest Field Agent.
            </p>
            <button type="button" id="clientMaydayBtn" onclick="deployClientBeacon('{{ r.id }}')" style="background: var(--critical-red); color: white; border: none; padding: 18px 30px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1rem; cursor: pointer; text-transform: uppercase; border-radius: 2px; transition: 0.3s; width: 100%; box-shadow: 0 8px 25px rgba(211, 47, 47, 0.4); letter-spacing: 2px;" onmouseover="this.style.background='#b71c1c';" onmouseout="this.style.background='var(--critical-red)';">
                🚨 DEPLOY MAYDAY BEACON (V2)
            </button>
            <div id="maydayStatusText" style="display: none; color: white; font-family: 'Courier Prime', monospace; font-size: 0.8rem; margin-top: 15px; font-weight: bold; letter-spacing: 1px;"></div>
        </div>

        <div class="hero-profile">
            {% set profile_raw = proofs.get('Vehicle Profile') %}
            {% if profile_raw %}
                {% set clean_path = profile_raw|replace('\\', '/') %}
                {% set profile_final = clean_path.split('static/')[-1] if 'static/' in clean_path else clean_path %}
                {% set file_id = '' %}
                {% if '/d/' in profile_final %}
                    {% set file_id = profile_final.split('/d/')[1].split('/')[0] %}
                {% elif 'id=' in profile_final %}
                    {% set file_id = profile_final.split('id=')[1].split('&')[0] %}
                {% endif %}

                {% if file_id %}
                    <img src="https://drive.google.com/thumbnail?id={{ file_id }}&sz=w1000" class="hero-img" alt="Vehicle Profile">
                {% elif profile_final.startswith('http') %}
                    <img src="{{ profile_final }}" class="hero-img" alt="Vehicle Profile" onerror="this.style.display='none'">
                {% else %}
                    <img src="{{ url_for('static', filename=profile_final) }}" class="hero-img" alt="Vehicle Profile" onerror="this.style.display='none'">
                {% endif %}
            {% else %}
                <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: repeating-linear-gradient(45deg, var(--input-bg), var(--input-bg) 10px, var(--card-bg) 10px, var(--card-bg) 20px);">
                    <div style="color: var(--integrity-gold); font-family: 'Montserrat'; font-weight: 900; font-size: 2rem; letter-spacing: 8px; opacity: 0.2;">UPLINK PENDING</div>
                    <div style="color: var(--text-muted); font-family: 'Courier Prime'; font-size: 1rem; margin-top: 15px; font-weight: bold;">AWAITING VEHICLE PROFILE SCAN</div>
                </div>
            {% endif %}

            <div class="hero-overlay">
                <div class="hero-tag">
                    <div style="font-family: 'Courier Prime'; font-size: 0.85rem; color: var(--integrity-gold); text-transform: uppercase; font-weight: bold; letter-spacing: 1px;">Sovereign Asset</div>
                    <div style="font-family: 'Montserrat'; font-weight: 900; color: #fff; font-size: 1.6rem; letter-spacing: 2px; margin-top: 5px;">
                        {{ r.vehicle_year }} {{ r.vehicle_make }} {{ r.vehicle_model }}
                    </div>
                </div>
                <div class="age-badge">
                    System Age: {{ days_active }} Days
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div style="background: linear-gradient(135deg, #0a0a0a 0%, #111 100%); border: 1px solid var(--integrity-gold); border-radius: 2px; padding: 25px; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(197, 160, 89, 0.05);">
                <div style="position: absolute; top: -20px; right: -20px; font-size: 8rem; opacity: 0.03; color: var(--integrity-gold); pointer-events: none;">🪙</div>
                <h3 style="margin: 0 0 5px 0; color: var(--integrity-gold); font-family: 'Montserrat'; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; font-size: 1rem; display: flex; align-items: center; gap: 10px;">
                    <span style="display: inline-block; width: 8px; height: 8px; background: var(--integrity-gold); border-radius: 50%; box-shadow: 0 0 10px var(--integrity-gold); animation: pulse-icon 2s infinite;"></span>
                    Laveto Token (LVT)
                </h3>
                <p style="margin: 0 0 15px 0; color: var(--text-muted); font-size: 0.8rem; font-family: 'Courier Prime'; text-transform: uppercase; font-weight: bold;">Digital Maintenance Wealth</p>
                <div style="font-size: 3.5rem; color: #ffffff; font-family: 'Courier Prime', monospace; font-weight: 900; letter-spacing: -2px; text-shadow: 0 0 20px rgba(197, 160, 89, 0.3); line-height: 1;">
                    {{ "{:,.2f}".format(r.lvt_balance or 0) }} <span style="font-size: 1.2rem; color: var(--integrity-gold); letter-spacing: 1px;">LVT</span>
                </div>
            </div>

            <div style="background: linear-gradient(135deg, #0a0a0a 0%, #111 100%); border: 1px solid var(--integrity-green); border-radius: 2px; padding: 25px; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(40, 167, 69, 0.05);">
                <div style="position: absolute; top: -20px; right: -20px; font-size: 8rem; opacity: 0.03; color: var(--integrity-green); pointer-events: none;">🛡️</div>
                <h3 style="margin: 0 0 5px 0; color: var(--integrity-green); font-family: 'Montserrat'; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; font-size: 1rem; display: flex; align-items: center; gap: 10px;">
                    <span style="display: inline-block; width: 8px; height: 8px; background: var(--integrity-green); border-radius: 50%; box-shadow: 0 0 10px var(--integrity-green);"></span>
                    Sovereign Score
                </h3>
                <p style="margin: 0 0 15px 0; color: var(--text-muted); font-size: 0.8rem; font-family: 'Courier Prime'; text-transform: uppercase; font-weight: bold;">Proof-of-Maintenance Trust</p>
                <div style="font-size: 3.5rem; color: #ffffff; font-family: 'Courier Prime', monospace; font-weight: 900; letter-spacing: -2px; text-shadow: 0 0 20px rgba(40, 167, 69, 0.3); line-height: 1;">
                    {{ r.sovereign_score or 100 }} <span style="font-size: 1.2rem; color: var(--integrity-green); letter-spacing: 1px;">PTS</span>
                </div>
            </div>
        </div>

        <div class="maturity-panel {% if (r.shield_reservoir or 0) <= 0 %}inert-panel{% endif %}" onclick="unsealLaws()">
            <div class="maturity-stats">
                <h3><span class="click-hint">📜</span> ACCOUNT HEALTH & COVENANT</h3>
                <span style="color: var(--integrity-gold); cursor: pointer; text-decoration: underline; font-weight: bold;">(Tap to view terms)</span>
                <div class="progress-track" style="margin-top: 12px;">
                    <div class="progress-fill" style="width: {{ [(chrono_months / 24) * 100, 100]|min }}%; background: linear-gradient(90deg, var(--sanctified-blue) 0%, {{ r.wallet_tier.color if r.wallet_tier else '#C5A059' }} 100%);">{{ chrono_months }} MO</div>
                </div>
                <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 5px; font-family: 'Courier Prime'; font-weight: bold;">
                    NEXT MILESTONE: {{ r.wallet_tier.next_milestone if r.wallet_tier else '12 MONTHS' }}
                </div>
                {% if r.handover_date and now %}
                    {% set shield_days_remaining = 120 - ((now - r.handover_date).days) %}
                    {% if shield_days_remaining > 0 %}
                    <div style="font-size: 0.75rem; color: var(--integrity-gold); margin-top: 8px; font-family: 'Courier Prime'; font-weight: 900; background: rgba(197, 160, 89, 0.1); padding: 5px; border-left: 2px solid var(--integrity-gold); display: inline-block;">
                        TRUTH BOND LABOR SHIELD: {{ shield_days_remaining }} DAYS REMAINING
                    </div>
                    {% else %}
                    <div style="font-size: 0.75rem; color: var(--integrity-green); margin-top: 8px; font-family: 'Courier Prime'; font-weight: 900; background: rgba(40, 167, 69, 0.1); padding: 5px; border-left: 2px solid var(--integrity-green); display: inline-block;">
                        TRUTH BOND LABOR SHIELD: MATURED
                    </div>
                    {% endif %}
                {% endif %}
            </div>
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <div class="tier-display" style="color: {{ r.wallet_tier.color if r.wallet_tier else '#C5A059' }}; text-shadow: 0 0 20px {{ r.wallet_tier.color if r.wallet_tier else '#C5A059' }}40;">{{ r.wallet_tier.name if r.wallet_tier else 'STANDARD TIER' }}</div>
                <div style="font-family: 'Courier Prime'; font-size: 0.65rem; color: var(--text-muted); text-align: center; margin-top: 10px; font-weight: bold;">
                    {{ r.wallet_tier.perk if r.wallet_tier else 'System building trust...' }}
                </div>
            </div>
        </div>
<div style="font-family: 'Montserrat', sans-serif; padding-left: 5px; margin-top: 30px;">
            <p style="margin: 0; font-size: 0.85rem; color: var(--integrity-gold); text-transform: uppercase; letter-spacing: 4px; font-weight: 900;">Uplink Established</p>
            <h2 style="margin: 8px 0 0 0; font-size: 2.2rem; font-weight: 900; color: var(--text-main); letter-spacing: 1px;">
                Pilot: <span style="color: #66b3ff;">{{ r.member_name if r.member_name else 'UNVERIFIED' }}</span>
            </h2>
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--border-ui); padding-bottom: 25px; margin-bottom: 30px; gap: 20px;">
            <div style="flex: 1; min-width: 0;">
                <p style="color: var(--integrity-gold); text-transform: uppercase; font-weight: bold; letter-spacing: 3px; font-size: 0.75rem; margin: 0 0 5px 0; font-family: 'Courier Prime', monospace;">
                    VEHICLE REGISTRY
                </p>
                <h2 style="color: var(--text-main); font-family: 'Montserrat', sans-serif; font-size: clamp(1.2rem, 3.5vw, 1.8rem); margin: 0; letter-spacing: 4px; font-weight: 700; word-break: break-all; line-height: 1.2;">
                    {{ r.vin_dna }}
                </h2>
            </div>

            <div style="text-align: right; flex: 0 0 auto;">
                <p style="color: var(--integrity-gold); text-transform: uppercase; font-weight: bold; letter-spacing: 2px; font-size: 0.85rem; margin: 0 0 5px 0; font-family: 'Courier Prime', monospace;">
                    Network Status
                </p>

                {% if 'ROUTE' in r.status or 'AGENT' in r.status %}
                    <h2 style="color: var(--integrity-green); font-family: 'Montserrat', sans-serif; font-size: clamp(1.2rem, 3.5vw, 1.8rem); margin: 0; font-weight: 900; letter-spacing: 1px; display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                        <span style="font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;">🕵️</span>
                        AGENT <span style="font-weight: 300; opacity: 0.5;">|</span> EN ROUTE
                    </h2>
                {% else %}
                    <h2 style="color: var(--integrity-green); margin: 0; font-weight: 900; font-size: clamp(1.5rem, 3vw, 2.2rem); font-family: 'Montserrat', sans-serif; text-transform: uppercase;">
                        {{ r.status }}
                    </h2>
                {% endif %}
            </div>
        </div>

        <div style="background: var(--input-bg); border: 1px solid var(--integrity-gold); border-radius: 4px; padding: 25px; margin-bottom: 30px; display: flex; justify-content: space-around; font-family: 'Courier Prime', monospace; box-shadow: 0 5px 15px rgba(0,0,0,0.3); flex-wrap: wrap; gap: 15px;">
            <div style="text-align: center; min-width: 120px;">
                <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; font-weight: bold;">OFFICIAL BASELINE</div>
                <div style="font-size: 1.8rem; font-weight: 900; color: var(--text-main);">{{ r.base_mileage or 0 }} KM</div>
            </div>
            <div style="text-align: center; min-width: 120px;">
                <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; font-weight: bold;">CURRENT ODOMETER</div>
                <div style="font-size: 1.8rem; font-weight: 900; color: var(--integrity-green);">{{ r.odometer or 0 }} KM</div>
            </div>
        </div>

        <div class="hardening-status" style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(197, 160, 89, 0.03) 100%);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                 <h3 style="margin: 0; font-family: 'Montserrat'; font-weight: 900; color: var(--integrity-gold); text-transform: uppercase; font-size: 1.1rem; letter-spacing: 2px;">
                    🛡️ Shield Phase
                    <span class="rosetta-sub" style="font-weight: normal; font-family: 'Inter'; font-size: 0.75rem; letter-spacing: 0;">(Vehicle Maintenance Fund Incubation)</span>
                </h3>
                <div style="text-align: right;">
                    {% if r.is_hardened %}
                        <span style="font-family: 'Courier Prime'; font-size: 2.5rem; font-weight: 900; color: var(--integrity-green);">ACTIVE</span>
                    {% else %}
                        <span style="font-family: 'Courier Prime'; font-size: 3rem; font-weight: 900; line-height: 1; color: var(--text-main);">{{ days_remaining | default(120) }}</span>
                        <div style="font-size: 0.8rem; text-transform: uppercase; color: var(--text-muted); font-family: 'Courier Prime'; font-weight: bold; margin-top: 5px;">Days Until Shield Activation</div>
                    {% endif %}
                    <div style="text-align: right; margin-top: 8px;">
                        <span onclick="toggleShieldTerms(event)" style="font-family: 'Courier Prime', monospace; font-size: 0.7rem; color: #C5A059; cursor: pointer; border-bottom: 1px dashed #C5A059; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s;">
                            Tap to view 120-Day Shield Terms
                        </span>
                    </div>
                </div>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: {{ progress_pct | default(0) }}%;">
                    {% if progress_pct %}{{ progress_pct }}%{% else %}0%{% endif %}
                </div>
            </div>
            <div id="shield-terms-box" style="display: none; background: rgba(197, 160, 89, 0.05); border-left: 3px solid #C5A059; padding: 15px; margin-top: 15px; border-radius: 2px; text-align: left;">
                <h4 style="color: #C5A059; margin: 0 0 10px 0; font-family: 'Montserrat', sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;">🛡️ 120-Day Hardening Protocol</h4>
                <p style="font-family: 'Inter', sans-serif; font-size: 0.75rem; color: #aaa; line-height: 1.6; margin: 0; text-transform: none;">
                    The Laveto Sovereign Shield requires a strict <strong>120-day hardening period</strong> from the date of initial account activation. During this incubation phase, your vehicle's mechanical baseline is established.<br><br>
                    <strong style="color: #ddd;">Terms of Activation:</strong><br>
                    1. Emergency repair capital cannot be extracted from the Shield Reservoir until the 120 days have fully elapsed.<br>
                    2. Routine monthly deposits (Pulses) must be maintained without interruption.<br>
                    3. A missed or failed pulse during this phase may flag the account and reset the hardening cycle.
                </p>
            </div>
        </div>

        <a href="{{ url_for('hangar.public_passport', vin_dna=r.vin_dna) }}" target="_blank" class="btn-touch btn-passport-cockpit" style="margin-top: 30px;">
            🌐 VIEW DIGITAL PASSPORT
        </a>
<div style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(197, 160, 89, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 4px solid var(--integrity-gold); padding: 30px; border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
    <h3 style="color: var(--integrity-gold); font-family: 'Montserrat'; margin: 0 0 15px 0; font-size: 1.1rem; font-weight: 900; text-transform: uppercase; display: flex; align-items: center; justify-content: space-between; letter-spacing: 2px; flex-wrap: wrap; gap: 10px; box-sizing: border-box; width: 100%;">
        Telemetry Uplink
        <span style="font-size: 0.7rem; color: var(--text-main); font-family: 'Courier Prime'; background: var(--integrity-green); padding: 5px 10px; border-radius: 2px; border: 1px solid var(--integrity-green); box-shadow: 0 0 10px rgba(40,167,69,0.2);">LIVE MODE</span>
    </h3>
    <span class="rosetta-sub" style="margin-top: -10px; margin-bottom: 15px; display: block; box-sizing: border-box; width: 100%;">(Dashboard Odometer Synchronization)</span>
    <p style="font-size: 0.95rem; color: var(--text-muted); font-family: 'Inter'; margin-bottom: 10px; line-height: 1.6; box-sizing: border-box; width: 100%;">Log your current dashboard mileage to synchronize your vehicle's engine health and maintenance timeline.</p>

    <div style="margin-bottom: 25px; box-sizing: border-box; width: 100%;">
        <span onclick="document.getElementById('telemetry_info_box').style.display = document.getElementById('telemetry_info_box').style.display === 'none' ? 'block' : 'none'" style="font-family: 'Courier Prime'; font-size: 0.8rem; color: var(--integrity-gold); font-weight: bold; cursor: pointer; border-bottom: 1px dashed var(--integrity-gold); text-transform: uppercase; transition: 0.3s; box-sizing: border-box;">[?] HOW THIS WORKS</span>
        <div id="telemetry_info_box" style="display: none; background: var(--input-bg); border-left: 3px solid var(--integrity-gold); padding: 15px; margin-top: 15px; border-radius: 2px; border-top: 1px solid var(--border-ui); border-right: 1px solid var(--border-ui); border-bottom: 1px solid var(--border-ui); box-sizing: border-box; width: 100%; max-width: 100%;">
            <p style="font-size: 0.85rem; color: var(--text-muted); font-family: 'Inter'; margin: 0 0 8px 0; line-height: 1.5; box-sizing: border-box;"><strong>1. The Baseline:</strong> When you leave our bay, we log your exact mileage.</p>
            <p style="font-size: 0.85rem; color: var(--text-muted); font-family: 'Inter'; margin: 0 0 8px 0; line-height: 1.5; box-sizing: border-box;"><strong>2. The Calculation:</strong> By entering your current mileage, the system calculates the exact distance driven since your last service.</p>
            <p style="font-size: 0.85rem; color: var(--text-muted); font-family: 'Inter'; margin: 0; line-height: 1.5; box-sizing: border-box;"><strong>3. The Result:</strong> The Oil Viscosity and Health gauges update instantly. If your oil is degrading, the system will alert you to lock in a new service date.</p>
        </div>
    </div>

    <form id="telemetryForm" style="margin: 0; box-sizing: border-box; width: 100%; max-width: 100%;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <div style="display: flex; gap: 20px; align-items: stretch; flex-wrap: wrap; box-sizing: border-box; width: 100%;">
            <div style="flex: 2; min-width: 200px; position: relative; box-sizing: border-box; max-width: 100%;">
                <label for="odometer_input" style="font-family: 'Courier Prime'; font-size: 0.85rem; font-weight: bold; color: var(--text-muted); display: block; margin-bottom: 10px; text-transform: uppercase; box-sizing: border-box;">Current Odometer (KM)</label>
                <input type="number" id="odometer_input" name="odometer" required value="{{ r.current_odometer if r.current_odometer and r.current_odometer > r.base_mileage else '' }}" placeholder="Baseline: {{ r.base_mileage or 0 }} KM" style="width: 100%; max-width: 100%; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime'; font-size: 1.5rem; font-weight: 900; text-align: center; border-radius: 2px; padding: 0 15px; letter-spacing: 2px; box-sizing: border-box; height: 50px;">
                <div style="position: absolute; right: 15px; top: 65%; transform: translateY(-50%); font-family: 'Montserrat'; font-size: 0.7rem; color: #555; font-weight: 900;">KM</div>
            </div>
            <div style="flex: 1; min-width: 150px; display: flex; align-items: flex-end; box-sizing: border-box; max-width: 100%;">
                <button type="button" id="btnSyncTelemetry" onclick="syncLiveTelemetry(event)" class="btn-touch" style="width: 100%; max-width: 100%; height: 50px; background: var(--integrity-gold); color: #000; border: none; font-family: 'Montserrat'; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; border-radius: 2px; transition: 0.3s; box-shadow: 0 5px 15px rgba(197, 160, 89, 0.3); cursor: pointer; box-sizing: border-box;" onmouseover="this.style.background='#a8823a'" onmouseout="this.style.background='var(--integrity-gold)'">SYNC DATA</button>
            </div>
        </div>
    </form>
    <div id="telemetry_success" style="display:none; margin-top: 20px; font-family: 'Courier Prime'; font-size: 0.85rem; color: var(--integrity-green); font-weight: bold; text-align: center; box-sizing: border-box; width: 100%;">✅ UPLINK SUCCESSFUL. GAUGES SYNCHRONIZED.</div>

    {% set base_km = r.base_mileage | default(0) | int %}
    {% set current_km = r.current_odometer | default(base_km) | int %}
    {% set distance_driven = current_km - base_km %}
    {% if distance_driven < 0 %}{% set distance_driven = 0 %}{% endif %}

    {% set capped_driven = distance_driven if distance_driven < 7500 else 7500 %}
    {% set km_pct = capped_driven / 7500.0 %}

    {% set fill_height = (km_pct * 100) if (km_pct * 100) > 5 else 5 %}

    {% set health_pct = (100 - (km_pct * 100)) | round | int %}
    {% set dash_offset = 251.32 * ((100 - health_pct) / 100) %}

    {% set gauge_color = 'var(--integrity-green)' %}
    {% if health_pct <= 25 %}
        {% set gauge_color = 'var(--critical-red)' %}
    {% elif health_pct <= 50 %}
        {% set gauge_color = 'var(--warning-orange)' %}
    {% endif %}

    <div class="main-grid-sanctuary" style="margin-top: 25px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <div class="card" style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(0, 85, 255, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 5px solid var(--sanctified-blue); border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
            <h4 style="font-family: 'Montserrat', sans-serif; font-size: 1.1rem; color: var(--integrity-gold); text-transform: uppercase; letter-spacing: 3px; margin: 0 0 30px 0; font-weight: 900; text-align: center; box-sizing: border-box; width: 100%;">⚙️ Service Matrix</h4>
            <div class="clock-container" style="box-sizing: border-box; max-width: 100%;">
                <svg class="clock-svg" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="54" class="clock-circle clock-bg" />
                    <circle id="ring_seal" cx="60" cy="60" r="54" class="clock-circle" stroke="#66b3ff" stroke-dasharray="339.29" stroke-dashoffset="0" />
                    <circle cx="60" cy="60" r="40" class="clock-circle clock-bg" />
                    <circle id="ring_fluid" cx="60" cy="60" r="40" class="clock-circle" stroke="{{ gauge_color }}" stroke-dasharray="251.32" stroke-dashoffset="{{ dash_offset }}" style="transition: stroke-dashoffset 1s ease-out, stroke 0.5s ease;" />
                </svg>
                <div class="clock-text">
                    <div class="clock-text-main" id="display_health">{{ health_pct }}%</div>
                    <div class="clock-text-sub">System Health</div>
                </div>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 30px; font-family: 'Courier Prime'; font-size: 0.85rem; color: var(--text-muted); font-weight: bold; box-sizing: border-box; width: 100%;">
                <div><span style="color: var(--integrity-gold);">●</span> FLUIDS</div>
                <div><span style="color: #66b3ff;">●</span> ADMIN</div>
            </div>
            <button onclick="document.getElementById('renewalModal').style.display='flex'" class="btn-touch" style="width: 100%; margin-top: 20px; background: transparent; color: #66b3ff; border: 1px dashed #66b3ff; font-family: 'Montserrat'; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; font-size: 0.85rem; border-radius: 2px; transition: 0.3s; cursor: pointer; box-sizing: border-box; max-width: 100%;" onmouseover="this.style.background='rgba(102,179,255,0.1)'" onmouseout="this.style.background='transparent'">
                🛡️ INITIATE VIP CONCIERGE (LEKGETHO)
            </button>
        </div>

        <div class="card" style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(0, 85, 255, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 5px solid var(--sanctified-blue); border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
            <h4 style="font-family: 'Montserrat', sans-serif; font-size: 1.1rem; color: var(--integrity-gold); text-transform: uppercase; letter-spacing: 3px; margin: 0 0 30px 0; font-weight: 900; text-align: center; box-sizing: border-box; width: 100%;">🛢️ Oil Viscosity</h4>
            <div class="vial-container-wrapper" style="box-sizing: border-box; max-width: 100%;">
                <div class="vial-container">
                    <div class="vial">
                        <div id="vial_fill" class="vial-fill" style="height: {{ fill_height }}%; background-color: {% if km_pct >= 0.9 %}var(--critical-red){% elif km_pct >= 0.75 %}var(--warning-orange){% else %}var(--integrity-gold){% endif %}; transition: height 1s ease, background-color 1s ease;"></div>
                    </div>
                    <div class="vial-markers">
                        <span>7.5K</span><span>5K</span><span>2.5K</span><span>0K</span>
                    </div>
                </div>
                <div class="vial-text-container" style="box-sizing: border-box; max-width: 100%; overflow: hidden;">
                    <div style="font-family: 'Courier Prime'; font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; font-weight: bold;">Distance Driven</div>
                    <div id="display_km" style="font-family: 'Courier Prime'; font-size: 2.8rem; font-weight: 900; color: var(--text-main); margin: 5px 0; letter-spacing: -1px; word-break: break-all; box-sizing: border-box;">{{ "{:,.0f}".format(distance_driven) }}</div>
                    <div style="font-family: 'Courier Prime'; font-size: 0.8rem; color: var(--integrity-gold); font-weight: bold;">KM SINCE SERVICE</div>
                </div>
            </div>
            <div id="fluid_alert" class="fluid-alert-box" style="box-sizing: border-box; width: 100%;"></div>
        </div>
    </div>
</div>

<div class="card" style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(253, 126, 20, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 5px solid var(--warning-orange); border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); display: flex; flex-direction: column; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
    <h4 style="font-family: 'Montserrat', sans-serif; font-size: 1.1rem; color: var(--warning-orange); text-transform: uppercase; letter-spacing: 3px; margin: 0 0 30px 0; font-weight: 900; text-align: center; box-sizing: border-box; word-wrap: break-word;">🛞 TIRE HEALTH & REPLACEMENT</h4>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 15px; margin-bottom: 25px; box-sizing: border-box; width: 100%;">
        {% set t_health = r.tire_health_pct | default(38) | int %}
        {% set t_color = 'var(--integrity-green)' if t_health > 50 else ('var(--warning-orange)' if t_health > 25 else 'var(--critical-red)') %}
        <div style="border: 2px dashed #333; height: 75px; border-radius: 6px; background: repeating-linear-gradient(0deg, #111, #111 4px, #050505 4px, #050505 8px); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(0,0,0,0.8); box-sizing: border-box; max-width: 100%;">
            <span style="color: #666; font-size: 0.6rem; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 2px; box-sizing: border-box;">FRONT L</span>
            <span style="color: {{ t_color }}; font-family: 'Courier Prime'; font-weight: 900; font-size: 1.2rem; box-sizing: border-box;">{{ r.tread_fl | default('3.2') }}<span style="font-size: 0.7rem;">mm</span></span>
        </div>
        <div style="border: 2px dashed #333; height: 75px; border-radius: 6px; background: repeating-linear-gradient(0deg, #111, #111 4px, #050505 4px, #050505 8px); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(0,0,0,0.8); box-sizing: border-box; max-width: 100%;">
            <span style="color: #666; font-size: 0.6rem; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 2px; box-sizing: border-box;">FRONT R</span>
            <span style="color: {{ t_color }}; font-family: 'Courier Prime'; font-weight: 900; font-size: 1.2rem; box-sizing: border-box;">{{ r.tread_fr | default('3.1') }}<span style="font-size: 0.7rem;">mm</span></span>
        </div>
        <div style="border: 2px dashed #333; height: 75px; border-radius: 6px; background: repeating-linear-gradient(0deg, #111, #111 4px, #050505 4px, #050505 8px); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(0,0,0,0.8); box-sizing: border-box; max-width: 100%;">
            <span style="color: #666; font-size: 0.6rem; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 2px; box-sizing: border-box;">REAR L</span>
            <span style="color: {{ t_color }}; font-family: 'Courier Prime'; font-weight: 900; font-size: 1.2rem; box-sizing: border-box;">{{ r.tread_rl | default('3.4') }}<span style="font-size: 0.7rem;">mm</span></span>
        </div>
        <div style="border: 2px dashed #333; height: 75px; border-radius: 6px; background: repeating-linear-gradient(0deg, #111, #111 4px, #050505 4px, #050505 8px); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: inset 0 0 10px rgba(0,0,0,0.8); box-sizing: border-box; max-width: 100%;">
            <span style="color: #666; font-size: 0.6rem; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 2px; box-sizing: border-box;">REAR R</span>
            <span style="color: {{ t_color }}; font-family: 'Courier Prime'; font-weight: 900; font-size: 1.2rem; box-sizing: border-box;">{{ r.tread_rr | default('3.4') }}<span style="font-size: 0.7rem;">mm</span></span>
        </div>
    </div>
    <div style="font-family: 'Inter', sans-serif; font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-bottom: 20px; line-height: 1.5; flex-grow: 1; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">
        Your <strong style="color: #fff;">{{ r.tire_brand | default('Continental') }}</strong> tires have <strong style="color: {{ t_color }};">{{ t_health }}%</strong> tread remaining, with <strong style="color: #fff;">{{ r.tire_months_remaining | default(18) }} months</strong> before structural DOT expiration.
    </div>
    {% if t_health <= 40 %}
    <div style="background: rgba(197, 160, 89, 0.05); border: 1px dashed var(--integrity-gold); padding: 15px; border-radius: 2px; text-align: center; margin-top: auto; box-sizing: border-box; width: 100%; max-width: 100%;">
        <p style="margin: 0 0 8px 0; font-family: 'Montserrat'; font-size: 0.75rem; color: var(--integrity-gold); font-weight: 900; letter-spacing: 1px; text-transform: uppercase; box-sizing: border-box; word-wrap: break-word;">
            ⚠️ Amber Nudge Activated
        </p>
        <p style="margin: 0 0 15px 0; font-size: 0.75rem; color: #ccc; font-family: 'Inter'; line-height: 1.4; box-sizing: border-box; max-width: 100%;">
            Your Yield Engine has enough capital to pre-order your next set at the 80% Anchor rate.
        </p>
        <button type="button" class="btn-touch" onclick="showToast('✅ SILK ROAD UPLINK: Tire pre-order initiated. Check Radar.', 'success')" style="width: 100%; background: var(--integrity-gold); color: #000; border: none; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; border-radius: 2px; transition: 0.3s; box-shadow: 0 5px 15px rgba(197, 160, 89, 0.3); box-sizing: border-box; word-wrap: break-word;" onmouseover="this.style.background='#a8823a'" onmouseout="this.style.background='var(--integrity-gold)'">
            🔒 LOCK WHOLESALE PRICE
        </button>
    </div>
    {% else %}
    <div style="background: rgba(40, 167, 69, 0.05); border: 1px dashed var(--integrity-green); padding: 15px; border-radius: 2px; text-align: center; margin-top: auto; box-sizing: border-box; width: 100%; max-width: 100%;">
        <p style="margin: 0; font-family: 'Montserrat'; font-size: 0.75rem; color: var(--integrity-green); font-weight: 900; letter-spacing: 1px; text-transform: uppercase; box-sizing: border-box; word-wrap: break-word;">
            ✅ GEOMETRY OPTIMAL
        </p>
    </div>
    {% endif %}
</div>

<div style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(40, 167, 69, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 4px solid var(--integrity-green); border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
    <h3 class="section-title" style="margin-bottom: 20px; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">💎 Vault Financials</h3>

    <div style="background: linear-gradient(145deg, var(--input-bg) 0%, rgba(40, 167, 69, 0.05) 100%); border: 1px solid var(--integrity-green); border-radius: 2px; padding: 25px; margin-top: 25px; margin-bottom: 25px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <h4 style="color: var(--integrity-green); margin-top: 0; font-family: 'Montserrat'; text-transform: uppercase; font-size: 1rem; letter-spacing: 1px; display: flex; align-items: center; gap: 10px; box-sizing: border-box; width: 100%; max-width: 100%; flex-wrap: wrap;">
            📥 Log EFT Transfer (Top-Up)
        </h4>
        <p style="font-size: 0.8rem; color: var(--text-muted); font-family: 'Inter'; margin-bottom: 20px; box-sizing: border-box; width: 100%; max-width: 100%;">
            To inject capital, transfer funds to the official Laveto Bank Account (Acc: XXXXXXXX). Enter the exact amount you transferred below. Laveto Command will verify the clearing and manually inject the capital into your 60/40 split.
        </p>
        <form id="eftNotifyForm" onsubmit="notifyEFTTransfer(event)" style="margin: 0; display: flex; gap: 15px; flex-wrap: wrap; align-items: center; box-sizing: border-box; width: 100%; max-width: 100%;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <div style="flex: 2; min-width: 200px; position: relative; box-sizing: border-box; max-width: 100%;">
                <label for="eft_amount_input" class="visually-hidden">EFT Transfer Amount</label>
                <input type="number" id="eft_amount_input" name="reported_amount" step="10" required placeholder="Amount Sent (Pula)" style="width: 100%; max-width: 100%; padding: 15px 15px 15px 40px; background: #000; border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime'; font-size: 1.2rem; font-weight: bold; border-radius: 2px; box-sizing: border-box; transition: 0.3s;" onfocus="this.style.borderColor='var(--integrity-green)'" onblur="this.style.borderColor='var(--border-ui)'">
                <span style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--integrity-green); font-family: 'Montserrat'; font-weight: 900; font-size: 1.2rem;">P</span>
            </div>
            <button type="submit" id="btnNotifyEFT" class="btn-touch" style="flex: 1; min-width: 150px; max-width: 100%; background: transparent; color: var(--integrity-green); border: 2px solid var(--integrity-green); padding: 15px; cursor: pointer; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; border-radius: 2px; transition: 0.3s; box-sizing: border-box;" onmouseover="this.style.background='var(--integrity-green)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-green)';">
                NOTIFY COMMAND
            </button>
        </form>
    </div>

    {% if current_user.is_authenticated and current_user.role == 'admin' %}
    <div style="background: #000; border: 2px dashed var(--integrity-gold); padding: 25px; margin-bottom: 30px; border-radius: 4px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <h3 style="color: var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-weight: 900; margin-top: 0; font-size: 1.1rem; letter-spacing: 2px; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">
            👑 COMMAND: INJECT CAPITAL
        </h3>
        <form action="{{ url_for('process_vault_pulse', asset_id=r.id) }}" method="POST" style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap; margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <div style="flex: 2; min-width: 200px; box-sizing: border-box; max-width: 100%;">
                <label for="admin_deposit_amount" class="visually-hidden">Deposit Amount</label>
                <input type="number" id="admin_deposit_amount" name="deposit_amount" step="0.01" required placeholder="Cleared Amount (Pula)" style="width: 100%; max-width: 100%; padding: 15px; background: var(--input-bg); border: 1px solid var(--integrity-gold); color: var(--integrity-gold); font-family: 'Courier Prime'; font-weight: bold; font-size: 1rem; box-sizing: border-box;">
            </div>
            <button type="submit" class="btn-touch" style="flex: 1; min-width: 150px; max-width: 100%; background: var(--integrity-gold); color: #000; border: none; padding: 15px; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: 0.3s; border-radius: 4px; box-sizing: border-box;" onmouseover="this.style.filter='brightness(1.2)'" onmouseout="this.style.filter='brightness(1)'">
                EXECUTE SPLIT
            </button>
        </form>

        <hr style="border: none; border-top: 1px solid #333; margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%;">

        <h3 style="color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; margin-top: 0; font-size: 1.1rem; letter-spacing: 2px; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">
            🚨 COMMAND: DEPLOY SHIELD CAPITAL
        </h3>
        <form action="{{ url_for('process_repair_deduction', asset_id=r.id) }}" method="POST" style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap; box-sizing: border-box; width: 100%; max-width: 100%;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <div style="flex: 1; min-width: 150px; box-sizing: border-box; max-width: 100%;">
                <label for="admin_repair_reason" class="visually-hidden">Repair Reason</label>
                <input type="text" id="admin_repair_reason" name="repair_reason" required placeholder="Repair Directive (e.g. Brake Pads)" style="width: 100%; max-width: 100%; padding: 15px; background: var(--input-bg); border: 1px solid var(--critical-red); color: #fff; font-family: 'Courier Prime'; font-weight: bold; font-size: 0.9rem; box-sizing: border-box;">
            </div>
            <div style="flex: 1; min-width: 150px; box-sizing: border-box; max-width: 100%;">
                <label for="admin_deduct_amount" class="visually-hidden" style="display:none;">Deduct Amount</label>
                <input type="number" id="admin_deduct_amount" name="deduct_amount" step="0.01" required placeholder="Cost (Pula)" style="width: 100%; max-width: 100%; padding: 15px; background: var(--input-bg); border: 1px solid var(--critical-red); color: var(--critical-red); font-family: 'Courier Prime'; font-weight: bold; font-size: 0.9rem; box-sizing: border-box;">
            </div>
            <button type="submit" class="btn-touch" onclick="return confirm('Execute capital deduction? This will permanently remove funds from the client Shield Reservoir.');" style="flex: 1; min-width: 150px; max-width: 100%; background: transparent; color: var(--critical-red); border: 2px solid var(--critical-red); padding: 13px; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: 0.3s; border-radius: 4px; box-sizing: border-box;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='var(--critical-red)';">
                DEDUCT FUNDS
            </button>
        </form>
    </div>
    {% endif %}
</div>
<section class="cockpit-split">
            <div class="cockpit-left">
                <div class="hardening-status">
                    <h3>Restoration Progress</h3>
                     <div class="progress-track">
                        <div class="progress-fill" style="width: 45%;">45%</div>
                    </div>
                </div>

                 <div class="flicker-engine">
                    <h2 class="section-title">System Integrity</h2>
                    <p>Current capacity: {{ all_records|length if all_records else 0 }} / 500 members.</p>
                </div>

                <!-- 🟢 FIX: Removed overflow: hidden; from the grid to let tooltip escape -->
                <div class="financial-grid" style="box-sizing: border-box; width: 100%; max-width: 100%;">
                    {% set gross_balance = (r.savings_balance or 0) + (r.yield_interest or 0) + (r.shield_reservoir or 0) %}
                    {% set net_retained_equity = gross_balance * 0.95 %}

                    {% set allocated_equity = net_retained_equity * 0.60 %}
                    {% set allocated_shield = net_retained_equity * 0.40 %}

                    <!-- 🟢 FIX: Removed overflow: hidden; from the card -->
                    <div class="fin-card" style="border-top-color: var(--integrity-gold); grid-column: 1 / -1; background: rgba(197, 160, 89, 0.05); box-sizing: border-box; width: 100%; max-width: 100%;">
                        <div class="fin-label" style="color: var(--integrity-gold); font-size: 1rem; box-sizing: border-box; word-wrap: break-word;">Total Savings Equity (Yield + Shield)</div>
                        <div class="fin-value" style="color: var(--integrity-gold); font-size: clamp(1.8rem, 6vw, 3.5rem); box-sizing: border-box; word-break: break-all;">P{{ "{:,.2f}".format(gross_balance) }}</div>
                        <p style="font-family: 'Inter'; font-size: 0.85rem; color: var(--text-muted); margin-top: 10px; box-sizing: border-box; max-width: 100%;">95% of monthly deposits are distributed to capital reservoirs after standard 5% administration processing.</p>
                    </div>

                    <!-- 🟢 FIX: Removed overflow: hidden; from the card -->
                    <div class="fin-card" style="border-top-color: var(--sanctified-blue); box-sizing: border-box; width: 100%; max-width: 100%;">
                        <div class="fin-label" style="box-sizing: border-box; max-width: 100%;">
                            <span class="gospel-tooltip">Equity Reserve (60%)
                                <span class="tooltip-text">Your primary active capital. This generates internal yield and builds your Sovereign purchasing power over time.</span>
                            </span>
                        </div>
                        <div class="fin-value" style="font-size: clamp(1.4rem, 5vw, 2.2rem); box-sizing: border-box; word-break: break-all;">P{{ "{:,.2f}".format(allocated_equity) }}</div>

                        <div style="background: rgba(197, 160, 89, 0.05); border: 1px solid var(--integrity-gold); padding: 20px; border-radius: 4px; margin-top: 20px; box-sizing: border-box; width: 100%; max-width: 100%;">
                            <h4 style="margin: 0 0 5px 0; color: var(--integrity-gold); font-family: 'Courier Prime', monospace; box-sizing: border-box; word-wrap: break-word;">🔒 Laveto Repair Loans</h4>
                            <p style="margin: 0 0 15px 0; color: var(--text-muted); font-size: 0.8rem; box-sizing: border-box;">Locked until Annual Harvest.</p>
                            <button type="button" onclick="document.getElementById('educator-gate-modal').style.display='flex'" class="btn-touch" style="background: transparent; color: var(--text-main); border: 1px solid var(--critical-red); padding: 10px 15px; font-family: 'Montserrat', sans-serif; font-size: 0.75rem; text-transform: uppercase; cursor: pointer; transition: 0.3s; width: 100%; max-width: 100%; border-radius: 4px; box-sizing: border-box;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='white';" onmouseout="this.style.background='transparent'; this.style.color='var(--text-main)';">
                                ⚠️ Request Early Withdrawal
                            </button>
                        </div>
                    </div>

                    <!-- 🟢 FIX: Removed overflow: hidden; from the card -->
                    <div class="fin-card" style="border-top-color: var(--integrity-green); box-sizing: border-box; width: 100%; max-width: 100%;">
                        <div class="fin-label" style="box-sizing: border-box; max-width: 100%;">
                            <span class="gospel-tooltip">Shield Reservoir (40%)
                                <span class="tooltip-text">Your locked emergency liquidity. Strictly reserved for critical mechanical interventions to keep you on the road.</span>
                            </span>
                        </div>
                        <div class="fin-value" style="color: var(--integrity-green); font-size: clamp(1.4rem, 5vw, 2.2rem); box-sizing: border-box; word-break: break-all;">P{{ "{:,.2f}".format(allocated_shield) }}</div>
                    </div>

                    {% set premium = gross_balance * 0.15 %}
                    <!-- 🟢 FIX: Removed overflow: hidden; from the card -->
                    <div class="fin-card" style="border-top-color: #555; background: var(--input-bg); grid-column: 1 / -1; box-sizing: border-box; width: 100%; max-width: 100%;">
                        <div class="fin-label" style="box-sizing: border-box; max-width: 100%;">
                            <span class="gospel-tooltip">Estimated Resale Premium (+15%)
                                <span class="tooltip-text">The mathematical value added to your asset by maintaining a perfect, immutable Laveto mechanical provenance record.</span>
                            </span>
                        </div>
                        <div class="fin-value" style="color: #66b3ff; font-size: clamp(1.6rem, 5vw, 2.2rem); box-sizing: border-box; word-break: break-all;">+P{{ "{:,.2f}".format(premium) }}</div>
                        <p style="font-family: 'Courier Prime'; font-size: 0.75rem; color: var(--text-muted); margin-top: 10px; box-sizing: border-box; max-width: 100%;">Provenance Bonus added upon successful liquidation.</p>
                    </div>
                </div>

            </div>
        </section>
    </div>

                    <div style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(197, 160, 89, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 4px solid var(--integrity-gold); border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); width: 100%; box-sizing: border-box; margin-bottom: 30px; max-width: 100%; overflow: hidden;">
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px; margin-bottom: 25px; flex-wrap: wrap; gap: 15px; box-sizing: border-box; width: 100%; max-width: 100%;">
                            <div style="box-sizing: border-box; max-width: 100%;">
                                <h3 style="color: var(--integrity-gold); margin: 0; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; word-wrap: break-word;">
                                    👁️ Sovereign Exchange
                                </h3>
                                <p style="color: var(--text-muted); font-family: 'Courier Prime', monospace; font-size: 0.75rem; margin: 5px 0 0 0; word-wrap: break-word;">
                                    PEER-TO-PEER LVT LIQUIDITY MARKET
                                </p>
                            </div>
                            <div style="text-align: right; background: var(--input-bg); padding: 15px 25px; border: 1px solid var(--border-ui); border-radius: 4px; box-sizing: border-box; max-width: 100%;">
                                <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Your LVT Balance</div>
                                <div style="color: var(--integrity-green); font-family: 'Courier Prime', monospace; font-size: 1.5rem; font-weight: 900; word-break: break-all;">
                                    {{ "{:,.2f}".format((r.lvt_balance | default(0)) | float) }}
                                </div>
                            </div>
                        </div>

                        <!-- RESPONSIVE FLUID GRID FIX -->
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 30px; min-width: 0; max-width: 100%; box-sizing: border-box; width: 100%;">

                            <!-- List Tokens Card -->
                            <div style="background: var(--input-bg); border: 1px dashed var(--border-ui); padding: 25px; border-radius: 4px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
                                <h4 style="color: var(--text-main); margin-top: 0; font-family: 'Montserrat'; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1px; word-wrap: break-word;">
                                    📤 List Tokens for Fiat
                                </h4>
                                <p style="font-size: 0.7rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 20px; box-sizing: border-box; max-width: 100%;">
                                    Convert your earned Proof-of-Maintenance tokens into liquid Fiat. Tokens will be locked in escrow until purchased by another member.
                                </p>
                                <form action="#" method="POST" style="box-sizing: border-box; width: 100%; max-width: 100%;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <div style="margin-bottom: 15px; box-sizing: border-box; max-width: 100%;">
                                        <label for="sell_amount" style="display: block; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; font-family: 'Courier Prime'; font-weight: bold;">LVT to Sell</label>
                                        <input type="number" id="sell_amount" name="sell_amount" step="1" max="{{ (r.lvt_balance | default(0)) | float }}" required placeholder="e.g. 50" style="width: 100%; max-width: 100%; padding: 12px; background: var(--card-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime'; border-radius: 4px; box-sizing: border-box;">
                                    </div>
                                    <div style="margin-bottom: 20px; box-sizing: border-box; max-width: 100%;">
                                        <label for="asking_price" style="display: block; font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; font-family: 'Courier Prime'; font-weight: bold;">Asking Price (Total Pula)</label>
                                        <input type="number" id="asking_price" name="asking_price" step="10" required placeholder="e.g. 500" style="width: 100%; max-width: 100%; padding: 12px; background: var(--card-bg); border: 1px solid var(--integrity-gold); color: var(--integrity-gold); font-weight: bold; font-family: 'Courier Prime'; border-radius: 4px; box-sizing: border-box;">
                                    </div>
                                    <button type="submit" class="btn-touch" style="width: 100%; max-width: 100%; background: transparent; color: var(--integrity-gold); border: 1px solid var(--integrity-gold); padding: 15px; font-family: 'Montserrat'; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: 0.3s; border-radius: 2px; box-sizing: border-box;" onmouseover="this.style.background='var(--integrity-gold)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-gold)';">
                                        LOCK IN ESCROW
                                    </button>
                                </form>
                            </div>
<!-- Order Book Card -->
                            <div style="background: var(--input-bg); border: 1px dashed var(--border-ui); padding: 25px; border-radius: 4px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
                                <h4 style="color: var(--text-main); margin-top: 0; font-family: 'Montserrat'; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1px; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">📥 Live Order Book</h4>
                                <div style="max-height: 300px; overflow-y: auto; padding-right: 5px; box-sizing: border-box; width: 100%; max-width: 100%; overflow-x: hidden;">
                                    {% if market_orders and market_orders|length > 0 %}
                                        {% for order in market_orders %}
                                            {% if order.seller_id != r.id %}
                                            <div style="display: flex; justify-content: space-between; align-items: center; background: var(--card-bg); border: 1px solid var(--border-ui); border-left: 3px solid var(--sanctified-blue); padding: 15px; margin-bottom: 10px; border-radius: 2px; flex-wrap: wrap; gap: 10px; box-sizing: border-box; width: 100%; max-width: 100%;">
                                                <div style="box-sizing: border-box; max-width: 100%; overflow: hidden;">
                                                    <div style="font-family: 'Courier Prime'; font-size: 1.2rem; font-weight: 900; color: var(--text-main); box-sizing: border-box; word-break: break-all;">
                                                        {{ "{:,.0f}".format(order.lvt_amount) }} LVT
                                                    </div>
                                                    <div style="font-size: 0.65rem; color: var(--text-muted); font-family: 'Courier Prime'; margin-top: 3px; box-sizing: border-box; word-break: break-all;">
                                                        Seller: [{{ order.seller.vin_dna[-6:] }}]
                                                    </div>
                                                </div>
                                                <div style="text-align: right; display: flex; align-items: center; gap: 15px; flex-wrap: wrap; box-sizing: border-box; max-width: 100%;">
                                                    <div style="box-sizing: border-box;">
                                                        <div style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; box-sizing: border-box;">Total Cost</div>
                                                        <div style="color: var(--warning-orange); font-family: 'Courier Prime'; font-weight: bold; font-size: 1.1rem; box-sizing: border-box;">
                                                            P{{ "{:,.2f}".format(order.asking_price) }}
                                                        </div>
                                                    </div>
                                                    <form action="#" method="POST" style="margin: 0; box-sizing: border-box; max-width: 100%;">
                                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                        <button type="submit" onclick="return confirm('Make Transfer Swap P{{ order.asking_price }}?');" class="btn-touch" style="background: var(--sanctified-blue); color: white; border: none; padding: 10px 15px; font-family: 'Montserrat'; font-weight: 900; font-size: 0.8rem; letter-spacing: 1px; cursor: pointer; border-radius: 2px; transition: 0.3s; box-sizing: border-box; max-width: 100%; white-space: normal; word-wrap: break-word;" onmouseover="this.style.boxShadow='0 0 15px rgba(0, 51, 102, 0.6)';" onmouseout="this.style.boxShadow='none';">
                                                            EXECUTE
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        <div style="text-align: center; padding: 40px; border: 1px dashed var(--border-ui); background: var(--card-bg); color: var(--text-muted); font-family: 'Courier Prime'; font-size: 0.8rem; border-radius: 4px; box-sizing: border-box; width: 100%; max-width: 100%;">
                                            [ ORDER BOOK EMPTY. NO ACTIVE SELLERS. ]
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

<div style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(211, 47, 47, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 4px solid var(--critical-red); border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 20px; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; box-sizing: border-box; max-width: 100%;">
        <div style="box-sizing: border-box; max-width: 100%;">
            <h3 style="color: var(--critical-red); margin: 0; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; display: flex; align-items: center; gap: 10px; box-sizing: border-box; flex-wrap: wrap;">🔥 The Incinerator</h3>
            <p style="color: var(--text-muted); font-family: 'Courier Prime', monospace; font-size: 0.75rem; margin: 5px 0 0 0; box-sizing: border-box; word-wrap: break-word;">TOKEN UTILITY & DEFLATION ENGINE</p>
        </div>
        <div style="text-align: right; background: var(--input-bg); padding: 15px 25px; border: 1px solid var(--border-ui); border-radius: 2px; box-sizing: border-box; max-width: 100%;">
            <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-family: 'Montserrat', sans-serif; font-weight: bold;">Available Balance</div>
            <div style="color: var(--text-main); font-family: 'Courier Prime', monospace; font-size: 2rem; font-weight: 900; letter-spacing: -1px; box-sizing: border-box; word-break: break-all;">
                {{ "{:,.2f}".format(r.lvt_balance or 0) }} <span style="color: var(--integrity-gold); font-size: 1.2rem;">LVT</span>
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 20px; box-sizing: border-box; width: 100%; max-width: 100%;" class="financial-grid">
        <div style="background: var(--input-bg); border: 1px dashed var(--integrity-gold); padding: 25px; border-radius: 2px; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; width: 100%; max-width: 100%;">
            <div style="box-sizing: border-box; max-width: 100%;">
                <div style="font-family: 'Courier Prime', monospace; font-size: 1.1rem; font-weight: 900; color: var(--integrity-gold); margin-bottom: 10px; box-sizing: border-box; word-wrap: break-word;">Provenance Premium Boost</div>
                <p style="font-size: 0.75rem; color: #aaa; line-height: 1.6; margin-bottom: 20px; font-family: 'Inter', sans-serif; box-sizing: border-box;">Incinerate <strong>100 LVT</strong> to permanently increase the Laveto resale premium of this vehicle by <strong>+2%</strong>.</p>
                <div style="background: rgba(197, 160, 89, 0.1); border: 1px solid rgba(197, 160, 89, 0.3); padding: 10px; border-radius: 2px; margin-bottom: 20px; text-align: center; font-family: 'Courier Prime', monospace; font-size: 0.8rem; color: var(--integrity-gold); box-sizing: border-box; max-width: 100%;">
                    Current Active Boost: <strong style="font-size: 1.1rem;">+{{ "{:,.0f}".format(((r.lvt_premium_boost | default(0)) | float) * 100) }}%</strong>
                </div>
            </div>
            <form action="/hangar/burn_lvt/{{ r.id }}" method="POST" style="margin: 0; box-sizing: border-box; max-width: 100%;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <button type="submit" class="btn-touch" onclick="return confirm('WARNING: You are about to incinerate 100 LVT. This action is irreversible. Proceed?');" {% if ((r.lvt_balance | default(0)) | float) < 100 %} disabled style="background: #333; color: #666; cursor: not-allowed; width: 100%; max-width: 100%; padding: 15px; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; border-radius: 2px; box-sizing: border-box;" {% else %} style="background: transparent; color: var(--integrity-gold); border: 1px solid var(--integrity-gold); cursor: pointer; width: 100%; max-width: 100%; padding: 15px; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; transition: 0.3s; border-radius: 2px; box-sizing: border-box;" onmouseover="this.style.background='var(--integrity-gold)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-gold)';" {% endif %}>🔥 BURN 100 LVT</button>
            </form>
        </div>

        <div style="background: var(--input-bg); border: 1px dashed var(--sanctified-blue); padding: 25px; border-radius: 2px; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; width: 100%; max-width: 100%;">
            <div style="box-sizing: border-box; max-width: 100%;">
                <div style="font-family: 'Courier Prime', monospace; font-size: 1.1rem; font-weight: 900; color: var(--sanctified-blue); margin-bottom: 10px; box-sizing: border-box; word-wrap: break-word;">Forensic Audit Bypass</div>
                <p style="font-size: 0.75rem; color: #aaa; line-height: 1.6; margin-bottom: 20px; font-family: 'Inter', sans-serif; box-sizing: border-box;">Incinerate <strong>20 LVT</strong> to automatically bypass the standard mechanical audit fee, clearing the path for an immediate inspection.</p>
            </div>
            <form action="/hangar/burn_lvt/{{ r.id }}" method="POST" style="margin: 0; box-sizing: border-box; max-width: 100%;">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="intent" value="FORENSIC_AUDIT_BYPASS">
                <button type="submit" class="btn-touch" style="background: transparent; color: var(--sanctified-blue); border: 1px solid var(--sanctified-blue); cursor: pointer; width: 100%; max-width: 100%; padding: 15px; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; transition: 0.3s; border-radius: 2px; box-sizing: border-box;" onmouseover="this.style.background='var(--sanctified-blue)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--sanctified-blue)';">🔥 BURN 20 LVT</button>
            </form>
        </div>
    </div>
</div>

<div style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(102, 179, 255, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 4px solid #66b3ff; border-radius: 4px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
    <h3 style="color: #66b3ff; margin: 0 0 10px 0; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; display: flex; align-items: center; gap: 10px; box-sizing: border-box; flex-wrap: wrap; max-width: 100%;">🏦 Sovereign Payroll Matrix</h3>
    <p style="color: var(--text-muted); font-family: 'Inter', sans-serif; font-size: 0.9rem; margin-bottom: 25px; line-height: 1.6; box-sizing: border-box; max-width: 100%;">Automate your monthly Vault pulses directly from the Accountant General. Secures your Account Health and permanently eliminates default risk.</p>

    {% if r.stop_order %}
        <div style="background: var(--input-bg); border: 1px solid {% if r.stop_order.status == 'ACTIVE' %}var(--integrity-green){% else %}var(--warning-orange){% endif %}; padding: 25px; border-radius: 2px; box-sizing: border-box; width: 100%; max-width: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; box-sizing: border-box; max-width: 100%;">
                <div style="box-sizing: border-box; max-width: 100%;">
                    <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 5px;">Mandate Status</div>
                    <div style="color: {% if r.stop_order.status == 'ACTIVE' %}var(--integrity-green){% else %}var(--warning-orange){% endif %}; font-family: 'Montserrat'; font-weight: 900; font-size: 1.4rem; letter-spacing: 2px; text-transform: uppercase; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                        {% if r.stop_order.status == 'ACTIVE' %}
                            <span style="display: inline-block; width: 10px; height: 10px; background: var(--integrity-green); border-radius: 50%; box-shadow: 0 0 10px var(--integrity-green);"></span>
                        {% else %}
                            <span style="display: inline-block; width: 10px; height: 10px; background: var(--warning-orange); border-radius: 50%; box-shadow: 0 0 10px var(--warning-orange); animation: pulse-icon 2s infinite;"></span>
                        {% endif %}
                        {{ r.stop_order.status }}
                    </div>
                </div>
                <div style="text-align: right; box-sizing: border-box; max-width: 100%;">
                    <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 5px;">Monthly Pulse Allocation</div>
                    <div style="color: var(--text-main); font-family: 'Courier Prime'; font-weight: 900; font-size: 1.8rem; letter-spacing: -1px; word-break: break-all;">
                        P{{ "{:,.2f}".format(r.stop_order.monthly_deduction) }}
                    </div>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; font-family: 'Courier Prime'; font-size: 0.85rem; box-sizing: border-box; width: 100%; max-width: 100%;" class="credit-tier-grid">
                <div style="box-sizing: border-box; word-wrap: break-word;"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; margin-bottom: 3px;">EMPLOYER</span> <span style="color: var(--text-main); font-weight: bold;">{{ r.stop_order.employer_name }}</span></div>
                <div style="box-sizing: border-box; word-wrap: break-word;"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; margin-bottom: 3px;">MINISTRY / DEPT</span> <span style="color: var(--text-main); font-weight: bold;">{{ r.stop_order.department }}</span></div>
                <div style="box-sizing: border-box; word-wrap: break-word;"><span style="color: var(--text-muted); display: block; font-size: 0.65rem; margin-bottom: 3px;">EMPLOYEE NO.</span> <span style="color: var(--text-main); font-weight: bold;">{{ r.stop_order.employee_number }}</span></div>
            </div>
            {% if r.stop_order.status == 'PENDING SIGNATURE' %}
        <div style="margin-top: 25px; padding-top: 15px; border-top: 1px dashed var(--border-ui); text-align: center; color: var(--warning-orange); font-family: 'Inter'; font-size: 0.85rem; box-sizing: border-box; max-width: 100%;">
            ⚠️ Your electronic form is locked. Please sign the physical Stop Order file at Hangar 01 or with your assigned Agent to activate.
        </div>
        {% endif %}
    </div>
{% else %}
<form action="/hangar/forge-payroll-mandate" method="POST" style="box-sizing: border-box; width: 100%; max-width: 100%;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="vin_dna" value="{{ r.vin_dna }}">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 20px; box-sizing: border-box; width: 100%; max-width: 100%;" class="credit-tier-grid">
        <div style="box-sizing: border-box; max-width: 100%;">
            <label for="employer_input" style="font-family: 'Courier Prime'; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block; font-weight: bold; box-sizing: border-box;">Employer</label>
            <input type="text" id="employer_input" name="employer" value="GOVERNMENT OF BOTSWANA" readonly style="width: 100%; max-width: 100%; padding: 15px; background: #111; border: 1px solid var(--border-ui); color: var(--text-muted); font-family: 'Courier Prime'; font-weight: bold; border-radius: 2px; box-sizing: border-box; cursor: not-allowed; height: 46px;">
        </div>
        <div style="box-sizing: border-box; max-width: 100%;">
            <label for="department_input" style="font-family: 'Courier Prime'; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block; font-weight: bold; box-sizing: border-box;">Ministry / Department</label>
            <input type="text" id="department_input" name="department" placeholder="e.g. Ministry of Health" required style="width: 100%; max-width: 100%; padding: 15px; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime'; border-radius: 2px; box-sizing: border-box; transition: 0.3s; height: 46px;" onfocus="this.style.borderColor='#66b3ff'" onblur="this.style.borderColor='var(--border-ui)'">
        </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 20px; box-sizing: border-box; width: 100%; max-width: 100%;" class="credit-tier-grid">
        <div style="box-sizing: border-box; max-width: 100%;">
            <label for="omang_input" style="font-family: 'Courier Prime'; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block; font-weight: bold; box-sizing: border-box;">Omang Number</label>
            <input type="text" id="omang_input" name="omang_number" placeholder="Valid ID Required" required style="width: 100%; max-width: 100%; padding: 15px; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime'; border-radius: 2px; box-sizing: border-box; transition: 0.3s; height: 46px;" onfocus="this.style.borderColor='#66b3ff'" onblur="this.style.borderColor='var(--border-ui)'">
        </div>
        <div style="box-sizing: border-box; max-width: 100%;">
            <label for="employee_number_input" style="font-family: 'Courier Prime'; font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block; font-weight: bold; box-sizing: border-box;">Employee / Payroll Number</label>
            <input type="text" id="employee_number_input" name="employee_number" placeholder="Required for AG" required style="width: 100%; max-width: 100%; padding: 15px; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime'; border-radius: 2px; box-sizing: border-box; transition: 0.3s; height: 46px;" onfocus="this.style.borderColor='#66b3ff'" onblur="this.style.borderColor='var(--border-ui)'">
        </div>
    </div>
    <div style="background: rgba(102, 179, 255, 0.05); border: 1px dashed #66b3ff; padding: 25px; border-radius: 2px; margin-bottom: 25px; text-align: center; box-sizing: border-box; width: 100%; max-width: 100%;">
        <label for="monthly_pledge_input" style="font-family: 'Montserrat'; font-size: 0.85rem; color: #66b3ff; text-transform: uppercase; margin-bottom: 10px; display: block; font-weight: 900; letter-spacing: 1px; box-sizing: border-box;">Monthly Capital Allocation (Pula)</label>
        <input type="number" id="monthly_pledge_input" name="monthly_pledge" step="10" min="450" value="1000" required style="width: 100%; max-width: 300px; padding: 15px; background: var(--input-bg); border: 1px solid #66b3ff; color: #66b3ff; font-family: 'Courier Prime'; font-weight: 900; font-size: 1.8rem; text-align: center; border-radius: 2px; box-sizing: border-box; outline: none; box-shadow: 0 0 15px rgba(102, 179, 255, 0.2); height: 55px;">
        <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 10px; font-family: 'Courier Prime'; font-weight: bold; box-sizing: border-box;">System Minimum: P450.00 / Month</div>
    </div>

    <div style="background: rgba(197, 160, 89, 0.05); border: 1px dashed var(--integrity-gold); padding: 20px; border-radius: 2px; margin-bottom: 25px; text-align: center; position: relative; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <label style="font-family: 'Montserrat'; font-size: 0.8rem; color: var(--integrity-gold); text-transform: uppercase; margin-bottom: 15px; display: block; font-weight: 900; letter-spacing: 1px; box-sizing: border-box; word-wrap: break-word;">
            Pilot Authorization Signature
        </label>

        <div style="position: relative; display: inline-block; width: 100%; max-width: 400px; box-sizing: border-box; overflow: hidden;">
            <canvas id="covenantSignaturePad" width="400" height="150" style="background: var(--input-bg); border: 1px solid var(--border-ui); border-radius: 2px; width: 100%; max-width: 100%; cursor: crosshair; touch-action: none; box-shadow: inset 0 0 15px rgba(0,0,0,0.8); box-sizing: border-box;"></canvas>

            <div style="position: absolute; bottom: 25px; left: 10%; right: 10%; height: 1px; background: rgba(255,255,255,0.1); pointer-events: none; box-sizing: border-box;"></div>
            <div style="position: absolute; bottom: 10px; right: 15px; font-family: 'Courier Prime'; font-size: 0.6rem; color: var(--text-muted); pointer-events: none; box-sizing: border-box;">SIGN ABOVE X</div>
        </div>

        <div style="display: flex; justify-content: center; margin-top: 10px; box-sizing: border-box; width: 100%;">
            <button type="button" onclick="clearSovereignSignature()" class="btn-touch" style="background: transparent; color: var(--text-muted); border: 1px solid var(--border-ui); padding: 5px 15px; font-family: 'Montserrat'; font-size: 0.65rem; font-weight: bold; text-transform: uppercase; border-radius: 2px; transition: 0.2s; box-sizing: border-box;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--text-muted)'">
                🧹 CLEAR CANVAS
            </button>
        </div>

        <input type="hidden" name="digital_signature_base64" id="digital_signature_base64" required>
    </div>

    <button type="button" onclick="executeMandateForge()" class="btn-touch" style="width: 100%; max-width: 100%; background: #66b3ff; color: #000; font-family: 'Montserrat'; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; border: none; border-radius: 2px; transition: 0.3s; box-shadow: 0 5px 15px rgba(102, 179, 255, 0.3); padding: 18px; box-sizing: border-box; word-wrap: break-word;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
        📝 AUTHORIZE SALARY DEDUCTION
    </button>
</form>
{% endif %}
</div>
<!-- START COCKPIT RIGHT -->
<div class="cockpit-right" style="box-sizing: border-box; width: 100%; max-width: 100%;">
    <div style="background: linear-gradient(135deg, #1a1a1a 0%, #000 100%); border: 1px solid var(--integrity-gold); padding: 25px; border-radius: 4px; border-bottom: 4px solid var(--integrity-gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <h3 style="color: var(--integrity-gold); margin: 0 0 10px 0; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; font-size: 0.9rem; display: flex; align-items: center; gap: 10px; box-sizing: border-box; word-wrap: break-word;">
            📘 The Sovereign Codex
        </h3>
        <p style="color: var(--text-muted); font-family: 'Courier Prime'; font-size: 0.75rem; margin-bottom: 20px; line-height: 1.4; box-sizing: border-box; max-width: 100%;">
            Access Document 263: The tokenomic protocol and architectural blueprint for vehicle equity monetization.
        </p>
        <button onclick="document.getElementById('whitePaperModal').style.display='flex'" class="btn-touch" style="width: 100%; max-width: 100%; background: transparent; color: var(--integrity-gold); border: 1px solid var(--integrity-gold); font-family: 'Montserrat'; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; font-size: 0.75rem; cursor: pointer; transition: 0.3s; box-sizing: border-box; word-wrap: break-word;">
            📖 UNSEAL WHITE PAPER
        </button>
    </div>

    <div style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(197, 160, 89, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 4px solid var(--integrity-gold); padding: 30px; border-radius: 2px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
        <h3 style="color: var(--integrity-gold); font-family: 'Montserrat'; margin: 0 0 10px 0; font-size: 1.1rem; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; box-sizing: border-box; word-wrap: break-word;">
            🤝 The Member Invites
        </h3>
        <p style="font-size: 0.85rem; color: var(--text-muted); font-family: 'Inter'; margin-bottom: 20px; line-height: 1.5; box-sizing: border-box; max-width: 100%;">
            The Sovereign 500 is an invite-only ecosystem. As a Genesis Founder, you possess the authority to induct new peers. Earn a <strong>P250 Sanctification Grant</strong> directly to your Shield Reservoir for every successful induction.
        </p>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; box-sizing: border-box; width: 100%; max-width: 100%;">
            <label for="invite_link" class="visually-hidden">Referral Link</label>
            <input type="text" id="invite_link" readonly value="https://laveto.net/apply?ref={{ r.vin_dna[-6:] }}" style="flex: 2; min-width: 180px; max-width: 100%; padding: 12px; background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-ui); font-family: 'Courier Prime'; font-weight: bold; border-radius: 2px; font-size: 0.8rem; height: 46px; box-sizing: border-box; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <button type="button" class="btn-touch" onclick="copyTextFallback('https://laveto.net/apply?ref={{ r.vin_dna[-6:] }}')" style="flex: 1; min-width: 100px; max-width: 100%; background: var(--sanctified-blue); color: white; border: none; padding: 12px; font-family: 'Montserrat'; font-weight: 900; text-transform: uppercase; cursor: pointer; border-radius: 2px; font-size: 0.7rem; height: 46px; transition: 0.3s; box-sizing: border-box;" onmouseover="this.style.filter='brightness(1.2)'" onmouseout="this.style.filter='brightness(1)'">
                COPY LINK
            </button>
        </div>
    </div>
{% if r.ghost_orders %}
                    <div style="background: linear-gradient(145deg, var(--input-bg) 0%, rgba(197, 160, 89, 0.03) 100%); border: 1px solid var(--border-ui); padding: 30px; border-radius: 2px; border-top: 5px solid var(--integrity-gold); box-shadow: 0 15px 30px rgba(0,0,0,0.6); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
                        <h3 style="font-family: 'Montserrat', sans-serif; color: var(--integrity-gold); font-size: 1.1rem; text-transform: uppercase; margin: 0 0 25px 0; letter-spacing: 3px; font-weight: 900; box-sizing: border-box; word-wrap: break-word;">
                            🛰️ Procurement Radar
                            <span class="rosetta-sub">(Live Parts Order Tracking)</span>
                        </h3>
                        {% for part in r.ghost_orders %}
                        <div style="margin-bottom: 30px; border-bottom: 1px solid var(--border-ui); padding-bottom: 20px; box-sizing: border-box; max-width: 100%;">
                            <div style="display: flex; justify-content: space-between; font-size: 1.05rem; font-family: 'Courier Prime', monospace; margin-bottom: 15px; font-weight: bold; flex-wrap: wrap; gap: 5px; box-sizing: border-box; max-width: 100%;">
                                <span style="color: var(--text-main); box-sizing: border-box; word-wrap: break-word;">{{ part.component_name }}</span>
                                <span style="color: var(--integrity-gold); text-transform: uppercase; letter-spacing: 1px; box-sizing: border-box;">
                                    {{ part.status }}
                                    {% if part.estimated_arrival %}
                                        // ETA: {{ part.estimated_arrival.strftime('%d %b') }}
                                    {% endif %}
                                </span>
                            </div>
                            <div style="width: 100%; max-width: 100%; height: 10px; background: var(--card-bg); border-radius: 5px; overflow: hidden; border: 1px solid var(--border-ui); box-sizing: border-box;">
                                <div style="width: {% if (part.status or '')|upper == 'AWAITING PAYMENT' %}20%{% elif (part.status or '')|upper == 'FUNDS CLEARED' %}45%{% elif (part.status or '')|upper == 'IN TRANSIT' %}70%{% elif (part.status or '')|upper == 'DELIVERED TO BAY' %}90%{% elif (part.status or '')|upper == 'APPROVED' %}100%{% else %}5%{% endif %}; background: linear-gradient(90deg, #8a6d3b, var(--integrity-gold)); height: 100%; transition: 1.5s ease-in-out; box-shadow: 0 0 10px rgba(197, 160, 89, 0.5); box-sizing: border-box;"></div>
                            </div>
                            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 15px; font-family: 'Courier Prime', monospace; box-sizing: border-box; max-width: 100%;">
                                {% if part.status == 'PENDING ORDER' %}📡 Preparing payload manifest.{% elif part.status == 'AWAITING PAYMENT' %}⏳ Awaiting pilot authorization & funds.{% elif part.status == 'FUNDS CLEARED' %}💳 Payment confirmed. Uplink to supplier active.{% elif part.status == 'IN TRANSIT' %}🚚 Payload in transit to target coordinates.{% elif part.status == 'DELIVERED TO BAY' %}🛠️ Payload secured at workshop. Ready for install.{% elif part.status == 'APPROVED' %}✅ Installation complete. Node functioning optimally.{% else %}📡 Syncing system...{% endif %}
                            </p>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    <div class="flicker-engine" style="background: linear-gradient(145deg, var(--input-bg) 0%, rgba(255, 170, 0, 0.03) 100%); box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
    <h3 style="color: var(--warning-orange); font-family: 'Montserrat', sans-serif; font-size: 1.3rem; margin-top: 0; margin-bottom: 25px; text-transform: uppercase; letter-spacing: 3px; font-weight: 900; box-sizing: border-box; word-wrap: break-word;">⚡ Emergency Levels</h3>
    <p style="color: var(--text-main); font-family: 'Inter', sans-serif; font-size: 0.95rem; margin-bottom: 20px; box-sizing: border-box; max-width: 100%;">
        Select the severity of your mechanical symptom to initiate the 24-Hour Sovereign Response Protocol.
    </p>
    <form id="flickerForm" action="#" method="POST" style="margin-top: 20px; width: 100%; max-width: 100%; box-sizing: border-box;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="flicker_level" class="visually-hidden">Select Triage Level</label>
        <select id="flicker_level" name="flicker_level" class="booking-control" required style="width: 100%; max-width: 100%; margin-bottom: 15px; border-color: var(--warning-orange); color: var(--warning-orange); background-color: var(--input-bg); box-sizing: border-box; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
            <option value="" style="background: #111; color: #fff;">-- SELECT TRIAGE LEVEL --</option>
            <option value="LEVEL_I" style="background: #111; color: #fff;">Level I (The Settlement): "I hear a faint squeak/rubbing during turns."</option>
            <option value="LEVEL_II" style="background: #111; color: #fff;">Level II (The Shift): "My steering wheel feels slightly off-center."</option>
            <option value="LEVEL_III" style="background: #111; color: #fff;">Level III (The Ghost): "I hear a clunk resembling the original noise."</option>
        </select>
        <button type="submit" class="btn-touch" style="background: transparent; color: var(--warning-orange); border: 2px solid var(--warning-orange); font-family: 'Montserrat'; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; border-radius: 2px; width: 100%; max-width: 100%; box-sizing: border-box; transition: 0.3s; word-wrap: break-word;" onmouseover="this.style.background='var(--warning-orange)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--warning-orange)';">
            REPORT FLICKER (24H SLA)
        </button>
    </form>
</div>
                    <div id="booking_section" style="background: linear-gradient(145deg, var(--card-bg) 0%, rgba(0, 85, 255, 0.03) 100%); border: 1px solid var(--border-ui); border-top: 5px solid var(--sanctified-blue); border-radius: 2px; padding: 30px; box-shadow: 0 15px 30px rgba(0,0,0,0.5); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
                        <h3 style="margin: 0 0 15px 0; font-family: 'Montserrat'; color: var(--text-main); font-weight: 900; text-transform: uppercase; letter-spacing: 2px; font-size: 1.2rem; box-sizing: border-box; word-wrap: break-word;">📅 Workshop Uplink</h3>
                        <p style="margin:0 0 30px 0; font-size: 0.95rem; color: var(--text-muted); font-family: 'Inter'; line-height: 1.6; box-sizing: border-box; max-width: 100%;">
                            Schedule a bay for routine service, diagnostics, or major repair. Requires 24h advance lock.
                        </p>
                        <form action="#" method="POST" style="display: flex; flex-direction: column; gap: 20px; box-sizing: border-box; width: 100%; max-width: 100%;">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="vin" value="{{ r.vin_dna }}">
                            <div class="booking-input-group" style="box-sizing: border-box; max-width: 100%;">
                                <label for="airlock_date" style="font-family: 'Montserrat', sans-serif; font-size: 0.9rem; color: var(--integrity-gold); text-transform: uppercase; font-weight: 900; display: block; margin-bottom: 12px; letter-spacing: 1px; box-sizing: border-box; word-wrap: break-word;">📅 1. Target Date</label>
                                <input type="date" id="airlock_date" name="booking_date" class="booking-control" required style="color: var(--integrity-gold); text-align: center; display: block; width: 100%; max-width: 100%; box-sizing: border-box;" onclick="if(this.showPicker) this.showPicker();" onfocus="if(this.showPicker) this.showPicker();">
                            </div>
                            <div class="booking-input-group" style="box-sizing: border-box; max-width: 100%;">
                                <label for="booking_time" style="font-family: 'Montserrat', sans-serif; font-size: 0.9rem; color: var(--integrity-gold); text-transform: uppercase; font-weight: 900; display: block; margin-bottom: 12px; letter-spacing: 1px; box-sizing: border-box; word-wrap: break-word;">⏰ 2. Time Window</label>
                                <select id="booking_time" name="booking_time" class="booking-control" required style="text-align: center; display: block; width: 100%; max-width: 100%; box-sizing: border-box; text-overflow: ellipsis;">
                                    <option value="">-- CHOOSE BLOCK --</option>
                                    <option value="MORNING">🌅 Morning (07:30 - 10:00)</option>
                                    <option value="AFTERNOON">🌇 Afternoon (14:00 - 16:30)</option>
                                </select>
                            </div>
                            <div class="booking-input-group" style="box-sizing: border-box; max-width: 100%;">
                                <label for="booking_reason" style="font-family: 'Montserrat', sans-serif; font-size: 0.9rem; color: var(--integrity-gold); text-transform: uppercase; font-weight: 900; display: block; margin-bottom: 12px; letter-spacing: 1px; box-sizing: border-box; word-wrap: break-word;">🔧 3. Mission Directive</label>
                                <select id="booking_reason" name="booking_reason" class="booking-control" required style="text-align: center; display: block; width: 100%; max-width: 100%; box-sizing: border-box; text-overflow: ellipsis;">
                                    <option value="">-- SELECT PURPOSE --</option>
                                    <option value="ROUTINE">🛢️ Scheduled Service</option>
                                    <option value="EMERGENCY">🚨 Diagnostic / Warning Light</option>
                                    <option value="RESTORATION">🔧 Major Mechanical Repair</option>
                                    <option value="INSPECTION">🔬 System Audit / Inspection</option>
                                </select>
                            </div>
                            {% if not r.is_locked %}
                            <button type="submit" class="btn-touch" style="background: var(--sanctified-blue); color: white; border: 2px solid var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 3px; font-size: 1.1rem; cursor: pointer; border-radius: 2px; transition: 0.3s; box-shadow: 0 10px 20px rgba(0,51,102,0.5); margin-top: 15px; width: 100%; max-width: 100%; box-sizing: border-box; word-wrap: break-word;" onmouseover="this.style.background='#004080'" onmouseout="this.style.background='var(--sanctified-blue)'">
                                🔒 LOCK COORDINATES
                            </button>
                            {% else %}
                            <div style="text-align: center; padding: 15px; color: var(--critical-red); border: 1px dashed var(--critical-red); font-family: 'Courier Prime'; font-weight: bold; box-sizing: border-box; max-width: 100%;">
                                ACCOUNT LOCKED: Awaiting Payment Authorization
                            </div>
                            {% endif %}
                        </form>
                    </div>

                    <button class="accordion-btn btn-touch" style="margin-top: 40px; box-sizing: border-box; width: 100%; max-width: 100%; word-wrap: break-word;">🔬 OPEN DETAILED INSPECTION TELEMETRY</button>
                    <div class="accordion-content" style="box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
                        <div style="padding-top: 35px; box-sizing: border-box; max-width: 100%;">
                            <h3 class="section-title" style="box-sizing: border-box; max-width: 100%; word-wrap: break-word;">⚖️ Component Health Forecast</h3>
                            <div style="display: flex; gap: 20px; margin-bottom: 30px; font-size: 0.9rem; color: var(--text-muted); font-family: 'Courier Prime'; justify-content: center; font-weight: bold; flex-wrap: wrap; box-sizing: border-box; max-width: 100%;">
                                <span>🟢 5/5: OPTIMAL</span><span>🔵 4/5: NOMINAL</span><span>🟡 3/5: WEARING</span><span>🔴 1/5: CRITICAL</span>
                            </div>
                            <div class="scorecard-grid" style="box-sizing: border-box; width: 100%; max-width: 100%;">
                                {% for name, data in components.items() %}
                                <div class="score-item" onclick="unsealComponentInfo('{{ name }}')" style="border-left-width: 8px; border-left-color: {% if data.grade >= 5 %}var(--integrity-green){% elif data.grade == 4 %}#66b3ff{% elif data.grade == 3 %}var(--integrity-gold){% else %}var(--critical-red){% endif %}; border-radius: 4px; margin-bottom: 5px; box-sizing: border-box; width: 100%; max-width: 100%; overflow: hidden;">
                                    <div class="score-header" style="box-sizing: border-box; max-width: 100%;">
                                        <span class="comp-name" style="box-sizing: border-box; word-break: break-word;">{{ name }}</span>
                                        <span class="grade-pill" style="background: {% if data.grade >= 5 %}rgba(40,167,69,0.1); color: var(--integrity-green); border: 1px solid var(--integrity-green);{% elif data.grade == 4 %}rgba(102,179,255,0.1); color: #66b3ff; border: 1px solid #66b3ff;{% elif data.grade == 3 %}rgba(197,160,89,0.1); color: var(--integrity-gold); border: 1px solid var(--integrity-gold);{% else %}rgba(211,47,47,0.1); color: var(--critical-red); border: 1px solid var(--critical-red);{% endif %}; box-sizing: border-box;">
                                            GRADE {{ data.grade }}
                                        </span>
                                    </div>
                                    {% if data.is_engraved %}
                                        <span class="badge-warranty" style="box-sizing: border-box;">LIFETIME WARRANTY ACTIVE</span>
                                    {% endif %}
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
<h3 class="section-title" style="margin-top: 40px; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">📸 Forensic Archives</h3>
                    <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: -15px; margin-bottom: 25px; text-transform: uppercase; letter-spacing: 2px; font-family: 'Courier Prime'; font-weight: bold; box-sizing: border-box; max-width: 100%; word-wrap: break-word;">
                        Immutable Data Vault // High-Resolution Assets
                    </p>
                    <div class="proof-grid" style="box-sizing: border-box; width: 100%; max-width: 100%;">
                        {% set cats = ['Vehicle Profile', 'Identity', 'The Fault', 'The Swap', 'The Install', 'The Seating'] %}
                        {% for cat in cats %}
                        {% set raw_path = proofs.get(cat) %}
                        <div class="proof-card" {% if raw_path %}onclick="window.open('{{ raw_path }}', '_blank')"{% endif %} style="box-sizing: border-box; max-width: 100%; overflow: hidden;">
                            {% if raw_path %}
                                {% set clean_path = raw_path|replace('\\', '/') %}
                                {% set final_path = clean_path.split('static/')[-1] if 'static/' in clean_path else clean_path %}
                                {% set file_id = '' %}
                                {% if 'drive.google.com' in final_path %}
                                    {% if '/d/' in final_path %}
                                        {% set file_id = final_path.split('/d/')[1].split('/')[0] %}
                                    {% elif 'id=' in final_path %}
                                        {% set file_id = final_path.split('id=')[1].split('&')[0] %}
                                    {% endif %}
                                {% endif %}
                                {% if file_id %}
                                    {% set img_src = 'https://drive.google.com/thumbnail?id=' ~ file_id ~ '&sz=w1000' %}
                                {% elif not final_path.startswith('http') %}
                                    {% set img_src = url_for('static', filename=final_path.lstrip('/')) %}
                                {% else %}
                                    {% set img_src = final_path %}
                                {% endif %}
                                <img src="{{ img_src }}" class="proof-img" loading="lazy" onerror="this.onerror=null; this.parentElement.removeAttribute('onclick'); this.parentElement.style.cursor='not-allowed'; this.outerHTML='<div style=\'height: 220px; display: flex; align-items: center; justify-content: center; color: #ff4444; font-size: 0.95rem; border: 1px dashed #ff4444; background: rgba(211,47,47,0.05); font-family: Courier Prime; font-weight: bold; box-sizing: border-box; width: 100%; max-width: 100%; text-align: center; padding: 10px;\'>FILE CORRUPT</div>';" style="box-sizing: border-box; max-width: 100%;">
                            {% else %}
                                <div style="height: 220px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.85rem; font-family: 'Courier Prime'; font-weight: bold; background: var(--input-bg); cursor: not-allowed; border-bottom: 1px solid var(--border-ui); box-sizing: border-box; width: 100%; max-width: 100%; text-align: center; padding: 10px;">NO DATA</div>
                            {% endif %}
                            <div class="proof-label" {% if not raw_path %}style="color: var(--text-muted); box-sizing: border-box; width: 100%; word-wrap: break-word;"{% else %}style="box-sizing: border-box; width: 100%; word-wrap: break-word;"{% endif %}>{{ cat }}</div>
                        </div>
                        {% endfor %}
                    </div>

                    <div style="max-height: 280px; overflow-y: auto; overflow-x: auto; padding-right: 10px; border: 1px solid var(--border-ui); background: var(--input-bg); border-radius: 2px; border-left: 4px solid var(--integrity-gold); margin-bottom: 30px; box-sizing: border-box; width: 100%; max-width: 100%;">
                        {% if audit_logs %}
                            {% for tx in audit_logs %}
                            <div class="ledger-row" style="border-bottom: 1px solid var(--border-ui); padding: 15px 20px; align-items: center; box-sizing: border-box; width: 100%;">
                                <div style="color: var(--integrity-gold); font-family: 'Courier Prime'; font-size: 0.75rem; box-sizing: border-box; word-wrap: break-word;">
                                    {{ tx.timestamp.strftime('%d-%b %H:%M') }}
                                </div>
                                <div style="color: var(--text-muted); font-size: 0.85rem; font-family: 'Inter'; box-sizing: border-box; word-wrap: break-word;">
                                    {{ tx.action or tx.intent }}
                                </div>
                                <div style="text-align: right; box-sizing: border-box;">
                                    <span style="color: {% if (tx.lvt_utility or 0) > 0 %}var(--integrity-green){% else %}var(--text-muted){% endif %}; font-family: 'Courier Prime'; font-weight: 900; font-size: 0.9rem; box-sizing: border-box; word-break: break-all;">
                                        {{ "{:,.2f}".format(tx.lvt_utility or 0) }} LVT
                                    </span>
                                </div>
                            </div>
                            {% endfor %}
                        {% else %}
                            <div style="margin-top: 20px; box-sizing: border-box; width: 100%; max-width: 100%;">
                                <form action="/hangar/request_liquidation/{{ r.id }}" method="POST" style="box-sizing: border-box; width: 100%;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <button type="submit" class="btn-touch" style="background: transparent; color: var(--critical-red); border: 1px dashed var(--critical-red); width: 100%; max-width: 100%; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; border-radius: 2px; transition: 0.3s; box-sizing: border-box; word-wrap: break-word; padding: 15px;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='var(--critical-red)';">
                                        INITIATE MARKET SALE (SEND TO COMMAND WALL)
                                    </button>
                                </form>
                            </div>
                            <div style="padding: 30px; text-align: center; color: var(--text-muted); font-family: 'Courier Prime'; font-size: 0.9rem; font-weight: bold; box-sizing: border-box; width: 100%; max-width: 100%; word-wrap: break-word;">
                                [ LOG EMPTY. AWAITING INITIAL FUNDING. ]
                            </div>
                        {% endif %}
                    </div>
                    <!-- SOVEREIGN SUPPLY INJECTED MODULE -->
                    <div id="supplyModule" style="background: var(--card-bg); border: 1px solid var(--border-ui); border-top: 4px solid var(--warning-orange); padding: 30px; border-radius: 4px; margin-bottom: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); transition: opacity 0.5s;">
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;">
                            <div>
                                <h3 style="color: var(--warning-orange); margin: 0; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; display: flex; align-items: center; gap: 10px;">
                                    📦 Sovereign Supply
                                </h3>
                                <p style="color: var(--text-muted); font-family: 'Courier Prime', monospace; font-size: 0.75rem; margin: 5px 0 0 0;">
                                    MERCHANDISE INVENTORY & LOGISTICS NODE
                                </p>
                            </div>
                            <div style="text-align: right; display: flex; gap: 10px; align-items: center;">
                                <span id="statusBadge" style="font-size: 0.65rem; background: rgba(255, 170, 0, 0.1); color: var(--warning-orange); padding: 6px 12px; border: 1px solid var(--warning-orange); border-radius: 2px; font-family: 'Courier Prime', monospace; font-weight: bold; letter-spacing: 1px;">STATUS: STANDBY</span>
                                <button onclick="ejectModule()" class="btn-touch" style="background: transparent; border: 1px dashed var(--critical-red); color: var(--critical-red); padding: 6px 12px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 2px; transition: 0.3s;" onmouseover="this.style.background='rgba(211,47,47,0.1)';" onmouseout="this.style.background='transparent';">EJECT</button>
                            </div>
                        </div>

                        <div id="contentArea" style="border: 1px dashed var(--border-ui); background: var(--input-bg); padding: 30px; text-align: center; border-radius: 2px;">
                            <p style="color: var(--text-muted); font-size: 0.85rem; font-family: 'Courier Prime', monospace; font-weight: bold; letter-spacing: 1px; margin: 0;">
                                [ SUPPLY CHAIN NODES SYNCHRONIZING... AWAITING UPLINK ]
                            </p>
                        </div>

                        <div id="actionRow" style="margin-top: 20px; display: flex; gap: 15px;">
                            <button class="btn-touch" style="flex: 1; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); padding: 12px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; border-radius: 2px; transition: 0.3s;" onmouseover="this.style.borderColor='var(--integrity-gold)'; this.style.color='var(--integrity-gold)';" onmouseout="this.style.borderColor='var(--border-ui)'; this.style.color='var(--text-main)';">FORCE SYNC</button>
                            <button class="btn-touch" style="flex: 1; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); padding: 12px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; border-radius: 2px; transition: 0.3s;" onmouseover="this.style.borderColor='var(--integrity-gold)'; this.style.color='var(--integrity-gold)';" onmouseout="this.style.borderColor='var(--border-ui)'; this.style.color='var(--text-main)';">DIAGNOSTICS</button>
                        </div>
                    </div>
                    <div class="audit-ledger" style="background: var(--card-bg); border: 1px solid var(--border-ui); border-radius: 2px; padding: 30px; margin-top: 40px; border-top: 4px solid var(--integrity-gold);">
                        <h3 style="margin: 0 0 10px 0; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; font-size: 1.1rem; color: var(--integrity-gold);">
                            📜 Verified Ledger History
                        </h3>
                        <p style="color: var(--text-muted); font-family: 'Courier Prime'; font-size: 0.75rem; margin-bottom: 20px; line-height: 1.4; text-transform: uppercase;">
                            FORENSIC DEPOSIT TRACE LOGS // SYNCHRONIZED ARCHIVE
                        </p>


                        {% if audit_logs %}
                            <div style="max-height: 350px; overflow-y: auto; border: 1px solid var(--border-ui); background: #000; border-radius: 2px;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; font-family: 'Courier Prime', monospace;">
                                    <thead style="position: sticky; top: 0; background: var(--card-bg); z-index: 10; border-bottom: 2px solid var(--integrity-gold);">
                                        <tr>
                                            <th style="padding: 15px; text-align: left; color: var(--integrity-gold); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">Timestamp</th>
                                            <th style="padding: 15px; text-align: left; color: var(--integrity-gold); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">Allocation Directive</th>
                                            <th style="padding: 15px; text-align: right; color: var(--integrity-gold); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for tx in audit_logs %}
                                        <tr style="border-bottom: 1px solid #1a1a1a; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                                            <td style="padding: 15px; color: var(--text-muted); font-size: 0.8rem; white-space: nowrap;">
                                                {{ tx.timestamp.strftime('%d %b %Y %H:%M') if tx.timestamp else 'N/A' }}
                                            </td>
                                            <td style="padding: 15px; color: #fff;">
                                                <div style="font-weight: bold; margin-bottom: 4px; color: var(--text-main);">
                                                    {{ tx.intent or tx.action or 'Routine System Audit' }}
                                                </div>
                                                <div style="font-size: 0.7rem; color: var(--text-muted); font-family: 'Inter', sans-serif;">
                                                    Auth: {{ tx.authorized_by | default('SYSTEM') }} | Status: <span style="color: var(--integrity-green);">{{ tx.status | default('CLEARED') }}</span>
                                                </div>
                                            </td>
                                            <td style="padding: 15px; text-align: right; font-weight: 900; font-size: 1rem; color: {% if tx.amount and tx.amount < 0 %}var(--critical-red){% else %}var(--integrity-green){% endif %}; white-space: nowrap;">
                                                {% if tx.amount and tx.amount < 0 %}-{% else %}+{% endif %}P{{ "{:,.2f}".format(tx.amount | default(0.0) | abs) }}
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div style="text-align: center; padding: 40px; border: 1px dashed var(--border-ui); background: #000; color: var(--text-muted); font-family: 'Courier Prime'; font-size: 0.85rem;">
                                [ LEDGER EMPTY. AWAITING INITIAL ACCRUED FUNDING DIRECTIVE. ]
                            </div>
                        {% endif %}
                    </div>
                    <a href="/logout" class="btn-logout btn-touch">🔒 SECURE DISCONNECT</a>
                </div>
                <!-- END COCKPIT RIGHT -->
            </div>
        </div>
    </main>

<div id="videoModal" class="modal-overlay" onclick="closeVideoModal()">
    <div class="law-modal modal-content-wide" onclick="event.stopPropagation()" style="background: #000; border: 2px solid var(--integrity-gold); padding: 0; overflow: hidden; position: relative; max-width: 900px; width: 95%;">
        <span class="close-modal" onclick="closeVideoModal()" style="position: absolute; top: 10px; right: 20px; z-index: 100; color: #fff; font-size: 2rem; cursor: pointer;">×</span>
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;">
            <iframe id="vaultGuideFrame" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
        <div style="padding: 15px; background: #111; text-align: center;">
            <h3 style="font-family: 'Montserrat'; color: var(--integrity-gold); margin: 0; font-size: 0.9rem; letter-spacing: 2px;">TECHNICAL BRIEFING // SOVEREIGN OS OPERATIONS</h3>
        </div>
    </div>
</div>

<div id="covenantModal" class="covenant-modal-overlay">
    <div class="covenant-modal-box">
        <h2 class="covenant-title">📜 The Laveto Covenant</h2>
        <div class="covenant-text">
            <p>Your Account Health is strictly governed by your <strong>continuous, on-time monthly deposits</strong>. Maintaining a positive streak unlocks your vehicle's asset equity.</p>
            <p><strong>The Maturity Gates:</strong></p>
            <div class="covenant-tier">
                <strong style="color: white;">Standard Tier (0 - 11 Months)</strong><br>
                Account is building trust. Eligible for triage and minor workshop restorations.
            </div>
            <div class="covenant-tier">
                <strong style="color: white;">Advanced Tier (12 - 23 Months)</strong><br>
                Mid-level maturity. Unlocks access to major mechanical restorations and higher capital limits.
            </div>
            <div class="covenant-tier" style="border-color: #00d2ff;">
                <strong style="color: #00d2ff;">💎 Diamond Tier (24+ Months)</strong><br>
                Sovereign Status. Completely unlocks the Vault, granting the ability to draw External Capital loans against your asset.
            </div>
            <p style="color: var(--critical-red); margin-top: 15px; font-size: 0.8rem;">
                ⚠️ <strong>CRITICAL:</strong> Missing a scheduled deposit will fracture your Account Health, resetting your consecutive green months and pausing your progression through the Maturity Gates.
            </p>
        </div>
        <button class="btn-understand btn-touch" onclick="closeCovenantModal()">I UNDERSTAND</button>
    </div>
</div>

<div id="educator-gate-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(5px);">
    <div style="background: #111; border: 1px solid var(--integrity-gold); padding: 30px; width: 90%; max-width: 500px; border-radius: 4px; box-shadow: 0 0 20px rgba(197, 160, 89, 0.2);">
        <h2 style="color: var(--integrity-gold); font-family: 'Montserrat'; font-size: 1.2rem; text-transform: uppercase; margin-top: 0;">🔒 Early Withdrawal Request</h2>
        <p style="color: #ccc; font-size: 0.9rem; line-height: 1.6; font-family: 'Arial', sans-serif;">
            Remember the Laveto Covenant: We lock the 60% pool so we can lend it out internally. This lending generates the interest that grows your money. If we unlock the vault early, the lending stops, and your money earns zero profit.
        </p>
        <p style="color: #ccc; font-size: 0.9rem; line-height: 1.6; font-family: 'Arial', sans-serif;">
            The vault is locked until the <strong>Annual Harvest</strong>. We only break the lock for:
        </p>
        <ul style="color: #ccc; font-size: 0.85rem; padding-left: 20px; line-height: 1.6;">
            <li><span style="color: var(--critical-red);">Account Liquidation:</span> Selling your vehicle / leaving Laveto.</li>
            <li><span style="color: var(--critical-red);">Extreme Hardship:</span> Catastrophic emergency (Forfeits all interest).</li>
        </ul>
        <h3 style="color: white; margin-bottom: 15px; font-family: 'Courier Prime', monospace;">How would you like to proceed?</h3>
        <button class="btn-touch" onclick="document.getElementById('educator-gate-modal').style.display='none'" style="display: block; width: 100%; padding: 12px; margin-bottom: 10px; background: var(--integrity-green); color: black; border: none; font-weight: bold; cursor: pointer; text-transform: uppercase; font-family: 'Montserrat';">
            🛡️ Cancel Request (Keep Growing)
        </button>
        <form action="#" method="POST" onsubmit="return confirm('Hardship forfeits interest. Proceed?');">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn-touch" style="display: block; width: 100%; padding: 12px; margin-bottom: 10px; background: transparent; color: var(--integrity-gold); border: 1px solid var(--integrity-gold); cursor: pointer; text-transform: uppercase; font-family: 'Montserrat'; transition: 0.3s;">
                Apply for Extreme Hardship
            </button>
        </form>
        <form action="#" method="POST" onsubmit="return confirm('Permanently close account?');">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn-touch" style="display: block; width: 100%; padding: 12px; background: transparent; color: var(--critical-red); border: 1px solid var(--critical-red); cursor: pointer; text-transform: uppercase; font-family: 'Montserrat'; transition: 0.3s;">
                Liquidate & Leave Laveto
            </button>
        </form>
    </div>
</div>

<div id="whitePaperModal" class="modal-overlay" onclick="this.style.display='none'">
    <div class="law-modal" onclick="event.stopPropagation()" style="max-width: 800px; border-top: 8px solid var(--integrity-gold);">
        <span class="close-modal" onclick="document.getElementById('whitePaperModal').style.display='none'">×</span>
        <h2 style="font-family: 'Montserrat'; font-weight: 900; color: var(--integrity-gold); text-transform: uppercase; letter-spacing: 3px; margin-top: 0;">Document 263: The Sovereign 500 Protocol</h2>
        <p style="font-family: 'Courier Prime'; color: var(--text-muted); font-size: 0.8rem; margin-bottom: 30px;">DECENTRALIZED ASSET RESTORATION FRAMEWORK // HANGAR 01 OPS</p>
        <div class="covenant-text" style="font-family: 'Inter'; line-height: 1.8; color: var(--text-main);">

            <h3 style="color: var(--integrity-gold); font-size: 1rem; text-transform: uppercase;">I. Protocol Objective: Asset-Backed Sovereignty</h3>
            <p>The Laveto Protocol tokenizes mechanical lifecycle maintenance. By redirecting depreciating maintenance capital into the trustless Sovereign Liquidation Pool (SLP), the protocol transforms legacy, static repair overhead into hard, yield-generating digital infrastructure.</p>

            <h3 style="color: var(--integrity-gold); font-size: 1rem; text-transform: uppercase; margin-top: 25px;">II. Forensic Consensus: Proof-of-Intervention (PoI)</h3>
            <p>Every physical mechanical intervention is rendered cryptographically unassailable. Captured via immutable 4K body-worn streaming telemetry and dynamically audited by the automated AI Sentinel, data is permanently anchored to the vehicle's on-chain Digital Passport to enforce true asset validation.</p>

            <h3 style="color: var(--integrity-gold); font-size: 1rem; text-transform: uppercase; margin-top: 25px;">III. The 60/40 Tokenomic Partition</h3>
            <p>Capital injected into the protocol is deterministically bifurcated via smart-contract architecture into two dedicated non-custodial vaults:<br>
                <strong>Equity Reserve (60%):</strong> Staked capital locked within the SLP, optimized for compounding internal yield generation.<br>
                <strong>Shield Reservoir (40%):</strong> On-demand defensive liquidity strictly reserved for high-velocity mechanical claims execution.</p>

            <h3 style="color: var(--integrity-gold); font-size: 1rem; text-transform: uppercase; margin-top: 25px;">IV. The Sovereign Credit Loop</h3>
            <p>Participants leverage accrued Vault Equity as underlying debt collateral to instantly enter the Credit Loop. Capital utilization triggers automated liquidity lines at a flat 10% APR, entirely bypassing centralized predatory banking legacy frameworks and returning economic power back to the node operators.</p>
        </div>
        <button class="btn-understand btn-touch" style="margin-top: 30px;" onclick="document.getElementById('whitePaperModal').style.display='none'">CLOSE CODEX</button>
    </div>
</div>

<div id="renewalModal" class="covenant-modal-overlay" onclick="this.style.display='none'">
    <div class="covenant-modal-box" onclick="event.stopPropagation()" style="border-color: #66b3ff; box-shadow: 0 0 30px rgba(102,179,255,0.15); position: relative;">
        <span class="close-modal" onclick="document.getElementById('renewalModal').style.display='none'" style="position: absolute; top: 15px; right: 20px; font-size: 1.5rem; cursor: pointer; color: #888;">&times;</span>
        <h2 class="covenant-title" style="color: #66b3ff; border-bottom-color: #333;">🛡️ VIP Concierge Protocol</h2>
        <div class="covenant-text">
            <p style="color: white; font-size: 1.05rem;">You are about to activate the <strong>Laveto Concierge Desk</strong>.</p>
            <p>By authorizing this uplink, Laveto Command will interface with local transport authorities on your behalf to:</p>
            <ul style="color: #ccc; line-height: 1.8; margin-bottom: 20px;">
                <li>Scan and clear any outstanding traffic fines with the Botswana Police.</li>
                <li>Process your annual vehicle license disc (Lekgetho) renewal.</li>
                <li>Securely upload the digital disc to your Vault.</li>
            </ul>
        </div>
        <form action="/hangar/trigger_procurement/{{ r.id }}" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <button type="submit" class="btn-understand btn-touch" style="background: #66b3ff; color: #000;">AUTHORIZE RENEWAL</button>
        </form>
    </div>
</div>
<!-- ========================================================================== -->
<!-- ⚙️ THE HARDENED GOSPEL OS JAVASCRIPT ENGINE -->
<!-- ========================================================================== -->
<script>
    // 1. SECURE CONTEXT INJECTION (Prevents "Undefined Asset" errors)
    const GOSPEL_CONTEXT = {
        id: "{{ r.id if r is defined else (record.id if record is defined else 0) }}",
        vin: "{{ r.vin_dna if r is defined else (record.vin_dna if record is defined else 'UNKNOWN') }}",
        baseOdo: parseInt("{{ r.base_mileage if r is defined else (record.base_mileage if record is defined else 0) }}", 10) || 0,
        memberName: "{{ r.member_name if r is defined else (record.member_name if record is defined else 'Sovereign Member') }}"
    };

    const ARCHITECT_CONFIG = {
        maxLifespanKm: 7500
    };

    // --- 🛠️ GLOBAL UTILITIES & SECURITY ---
    function getCsrfToken() {
        const tokenEl = document.querySelector('input[name="csrf_token"]');
        return tokenEl ? tokenEl.value : "";
    }

    function showToast(msg, type = 'info') {
        const toast = document.getElementById("gospel-toast");
        if(!toast) return;
        toast.innerText = msg;
        toast.className = "gospel-toast show";
        if (type === 'error') { toast.classList.add('error'); } else { toast.classList.remove('error'); }
        if (type === 'success') { toast.classList.add('success'); } else { toast.classList.remove('success'); }
        setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 4000);
    }

    function copyTextFallback(text) {
        const tempTextArea = document.createElement("textarea");
        tempTextArea.value = text;
        tempTextArea.style.top = "0";
        tempTextArea.style.left = "0";
        tempTextArea.style.position = "fixed";
        document.body.appendChild(tempTextArea);
        tempTextArea.focus();
        tempTextArea.select();
        try {
            const successful = document.execCommand('copy');
            if (successful) {
                showToast('🔗 TRANSMISSION LINK COPIED', 'success');
            } else {
                showToast('⚠️ COPY LINK FAILED', 'error');
            }
        } catch (err) {
            console.error('Fallback copy failed', err);
            showToast('⚠️ UNABLE TO EXECUTE COPY', 'error');
        }
        document.body.removeChild(tempTextArea);
    }

    // --- 🌗 UI & MODAL TOGGLES ---
    function toggleVaultTheme() {
        const body = document.body;
        const currentTheme = body.getAttribute('data-theme') || 'dark';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        body.setAttribute('data-theme', newTheme);
        localStorage.setItem('vault-theme', newTheme);
    }

    function toggleRosetta() {
        const body = document.body;
        const currentState = body.getAttribute('data-rosetta') || 'on';
        const newState = currentState === 'on' ? 'off' : 'on';
        body.setAttribute('data-rosetta', newState);
        localStorage.setItem('vault-rosetta', newState);
        showToast(newState === 'on' ? "💬 SYSTEM TRANSLATION: ACTIVE" : "⚙️ RAW TERMINAL: ACTIVE", "success");
    }

    function switchGospelTab(targetView) {
        const doctrineView = document.getElementById('gospel-view-doctrine');
        const roadmapView = document.getElementById('gospel-view-roadmap');
        const doctrineBtn = document.getElementById('tab-link-doctrine');
        const roadmapBtn = document.getElementById('tab-link-roadmap');

        if (targetView === 'roadmap') {
            if(doctrineView) doctrineView.style.display = 'none';
            if(roadmapView) roadmapView.style.display = 'block';
            if(doctrineBtn) doctrineBtn.classList.remove('active');
            if(roadmapBtn) roadmapBtn.classList.add('active');
        } else {
            if(doctrineView) doctrineView.style.display = 'block';
            if(roadmapView) roadmapView.style.display = 'none';
            if(roadmapBtn) roadmapBtn.classList.remove('active');
            if(doctrineBtn) doctrineBtn.classList.add('active');
        }
    }

    function toggleShieldTerms(event) {
        if (event) event.stopPropagation();
        var termsBox = document.getElementById("shield-terms-box");
        if(termsBox) termsBox.style.display = (termsBox.style.display === "none" || termsBox.style.display === "") ? "block" : "none";
    }

    function openVideoGuide() {
        const modal = document.getElementById('videoModal');
        const iframe = document.getElementById('vaultGuideFrame');
        if(iframe) iframe.src = "https://www.youtube.com/embed/Lwu76RaLYfo?autoplay=1&rel=0&modestbranding=1";
        if(modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    }

    function closeVideoModal() {
        const modal = document.getElementById('videoModal');
        const iframe = document.getElementById('vaultGuideFrame');
        if(modal) modal.style.display = 'none';
        if(iframe) iframe.src = "";
        document.body.style.overflow = 'auto';
    }

    function openCovenantModal() { const m = document.getElementById('covenantModal'); if(m) m.style.display = 'flex'; }
    function closeCovenantModal() { const m = document.getElementById('covenantModal'); if(m) m.style.display = 'none'; }
    function unsealLaws() { openCovenantModal(); }

    // --- 🎛️ GAUGE RENDERING ENGINE (Service Matrix & Oil Viscosity) ---
    function updateGaugesUI(currentOdo, baseMileage) {
        currentOdo = parseInt(currentOdo, 10) || 0;
        baseMileage = parseInt(baseMileage, 10) || 0;

        const driven = Math.max(0, currentOdo - baseMileage);
        const km_pct = Math.min(1.0, driven / ARCHITECT_CONFIG.maxLifespanKm);
        const health_pct = Math.max(0, Math.round(100 - (km_pct * 100)));

        const displayKm = document.getElementById('display_km');
        if (displayKm) displayKm.innerText = driven.toLocaleString();

        const displayHealth = document.getElementById('display_health');
        if (displayHealth) displayHealth.innerText = health_pct + "%";

        const vial = document.getElementById('vial_fill');
        if (vial) {
            const fillHeight = Math.max(5, (km_pct * 100));
            vial.style.height = fillHeight + "%";
            vial.style.backgroundColor = driven >= 7500 ? 'var(--critical-red)' :
                                         driven >= 5000 ? 'var(--warning-orange)' : 'var(--integrity-gold)';
        }

        const ring = document.getElementById('ring_fluid');
        if (ring) {
            ring.style.strokeDashoffset = 251.32 * ((100 - health_pct) / 100);
            ring.style.stroke = health_pct <= 25 ? 'var(--critical-red)' :
                                health_pct <= 50 ? 'var(--warning-orange)' : 'var(--integrity-green)';
        }
    }

    // --- 📡 THE HARDENED TELEMETRY UPLINK ---
    async function syncLiveTelemetry(event) {
        console.log("📡 Sentinel Telemetry Sync Initiated...");
        if (event) { event.preventDefault(); event.stopPropagation(); }

        const odoInput = document.getElementById('odometer_input');
        if (!odoInput || !odoInput.value) {
            showToast("🚨 TRANSACTION BLOCKED: ENTER VALID ODOMETER", "error");
            return;
        }

        const currentOdo = parseInt(odoInput.value, 10);
        const baseMileage = GOSPEL_CONTEXT.baseOdo;
        const assetId = GOSPEL_CONTEXT.id;

        if (isNaN(currentOdo)) {
            showToast("🚨 INVALID DATA: ODOMETER MUST BE NUMERIC", "error");
            return;
        }

        if (currentOdo < baseMileage) {
            showToast("🚨 MECHANICAL MALWARE: ODOMETER CANNOT REVERSE", "error");
            odoInput.style.borderColor = "var(--critical-red)";
            setTimeout(() => odoInput.style.borderColor = "var(--border-ui)", 3000);
            return;
        }

        const btn = document.getElementById('btnSyncTelemetry');
        if(btn) { btn.disabled = true; btn.innerText = "🔬 SCANNING PIXELS..."; }

        try {
            const targetUrl = "/hangar/update_telemetry/" + assetId;
            const response = await fetch(targetUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-CSRFToken': getCsrfToken()
                },
                body: JSON.stringify({ odometer: currentOdo })
            });

            const responseText = await response.text();
            let data;

            try {
                data = JSON.parse(responseText);
            } catch (e) {
                console.error("Telemetry Sync Non-JSON Response:", responseText);
                throw new Error(`HTTP ${response.status}: Server returned HTML. Check console.`);
            }

            if (!response.ok) throw new Error(data.message || `Backend Rejected (HTTP ${response.status})`);

            if (data.status === 'success') {
                updateGaugesUI(currentOdo, baseMileage);
                showToast("📡 TELEMETRY ANCHORED // GAUGES SANCTIFIED", "success");
                const successMsg = document.getElementById('telemetry_success');
                if(successMsg) successMsg.style.display = 'block';
                if(btn) {
                    btn.innerText = "✅ DATA ANCHORED";
                    setTimeout(() => { btn.disabled = false; btn.innerText = "SYNC DATA"; if(successMsg) successMsg.style.display = 'none'; }, 3000);
                }
            } else {
                throw new Error(data.message || "Unknown backend failure");
            }
        } catch (err) {
            console.error("Telemetry Sync Error:", err);
            showToast("🚨 UPLINK REJECTED: " + err.message, "error");
            if(btn) { btn.disabled = false; btn.innerText = "SYNC DATA"; }
        }
    }

    // --- 🚨 EMERGENCY MAYDAY PROTOCOL ---
    function deployClientBeacon(fallbackAssetId) {
        const btn = document.getElementById('clientMaydayBtn');
        const statusText = document.getElementById('maydayStatusText');
        const assetId = GOSPEL_CONTEXT.id || fallbackAssetId;

        if (!confirm("🚨 DEPLOY BEACON? This will immediately scramble a Field Agent.")) return;

        if(btn) { btn.disabled = true; btn.innerHTML = "⏳ LOCKING GPS..."; }
        if(statusText) statusText.style.display = "block";

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function(pos) { transmitToCommand(assetId, String(pos.coords.latitude), String(pos.coords.longitude)); },
                function() { transmitToCommand(assetId, "0.0", "0.0"); },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        } else { transmitToCommand(assetId, "0.0", "0.0"); }
    }

    function transmitToCommand(assetId, lat, lng) {
        const btn = document.getElementById('clientMaydayBtn');
        const statusText = document.getElementById('maydayStatusText');

        fetch("/hangar/mayday_signal", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRFToken': getCsrfToken() },
            body: JSON.stringify({ vin_dna: assetId, latitude: lat, longitude: lng })
        })
        .then(async res => {
            const text = await res.text();
            try {
                const data = JSON.parse(text);
                if (!res.ok) throw new Error(data.message || `HTTP ${res.status}`);
                return data;
            } catch (e) {
                console.error("Mayday Non-JSON Response:", text);
                throw new Error(`HTTP ${res.status}: HTML returned. Check console.`);
            }
        })
        .then(data => {
            if (data.status === 'success') {
                if(btn) btn.innerHTML = "📡 BEACON ACTIVE";
                if(statusText) statusText.innerText = "✅ TRANSMITTED TO HIGH COMMAND.";
                showToast("📡 BEACON SECURED", "success");
            } else { throw new Error(data.message); }
        })
        .catch(err => {
            if(statusText) statusText.innerText = "🚨 ERROR: " + err.message;
            if(btn) { btn.disabled = false; btn.innerHTML = "🚨 RETRY DEPLOYMENT"; }
            showToast("🚨 BEACON FAILED: " + err.message, "error");
        });
    }

    // --- 🤖 AI SENTINEL (ORACLE) PROTOCOL WITH ROBUST FALLBACK ---
    let oracleChatHistory = [];

    function unsealComponentInfo(compName) {
        showToast("🔍 RETRIEVING TELEMETRY: " + compName.toUpperCase(), "info");
        const inputField = document.getElementById('comms-input');
        const aiPanel = document.querySelector('.ai-assistant-panel');

        if (inputField) {
            inputField.value = "Accessing ledger. Give me a detailed wear analysis, failure symptoms, and Laveto restoration protocol for the " + compName + ".";
            if (aiPanel) aiPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
            setTimeout(() => { sendToPersona(); }, 500);
        }
    }

    async function sendToPersona() {
        const inputField = document.getElementById('comms-input');
        const chatScreen = document.getElementById('comms-screen');
        if (!inputField || !inputField.value.trim()) return;

        const payload = inputField.value.trim();
        inputField.value = '';
        appendOracleMsg("...You", payload, true, chatScreen);

        const csrf = getCsrfToken();
        if (!csrf) {
            appendOracleMsg("⚠️ SYSTEM", "CSRF Token missing. Please refresh the page.", false, chatScreen);
            return;
        }

        const loadingId = "loading_" + Date.now();
        appendOracleMsg("🛠️ LAVETO ORACLE", "Processing query...", false, chatScreen, loadingId);

        // 🟢 ROBUST FALLBACK ENGINE: Bypasses 404s by testing multiple valid route structures
        const potentialEndpoints = [
            "{{ url_for('hangar.persona_triage') if url_for else '' }}",
            "/hangar/api/persona/triage",
            "/hangar/persona_triage",
            "/api/persona/triage"
        ].filter(Boolean); // removes empty strings

        let successfulResponse = null;
        let finalData = null;

        for (const endpoint of potentialEndpoints) {
            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRFToken': csrf
                    },
                    body: JSON.stringify({
                        message: payload,
                        asset_id: GOSPEL_CONTEXT.vin,
                        client_name: GOSPEL_CONTEXT.memberName,
                        history: oracleChatHistory
                    })
                });

                if (response.status === 404) continue; // Try the next endpoint

                const responseText = await response.text();

                try {
                    finalData = JSON.parse(responseText);
                } catch (e) {
                    throw new Error(`HTTP Error ${response.status} (Backend offline or HTML response returned)`);
                }

                if (!response.ok) {
                    throw new Error(finalData.message || finalData.error || `HTTP Error ${response.status} (Backend Rejected)`);
                }

                successfulResponse = response;
                break; // Stop looking, we found the right route
            } catch (err) {
                console.warn(`Oracle Endpoint ${endpoint} failed:`, err.message);
                if (endpoint === potentialEndpoints[potentialEndpoints.length - 1] && !successfulResponse) {
                    const loadElement = document.getElementById(loadingId);
                    if(loadElement) loadElement.remove();
                    appendOracleMsg("⚠️ SYSTEM", "CONNECTION FAILED: " + err.message, false, chatScreen);
                    return;
                }
            }
        }

        if (successfulResponse && finalData) {
            const loadElement = document.getElementById(loadingId);
            if(loadElement) loadElement.remove();

            if (finalData.response) {
                appendOracleMsg("🛠️ LAVETO ORACLE", finalData.response.replace(/\n/g, '<br>'), false, chatScreen);
                oracleChatHistory.push({ role: "user", text: payload });
                oracleChatHistory.push({ role: "model", text: finalData.response });
                if (oracleChatHistory.length > 10) oracleChatHistory = oracleChatHistory.slice(-10);
            } else {
                appendOracleMsg("⚠️ SYSTEM", "Invalid response format from Oracle.", false, chatScreen);
            }
        }
    }

    function appendOracleMsg(sender, text, isMe, container, id = null) {
        if (!container) return;
        const bubble = document.createElement('div');
        if (id) bubble.id = id;
        const align = isMe ? 'flex-end' : 'flex-start';
        // FIXED ALIGNMENT: Added box-sizing and word-wrap so bubbles do not break mobile layout
        bubble.style = `box-sizing: border-box; word-wrap: break-word; overflow-wrap: break-word; max-width: 85%; padding: 12px; margin-bottom: 10px; border-radius: 4px; align-self: ${align}; background: ${isMe ? 'var(--sanctified-blue)' : 'var(--card-bg)'}; color: var(--text-main); font-size: 0.85rem; font-family: 'Courier Prime', monospace; border: 1px solid ${isMe ? 'var(--sanctified-blue)' : 'var(--integrity-gold)'}; line-height: 1.4;`;
        bubble.innerHTML = `<b style="color: ${isMe ? '#a6c8ff' : 'var(--integrity-gold)'}">${sender}</b><br><br>${text}`;
        container.appendChild(bubble);
        container.scrollTop = container.scrollHeight;
    }

    function toggleAiCommands() {
        const drawer = document.getElementById('ai-commands-drawer');
        const btn = document.getElementById('ai-toggle-btn');
        if(!drawer || !btn) return;

        if (drawer.style.maxHeight === '0px' || drawer.style.maxHeight === '0') {
            drawer.style.maxHeight = '500px';
            drawer.style.opacity = '1';
            drawer.style.marginBottom = '10px';
            btn.innerHTML = '🔽 HIDE SHORTCUTS';
        } else {
            drawer.style.maxHeight = '0px';
            drawer.style.opacity = '0';
            drawer.style.marginBottom = '0px';
            btn.innerHTML = '⚡ SHOW SHORTCUTS';
        }
    }

    // ==========================================================
    // 🖋️ SOVEREIGN SIGNATURE PAD ENGINE
    // ==========================================================
    let signaturePad = null;
    let sigCtx = null;
    let isDrawing = false;
    let signatureStarted = false;

    window.addEventListener('DOMContentLoaded', () => {
        signaturePad = document.getElementById('covenantSignaturePad');
        if (signaturePad) {
            sigCtx = signaturePad.getContext('2d');
            sigCtx.strokeStyle = '#000000'; // Formal Black Ink
            sigCtx.lineWidth = 3;
            sigCtx.lineCap = 'round';

            signaturePad.addEventListener('mousedown', startDrawing);
            signaturePad.addEventListener('mousemove', draw);
            signaturePad.addEventListener('mouseup', stopDrawing);
            signaturePad.addEventListener('mouseleave', stopDrawing);

            signaturePad.addEventListener('touchstart', handleTouchStart, {passive: false});
            signaturePad.addEventListener('touchmove', handleTouchMove, {passive: false});
            signaturePad.addEventListener('touchend', stopDrawing);
        }
    });

    function startDrawing(e) {
        isDrawing = true;
        signatureStarted = true;
        draw(e);
    }

    function draw(e) {
        if (!isDrawing || !sigCtx || !signaturePad) return;
        const rect = signaturePad.getBoundingClientRect();
        const scaleX = signaturePad.width / rect.width;
        const scaleY = signaturePad.height / rect.height;

        const x = (e.clientX - rect.left) * scaleX;
        const y = (e.clientY - rect.top) * scaleY;

        sigCtx.lineTo(x, y);
        sigCtx.stroke();
        sigCtx.beginPath();
        sigCtx.moveTo(x, y);
    }

    function stopDrawing() {
        isDrawing = false;
        if(sigCtx) sigCtx.beginPath();
    }

    function handleTouchStart(e) {
        if (e.touches.length === 1 && signaturePad) {
            e.preventDefault();
            const touch = e.touches[0];
            const mouseEvent = new MouseEvent("mousedown", { clientX: touch.clientX, clientY: touch.clientY });
            signaturePad.dispatchEvent(mouseEvent);
        }
    }

    function handleTouchMove(e) {
        if (e.touches.length === 1 && signaturePad) {
            e.preventDefault();
            const touch = e.touches[0];
            const mouseEvent = new MouseEvent("mousemove", { clientX: touch.clientX, clientY: touch.clientY });
            signaturePad.dispatchEvent(mouseEvent);
        }
    }

    function clearSovereignSignature() {
        if (sigCtx && signaturePad) {
            sigCtx.clearRect(0, 0, signaturePad.width, signaturePad.height);
            signatureStarted = false;
            document.getElementById('digital_signature_base64').value = '';
        }
    }

    function executeMandateForge() {
        if (!signatureStarted) {
            showToast("🚨 PLEASE APPLY YOUR DIGITAL SIGNATURE", "error");
            const sigBox = document.getElementById('covenantSignaturePad').parentElement.parentElement;
            sigBox.style.borderColor = 'var(--critical-red)';
            setTimeout(() => { sigBox.style.borderColor = 'var(--integrity-gold)'; }, 2000);
            return;
        }

        if (signaturePad) {
            const dataUrl = signaturePad.toDataURL('image/png');
            document.getElementById('digital_signature_base64').value = dataUrl;
        }

        const form = document.getElementById('digital_signature_base64').closest('form');

        if (form.checkValidity()) {
            if (confirm('Initiate Stop Order Mandate? This will securely transmit your biometric signature to Laveto Command.')) {
                const btn = form.querySelector('button[onclick="executeMandateForge()"]');
                if (btn) {
                    btn.innerText = "⏳ TRANSMITTING MANDATE...";
                    btn.style.pointerEvents = "none";
                    btn.style.opacity = "0.7";
                }
                form.submit();
            }
        } else {
            form.reportValidity();
        }
    }

    // --- 📦 SOVEREIGN SUPPLY MODULE EJECTION ---
    function ejectModule() {
        const module = document.getElementById('supplyModule');
        const status = document.getElementById('statusBadge');
        const content = document.getElementById('contentArea');
        const actions = document.getElementById('actionRow');

        if (!module || !status || !content || !actions) return;

        status.textContent = "STATUS: TERMINATED";
        status.style.background = "rgba(211,47,47,0.1)";
        status.style.color = "var(--critical-red)";
        status.style.borderColor = "var(--critical-red)";
        module.style.borderTopColor = "var(--critical-red)";
        content.innerHTML = '<p style="color: var(--critical-red); font-size: 0.85rem; font-family: \'Courier Prime\', monospace; font-weight: bold; letter-spacing: 1px; margin: 0;">[ UPLINK DISCONNECTED: NODE EJECTED ]</p>';
        content.style.borderColor = "var(--critical-red)";
        actions.style.opacity = "0.3";
        actions.style.pointerEvents = "none";
    }

    const SovereignSupply = {
        init: function() { console.log("Sovereign Supply: Logistics node initialized."); },
        updateUI: function(data) {}
    };

    // --- 💸 EFT TRANSFER NOTIFICATION ENGINE ---
    async function notifyEFTTransfer(event) {
        event.preventDefault();
        const amountInput = document.getElementById('eft_amount_input');
        const submitBtn = document.getElementById('btnNotifyEFT');
        if (!amountInput) return;

        const amount = parseFloat(amountInput.value);
        if (isNaN(amount) || amount <= 0) return;

        const csrf = getCsrfToken();
        if (!csrf) {
            showToast("🚨 CSRF Token missing. Please refresh the page.", "error");
            return;
        }

        if(submitBtn) { submitBtn.disabled = true; submitBtn.innerText = "TRANSMITTING..."; }

        try {
            const safeEndpoint = window.location.origin + "/hangar/notify_eft_transfer";
            const response = await fetch(safeEndpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-CSRFToken': csrf
                },
                body: JSON.stringify({ amount: amount, asset_id: GOSPEL_CONTEXT.id })
            });

            const responseText = await response.text();
            let data;
            try {
                data = JSON.parse(responseText);
            } catch (e) {
                console.error("EFT Non-JSON Response:", responseText);
                throw new Error(`HTTP Error ${response.status} (Server returned HTML)`);
            }

            if (!response.ok) throw new Error(data.message || `HTTP Error ${response.status}`);

            showToast("✅ EFT NOTIFICATION TRANSMITTED", "success");
            amountInput.value = '';
        } catch (error) {
            console.error("EFT Notification Error:", error);
            let errMsg = error.message;
            if (errMsg.includes('Failed to fetch') || errMsg.includes('NetworkError')) {
                errMsg = "Network error or route missing (/hangar/notify_eft_transfer).";
            }
            showToast("🚨 ERROR: " + errMsg, "error");
        } finally {
            if(submitBtn) { submitBtn.disabled = false; submitBtn.innerText = "NOTIFY COMMAND"; }
        }
    }

    // --- 🚀 INITIALIZATION & GLOBAL EVENT LISTENERS ---
    window.addEventListener('DOMContentLoaded', () => {
        // Layout Diagnostics (from Architect request)
        (function() {
            const container = document.querySelector('.vault-container');
            const stickyNav = document.querySelector('.sticky-nav-wrapper');
            window.diagnosticData = {
                container: container ? { width: container.offsetWidth, maxWidth: getComputedStyle(container).maxWidth, padding: getComputedStyle(container).padding } : null,
                stickyNav: stickyNav ? { width: stickyNav.offsetWidth, position: getComputedStyle(stickyNav).position, left: stickyNav.getBoundingClientRect().left } : null,
                windowWidth: window.innerWidth
            };
            console.table(window.diagnosticData);
        })();

        SovereignSupply.init();

        // Theme & Rosetta Load
        const savedTheme = localStorage.getItem('vault-theme') || 'dark';
        document.body.setAttribute('data-theme', savedTheme);
        const savedRosetta = localStorage.getItem('vault-rosetta') || 'on';
        document.body.setAttribute('data-rosetta', savedRosetta);

        // Instantly Load Gauges
        const odoInput = document.getElementById('odometer_input');
        const initialOdo = odoInput && odoInput.value ? parseInt(odoInput.value, 10) : GOSPEL_CONTEXT.baseOdo;
        if (!isNaN(initialOdo)) { updateGaugesUI(initialOdo, GOSPEL_CONTEXT.baseOdo); }

        // Accordion Setup
        const acc = document.getElementsByClassName("accordion-btn");
        for (let i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function() {
                this.classList.toggle("active");
                const panel = this.nextElementSibling;
                if(panel) { panel.style.maxHeight = panel.style.maxHeight ? null : panel.scrollHeight + 50 + "px"; }
            });
        }

        // Chat Input Setup
        const inputField = document.getElementById('comms-input');
        if (inputField) {
            inputField.addEventListener("keypress", (e) => {
                if(e.key === "Enter") { e.preventDefault(); sendToPersona(); }
            });
        }
    });

    // Security: Auto-logout after 15 minutes of inactivity
    setTimeout(function() { window.location.href = "/logout"; }, 900000);
</script>
</body>
</html>