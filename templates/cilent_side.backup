<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laveto Interface Module</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Courier+Prime&display=swap');

        /* 🔥 GLOBAL MOBILE ALIGNMENT FIXES 🔥 */
        *, *::before, *::after {
            box-sizing: border-box !important;
        }
        html, body {
            max-width: 100vw;
            overflow-x: hidden;
        }
        .cockpit-left, .cockpit-right, .fin-card, .score-item, .proof-card, .client-matrix-grid, .financial-grid, .main-grid-sanctuary, .vault-container, .hero-profile, .accordion-content, form, .booking-input-group, .covenant-modal-box, .law-modal {
            min-width: 0 !important;
            max-width: 100% !important;
        }
        canvas, img, video, iframe {
            max-width: 100% !important;
            height: auto;
        }
        h1, h2, h3, h4, p, span, div, .fin-value, .brand-box {
            overflow-wrap: break-word !important;
            word-wrap: break-word !important;
        }

        :root {
            --sanctified-blue: #0033a0;
            --integrity-gold: #ffd700;
            --integrity-green: #00ff88;
            --critical-red: #d32f2f;
            --warning-orange: #ffaa00;
            --deep-oil-black: #050505;
            --vault-gray: #161b22;
            --forensic-white: #f0f6fc;
            --border-ui: #30363d;
            --input-bg: #010409;
            --text-muted: #8b949e;
            --bg-main: var(--deep-oil-black);
            --text-main: var(--forensic-white);
            --card-bg: var(--vault-gray);
        }

        [data-theme="light"] {
            --bg-main: #f0f2f5 !important;
            --card-bg: rgba(255, 255, 255, 0.9) !important;
            --border-ui: rgba(0, 0, 0, 0.15) !important;
            --input-bg: rgba(255, 255, 255, 0.7) !important;
            --text-muted: #555555 !important;
            --text-main: #111111 !important;
        }

        /* 🌟 ACCESSIBILITY AUDIT FIXES */
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
        }

        .financial-grid, .audit-ledger { color: #FFFFFF; }
        .financial-grid h4, .financial-grid .available-balance { color: #E0E0E0; }

        [data-theme="light"] .theme-toggle,
        [data-theme="light"] .section-title,
        [data-theme="light"] .btn-touch {
            color: #7A6600 !important;
            border-color: #7A6600 !important;
        }

        body { font-family: 'Courier Prime', monospace; background-color: var(--deep-oil-black); color: var(--forensic-white); }
        .border-gold { border: 1px solid var(--integrity-gold); }
        .text-gold { color: var(--integrity-gold); }
        .text-green { color: var(--integrity-green); }
        .text-red { color: var(--critical-red); }
        .border-red { border: 1px dashed var(--critical-red); }
        .maturity-panel, .shield-yield-panel, .fin-card, .loan-request-panel, .audit-ledger, .booking-input-group, .credit-tier-card, .score-item, .flicker-engine, .proof-card, .vault-header {
            box-shadow: 0 15px 35px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05) !important;
            border-radius: 4px;
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-main); }
        ::-webkit-scrollbar-thumb { background: var(--border-ui); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--integrity-gold); }

        body {
            margin: 0; padding: 0; font-family: 'Inter', sans-serif;
            background-color: var(--bg-main); color: var(--text-main);
            transition: background-color 0.4s ease, color 0.4s ease;
            scroll-behavior: smooth;
        }

        *:focus-visible { outline: 2px solid var(--integrity-gold); outline-offset: 2px; }

        /* 📱 MOBILE AUDIT FIX: Enforced standard interactive tap targets */
        .btn-touch, .theme-toggle, .gospel-tab-btn, button, input[type="button"], input[type="submit"], select, input[type="text"], input[type="number"], input[type="email"] {
            min-height: 46px;
            box-sizing: border-box;
        }


       .vault-container {
max-width: 1400px;
width: 100%;
margin: 0 auto;
padding: 120px 5% 40px 5%; /* 120px safely clears the desktop nav /
box-sizing: border-box;
position: relative; / Establishes a new stacking context /
z-index: 1;         / Forces all content safely under the fixed nav */
}

/* 🧲 STICKY COCKPIT NAV ENGINE - FROSTED GLASS EFFECT /
.sticky-nav-wrapper {
position: fixed !important; / Bulletproof lock to the viewport /
top: 0;
left: 0;
width: 100%;
z-index: 9999;
padding: 15px 5%;
background: rgba(5, 5, 5, 0.85);
backdrop-filter: blur(12px);
-webkit-backdrop-filter: blur(12px);
border-bottom: 1px solid var(--border-ui);
box-shadow: 0 10px 30px rgba(0,0,0,0.8);
box-sizing: border-box;
overflow: visible; / Prevents internal header components from clipping */
}

[data-theme="light"] .sticky-nav-wrapper {
background: rgba(240, 242, 245, 0.85);
box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}
/* 🛡️ Pushes the cards down so they don't hide behind the fixed navbar */
.vault-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 100px 5% 40px 5%; /* 100px top padding added here */
    box-sizing: border-box;
}
/* Example of a visually-hidden class */
.sr-only {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;
        }

        .cockpit-header {
            display: flex; justify-content: space-between; align-items: center;
            flex-wrap: wrap; gap: 20px; max-width: 1400px; margin: 0 auto;
        }
        .cockpit-header img { max-height: 40px; }
        .nav-actions { display: flex; gap: 10px; align-items: center; }

        .brand-box { text-align: center; padding: 20px 0; margin-bottom: 20px; position: relative; display: flex; justify-content: space-between; align-items: center;}
        .brand-logo { max-width: 220px; height: auto; }

        .theme-toggle {
            background: transparent; border: 1px solid var(--border-ui);
            color: var(--text-muted); padding: 12px 20px; border-radius: 2px;
            font-size: 0.75rem; font-weight: bold; cursor: pointer; text-transform: uppercase;
            font-family: 'Courier Prime', monospace; transition: 0.3s;
        }
        .theme-toggle:hover { border-color: var(--integrity-gold); color: var(--integrity-gold); }

        .gospel-toast {
            visibility: hidden; min-width: 300px; background-color: var(--sanctified-blue);
            color: var(--forensic-white); text-align: center; border-radius: 2px; padding: 20px;
            position: fixed; z-index: 10001; right: 40px; bottom: 40px;
            font-family: 'Courier Prime', monospace; font-size: 1rem; font-weight: bold;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8); border-left: 5px solid var(--integrity-gold);
            opacity: 0; transition: opacity 0.5s, bottom 0.5s, visibility 0.5s; text-transform: uppercase;
        }
        .gospel-toast.show { visibility: visible; opacity: 1; bottom: 60px; }
        .gospel-toast.error { background-color: #111; border-left: 5px solid var(--critical-red); color: var(--critical-red); }
        .gospel-toast.success { background-color: #111; border-left: 5px solid var(--integrity-green); color: var(--integrity-green); }

        .btn-urgent-action {
            display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 15px;
            background: linear-gradient(90deg, var(--critical-red), #990000); color: #ffffff !important;
            padding: 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1.1rem;
            text-transform: uppercase; letter-spacing: 2px; text-decoration: none; border-radius: 4px;
            margin-bottom: 30px; box-shadow: 0 10px 25px rgba(211, 47, 47, 0.4); border: 2px solid #ffaaaa;
            transition: all 0.3s ease; cursor: pointer;
            max-width: 1400px;
            margin-left: auto;
            margin-right: auto;
        }
        .btn-urgent-action:hover { transform: scale(1.01); box-shadow: 0 15px 35px rgba(211, 47, 47, 0.6); filter: brightness(1.1); }
        .btn-urgent-action .click-badge {
            background: #ffffff; color: var(--critical-red); padding: 6px 15px; border-radius: 2px;
            font-size: 0.85rem; font-weight: 900; letter-spacing: 1px; box-shadow: 0 0 15px rgba(255,255,255,0.4);
            animation: shield-pulse 2s infinite;
        }

        .hero-profile { width: 100%; height: 350px; background: #000; border: 1px solid var(--border-ui); border-bottom: 4px solid var(--integrity-gold); border-radius: 4px; overflow: hidden; margin-bottom: 30px; position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.8); }
        .hero-img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; filter: contrast(1.2) grayscale(0.3); }
        .hero-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 30px; display: flex; justify-content: space-between; align-items: flex-end; background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 100%); }
        .hero-tag { border-left: 4px solid var(--integrity-gold); padding-left: 20px; }
        .age-badge { background: var(--integrity-gold); color: #000; padding: 12px 20px; font-family: 'Courier Prime'; font-weight: 900; font-size: 1.1rem; border-radius: 2px; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 0 20px rgba(197, 160, 89, 0.3); }

        .cockpit-split { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40px; width: 100%; max-width: 950px; margin: 0 auto; box-sizing: border-box; }
        .cockpit-left, .cockpit-right { display: flex; flex-direction: column; gap: 30px; min-width: 0; max-width: 100%; width: 100%; box-sizing: border-box; }

        .hardening-status { background: var(--card-bg); padding: 30px; border-radius: 2px; border: 1px solid var(--border-ui); position: relative; overflow: hidden; }
        .hardening-status::before { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, var(--integrity-gold), transparent); }
        .progress-track { background: var(--input-bg); height: 25px; border-radius: 2px; overflow: hidden; border: 1px solid var(--border-ui); margin-top: 15px;}
        .progress-fill { height: 100%; background: linear-gradient(90deg, var(--sanctified-blue) 0%, var(--integrity-gold) 100%); transition: width 1.5s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; justify-content: flex-end; padding-right: 15px; font-family: 'Courier Prime'; font-size: 0.9rem; font-weight: bold; color: white; box-shadow: inset 0 0 10px rgba(0,0,0,0.5); }

        .maturity-panel { background: var(--card-bg); border: 1px solid var(--border-ui); padding: 30px; border-radius: 2px; display: grid; grid-template-columns: 2fr 1fr; gap: 20px; align-items: center; cursor: pointer; transition: 0.3s; margin-bottom: 30px;}
        .maturity-panel:hover { border-color: var(--integrity-gold); filter: brightness(1.1); }
        .inert-panel { border: 2px solid var(--critical-red) !important; background: rgba(211, 47, 47, 0.05) !important; animation: inert-glow 3s infinite ease-in-out; }
        @keyframes inert-glow { 0% { box-shadow: 0 0 0px rgba(211,47,47,0.1); } 50% { box-shadow: 0 0 15px rgba(211,47,47,0.3); } 100% { box-shadow: 0 0 0px rgba(211,47,47,0.1); } }
        .maturity-panel h3 { color: var(--text-main) !important; margin: 0; text-transform: uppercase; font-size: 1.25rem; letter-spacing: 2px; display: flex; align-items: center; gap: 12px; font-weight: 900; }
        @keyframes pulse-icon { 0% { opacity: 0.5; transform: scale(1); } 50% { opacity: 1; transform: scale(1.1); } 100% { opacity: 0.5; transform: scale(1); } }
        .click-hint { font-size: 1.5rem; animation: pulse-icon 2s infinite; color: var(--integrity-gold); }
        .tier-display { font-size: 3.5rem; text-align: center; font-family: 'Montserrat'; font-weight: 900; line-height: 1; text-shadow: 0 5px 15px rgba(0,0,0,0.5); }
        .maturity-stats p { color: var(--text-muted); font-size: 0.95rem; margin: 8px 0 15px; font-weight: 600; font-family: 'Courier Prime'; }

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 10000; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
        .law-modal { background: var(--card-bg); border: 2px solid var(--integrity-gold); max-width: 800px; width: 90%; padding: 50px; border-radius: 2px; position: relative; box-shadow: 0 20px 60px rgba(0,0,0,0.9); max-height: 90vh; overflow-y: auto; }
        .law-card { margin-bottom: 30px; border-left: 3px solid var(--integrity-gold); padding-left: 25px; }
        .law-card h4 { color: var(--integrity-gold); margin: 0 0 8px 0; font-family: 'Courier Prime'; text-transform: uppercase; font-size: 1.1rem; }
        .law-card p { font-size: 1.05rem; line-height: 1.6; color: var(--text-muted); margin: 0; }
        .close-modal { position: absolute; top: 25px; right: 25px; color: var(--text-muted); cursor: pointer; font-size: 2rem; transition: 0.3s; display: flex; align-items: center; justify-content: center; min-height: 46px; min-width: 46px; }
        .close-modal:hover { color: var(--integrity-gold); }

        .vault-header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--border-ui); padding-bottom: 25px; margin-bottom: 30px; flex-wrap: wrap; gap: 20px; }
        .vault-header h1 { font-family: 'Montserrat'; font-size: clamp(1.5rem, 3.5vw, 3rem); margin: 0; letter-spacing: 2px; font-weight: 900; text-shadow: 0 0 20px rgba(197, 160, 89, 0.2); word-break: break-all; }
        .vault-header p { color: var(--integrity-gold); text-transform: uppercase; font-weight: bold; letter-spacing: 2px; font-size: 0.85rem; margin-bottom: 5px; font-family: 'Courier Prime'; }

        .main-grid-sanctuary { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; min-width: 0; }
        .clock-container { position: relative; width: 220px; height: 220px; margin: 0 auto; }
        .clock-svg { transform: rotate(-90deg); width: 100%; height: 100%; filter: drop-shadow(0 0 10px rgba(0,51,102,0.5)); }
        .clock-circle { fill: none; stroke-width: 14; stroke-linecap: round; transition: stroke-dashoffset 1s ease-out, stroke 0.5s ease; }
        .clock-bg { stroke: var(--border-ui); }
        .clock-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; font-family: 'Courier Prime', monospace; width: 100%; }
        .clock-text-main { font-size: 2.2rem; font-weight: 900; color: var(--text-main); }
        .clock-text-sub { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; }

        .vial-container-wrapper { display: flex; height: 200px; align-items: center; justify-content: center; width: 100%; }
        .vial-container { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; position: relative;}
        .vial { width: 90px; height: 190px; background: rgba(255,255,255,0.02); border: 2px solid var(--border-ui); border-radius: 45px; position: relative; overflow: hidden; box-shadow: inset 0 0 20px rgba(0,0,0,0.8); }
        .vial-fill { position: absolute; bottom: 0; width: 100%; transition: height 1s ease, background-color 1s ease; border-radius: 0 0 45px 45px; box-shadow: 0 0 20px rgba(197, 160, 89, 0.5); }
        .vial-markers { position: absolute; right: -40px; height: 100%; display: flex; flex-direction: column; justify-content: space-between; font-family: 'Courier Prime'; font-size: 0.75rem; color: var(--text-muted); padding: 10px 0; box-sizing: border-box; font-weight: bold; }
        .vial-text-container { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-left: 30px; }

        .fluid-alert-box { background: rgba(211, 47, 47, 0.1); border: 1px solid var(--critical-red); color: var(--critical-red); padding: 15px; font-family: 'Courier Prime'; font-size: 0.9rem; font-weight: bold; text-align: center; border-radius: 2px; margin-top: 20px; display: none; text-transform: uppercase; }

        .btn-touch { display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; transition: 0.2s; }
        .btn-passport-cockpit { background: transparent; color: var(--integrity-gold); border: 2px solid var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; margin-bottom: 30px; border-radius: 2px; transition: 0.3s; width: 100%; }
        .btn-passport-cockpit:hover { background: var(--integrity-gold); color: #000; box-shadow: 0 0 20px rgba(197, 160, 89, 0.4); }

        .shield-yield-panel { background: var(--card-bg); border: 1px solid var(--border-ui); border-left: 5px solid var(--integrity-green); border-radius: 2px; padding: 30px; display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; align-items: center; }
        .yield-val-text { font-family: 'Courier Prime', monospace; font-variant-numeric: tabular-nums; letter-spacing: -1px; font-size: 2.5rem; font-weight: 900; text-shadow: 0 5px 15px rgba(0,0,0,0.2); }

        .financial-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background-color: transparent; border: none; }
        .fin-card { background: var(--card-bg); padding: 30px 20px; border-top: 5px solid var(--sanctified-blue); border-left: 1px solid var(--border-ui); border-right: 1px solid var(--border-ui); border-bottom: 1px solid var(--border-ui); text-align: center; position: relative; border-radius: 4px; }
        .fin-label { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 12px; font-family: 'Courier Prime'; font-weight: bold; }
        .fin-value { font-size: 2.2rem; font-weight: 900; color: var(--text-main); font-family: 'Courier Prime', monospace; font-variant-numeric: tabular-nums; letter-spacing: -1px; text-shadow: 0 5px 15px rgba(0,0,0,0.2); }

        .loan-request-panel { background: var(--card-bg); border: 1px solid var(--border-ui); border-radius: 2px; padding: 30px; }
        .request-inputs { display: flex; flex-direction: column; gap: 15px; }
        .request-select, .request-input { background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); padding: 15px; font-family: 'Courier Prime'; font-size: 1rem; border-radius: 2px; box-sizing: border-box; }
        .request-select { border-color: var(--integrity-gold); color: var(--integrity-gold); font-weight: bold; }
        .btn-request { background: var(--integrity-gold); color: var(--bg-main); border: none; font-weight: 900; font-family: 'Montserrat'; letter-spacing: 2px; border-radius: 2px; text-transform: uppercase; transition: 0.3s; box-shadow: 0 5px 15px rgba(197, 160, 89, 0.2); }
        .btn-request:hover:not(:disabled) { background: #e0b866; box-shadow: 0 10px 25px rgba(197, 160, 89, 0.4); }

        .credit-tier-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
        .credit-tier-card { background: var(--input-bg); border: 1px solid var(--border-ui); padding: 25px 20px; border-radius: 2px; text-align: center; cursor: pointer; transition: 0.3s; position: relative; overflow: hidden; }
        .credit-tier-card h4 { font-family: 'Montserrat'; color: var(--text-main); margin: 10px 0 5px 0; text-transform: uppercase; font-size: 1rem; letter-spacing: 1px; }
        .credit-tier-card p { font-family: 'Inter'; font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 20px; }
        .tier-icon { font-size: 2.5rem; margin-bottom: 10px; }
        .tier-status { font-family: 'Courier Prime'; font-weight: bold; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;}
        .active-tier { border-color: var(--integrity-green); }
        .active-tier:hover { box-shadow: 0 0 20px rgba(40, 167, 69, 0.15); transform: translateY(-2px); }
        .diamond-unlocked { border-color: var(--integrity-gold); background: rgba(197, 160, 89, 0.05); }
        .diamond-unlocked:hover { box-shadow: 0 0 25px rgba(197, 160, 89, 0.25); transform: translateY(-2px); }
        .locked-tier { opacity: 0.5; cursor: not-allowed; border-color: var(--border-ui); background: #0a0a0a; }
        .locked-tier::after { content: "🔒"; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 6rem; opacity: 0.05; pointer-events: none; }
        .locked-bar { background: var(--border-ui); height: 4px; width: 100%; border-radius: 2px; margin-top: 15px; overflow: hidden;}
        .locked-fill { background: var(--integrity-gold); height: 100%; box-shadow: 0 0 10px var(--integrity-gold); }

        .flicker-engine { background: var(--input-bg); border: 1px solid var(--border-ui); border-left: 5px solid var(--warning-orange); border-radius: 2px; padding: 40px; text-align: center; }
        .section-title { font-family: 'Montserrat'; text-transform: uppercase; letter-spacing: 4px; font-size: 1.3rem; color: var(--integrity-gold); margin-bottom: 25px; display: flex; align-items: center; gap: 15px; font-weight: 900; text-shadow: 0 0 15px rgba(197, 160, 89, 0.2); }
        .section-title::after { content: ""; flex: 1; height: 1px; background: var(--border-ui); }

        .accordion-btn { background-color: var(--card-bg); color: var(--text-main); padding: 25px; width: 100%; text-align: left; border: 1px solid var(--border-ui); border-left: 4px solid var(--border-ui); outline: none; transition: 0.4s; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; font-size: 1.1rem; display: flex; justify-content: space-between; align-items: center; border-radius: 2px; }
        .accordion-btn.active, .accordion-btn:hover { background-color: var(--input-bg); border-left-color: var(--integrity-gold); color: var(--integrity-gold); }
        .accordion-btn::after { content: '\002B'; color: var(--integrity-gold); font-size: 2rem; font-family: monospace; font-weight: normal; }
        .accordion-btn.active::after { content: "\2212"; }
        .accordion-content { padding: 0 25px; background-color: var(--bg-main); max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; margin-bottom: 30px; border-left: 1px solid var(--border-ui); border-right: 1px solid var(--border-ui); border-bottom: 1px solid var(--border-ui); }

        .scorecard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background-color: var(--border-ui); border-bottom: 1px solid var(--border-ui); }
        .score-item { background: var(--card-bg); padding: 25px; border-left: 5px solid var(--border-ui); display: flex; flex-direction: column; gap: 15px; cursor: help; transition: 0.3s; position: relative; }
        .score-header { display: flex; justify-content: space-between; align-items: center; }
        .comp-name { font-weight: 900; text-transform: uppercase; font-size: 1.1rem; letter-spacing: 1px; font-family: 'Montserrat'; }
        .grade-pill { font-family: 'Courier Prime'; padding: 6px 15px; border-radius: 2px; font-size: 1rem; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
        .badge-warranty { position: absolute; bottom: 15px; left: 25px; background: rgba(197, 160, 89, 0.1); color: var(--integrity-gold); border: 1px solid var(--integrity-gold); padding: 4px 10px; font-family: 'Courier Prime', monospace; font-size: 0.7rem; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; border-radius: 2px; }

        .proof-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1px; background-color: var(--border-ui); border: 1px solid var(--border-ui); margin-bottom: 40px; }
        .proof-card { background: var(--card-bg); overflow: hidden; text-align: center; cursor: pointer; transition: 0.3s; }
        .proof-card:hover { filter: brightness(1.2); }
        .proof-img { width: 100%; height: 220px; object-fit: cover; background: var(--input-bg); display: block; }
        .proof-label { padding: 15px; font-size: 1rem; font-weight: bold; text-transform: uppercase; color: var(--integrity-gold); font-family: 'Montserrat'; letter-spacing: 1px; }

        .audit-ledger { background: var(--card-bg); border: 1px solid var(--border-ui); border-radius: 2px; padding: 30px; }
        .ledger-row { display: grid; grid-template-columns: 1fr 2fr 1fr; padding: 15px; border-bottom: 1px solid var(--border-ui); font-size: 1rem; font-family: 'Courier Prime'; color: var(--text-muted); }

        .btn-logout { background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); text-decoration: none; font-weight: 900; border-radius: 2px; text-transform: uppercase; letter-spacing: 2px; width: 100%; margin-top: 40px; margin-bottom: 20px; display: block; text-align: center; padding: 15px;}
        .btn-logout:hover { background: rgba(211,47,47,0.1); box-shadow: 0 0 15px rgba(211,47,47,0.3); }

        .booking-input-group { background: var(--input-bg); border: 1px solid var(--border-ui); border-radius: 2px; padding: 25px; transition: 0.3s; display: flex; flex-direction: column; justify-content: center; }
        .booking-input-group:focus-within { border-color: var(--integrity-gold); box-shadow: inset 0 0 10px rgba(197, 160, 89, 0.1); }
        .booking-control { width: 100%; padding: 15px; background: var(--card-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime', monospace; font-size: 1.1rem; font-weight: bold; border-radius: 2px; cursor: pointer; color-scheme: dark light; box-sizing: border-box; }
        .booking-control:focus { outline: none; border-color: var(--integrity-gold); }

        /* 🛑 CLIENT HUB MATRIX: GOSPEL OS + AI SENTINEL */
        .client-matrix-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr; /* Better width distribution */
            gap: 25px;
            margin: 20px auto 40px auto; /* Centers the grid perfectly */
            width: 100%;
            max-width: 1100px; /* Aligns smoothly with the cards below */
            align-items: start;
            box-sizing: border-box;
        }

        .gospel-panel {
            background: #030303;
            border: 1px solid var(--border-ui);
            border-top: 5px solid var(--integrity-gold);
            padding: 30px; /* Reduced from 40px to stop left-edge blowout */
            height: 550px;
            overflow-y: auto;
            overflow-x: hidden; /* CRITICAL: Stops horizontal wash-out */
            font-family: 'Inter', sans-serif;
            color: #ccc;
            box-shadow: 0 10px 25px rgba(0,0,0,0.4); /* Softened the harsh shadow */
            min-width: 0;
            max-width: 100%;
            box-sizing: border-box;
        }

        .gospel-panel h2 { color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; margin-bottom: 5px; }
        .gospel-panel h3 { color: var(--integrity-gold); font-family: 'Courier Prime', monospace; font-size: 1rem; margin-top: 30px; border-bottom: 1px dashed #333; padding-bottom: 10px; }
        .gospel-panel p { line-height: 1.6; font-size: 0.9rem; margin-bottom: 15px; }
        .gospel-highlight { background: #111; border-left: 3px solid var(--integrity-gold); padding: 10px 15px; margin: 15px 0; font-family: 'Courier Prime', monospace; font-size: 0.85rem; color: #fff; }

        .gospel-table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 0.85rem; }
        .gospel-table th { background: #111; color: var(--integrity-gold); text-align: left; padding: 12px; font-family: 'Montserrat', sans-serif; text-transform: uppercase; border-bottom: 2px solid #333; }
        .gospel-table td { padding: 12px; border-bottom: 1px solid #222; vertical-align: top; }
        .gospel-table td:first-child { font-weight: bold; color: #fff; white-space: nowrap; }

        /* 🗺️ INTERACTIVE BLUEPRINT TAB BUTTONS */
        .gospel-tab-container {
            display: flex;
            background: #111;
            border: 1px solid var(--border-ui);
            margin-bottom: 20px;
            border-radius: 2px;
        }
        .gospel-tab-btn {
            flex: 1;
            background: transparent;
            border: none;
            color: #ffffff;
            padding: 15px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            outline: none;
            transition: 0.3s;
            text-align: center;
        }
 /* 🌟 ACCESSIBILITY AUDIT FIXES (Final 10 Points) */
        .gospel-tab-btn {
            color: #E0E0E0; /* High contrast text against dark background */
        }

        [data-theme="light"] .fin-label,
        [data-theme="light"] .gospel-tab-btn.active,
        [data-theme="light"] .tier-display,
        [data-theme="light"] .maturity-stats span,
        [data-theme="light"] .cockpit-left p {
            color: #5C4D00 !important; /* Deep gold/brown for contrast against light grey */
        }

        [data-theme="light"] .text-green,
        [data-theme="light"] .integrity-green,
        [data-theme="light"] [style*="color: var(--integrity-green)"] {
            color: #008546 !important; /* Darker green for visibility on light backgrounds */
        }

        [data-theme="light"] .gospel-tab-btn {
            color: #333333 !important; /* Accessible inactive tab color for light mode */
        }

        .gospel-tab-btn.active {
            background: var(--vault-gray);
            color: var(--integrity-gold);
            box-shadow: inset 0 -3px 0 var(--integrity-gold);
        }

        .roadmap-preamble {
            background: rgba(0, 85, 255, 0.05);
            padding: 20px;
            border-left: 4px solid var(--sanctified-blue);
            border-radius: 2px;
            margin-bottom: 25px;
            font-size: 0.85rem;
            line-height: 1.6;
        }
        .roadmap-phase-card {
            background: #111;
            border: 1px solid var(--border-ui);
            padding: 20px;
            border-radius: 4px;
            margin-bottom: 20px;
        }
        .roadmap-phase-card h4 {
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            margin: 5px 0 10px;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }
        .roadmap-phase-card p {
            font-size: 0.8rem;
            line-height: 1.5;
            margin: 0;
            color: #bbb;
        }

        .ai-assistant-panel {
            background: #000;
            border: 2px solid var(--sanctified-blue);
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0, 85, 255, 0.15);
            position: sticky;
            top: 20px;
            height: 550px;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .ai-header {
            background: var(--sanctified-blue);
            color: white;
            padding: 15px 20px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 900;
            text-transform: uppercase;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--integrity-gold);
        }
        /* Example refinement */
.nav-actions .theme-toggle {
    flex: 1; /* Make them equal width */
    min-height: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    transition: all 0.2s ease;
}

.nav-actions .theme-toggle:active {
    background: #7a66001a;
    transform: scale(0.98);
}
        @media (max-width: 1024px) {
            .cockpit-split { grid-template-columns: 1fr; gap: 30px;}
            .financial-grid { grid-template-columns: 1fr 1fr; }
            .vault-header { flex-direction: column; align-items: flex-start; gap: 15px;}
            .vault-header > div:last-child { text-align: left; }
            .vault-container { padding: 15px 20px 40px; }

            .client-matrix-grid { grid-template-columns: 1fr; }
            .ai-assistant-panel { height: 600px; position: relative; top: 0; }
            .gospel-panel { height: 500px; }
        }

        @media (max-width: 768px) {
            .financial-grid, .scorecard-grid, .maturity-panel, .shield-yield-panel, .credit-tier-grid { grid-template-columns: 1fr; }
            .vault-header h1 { font-size: 2rem; }
            .tier-display { font-size: 2.5rem; }
            .clock-text-main { font-size: 1.8rem; }
            .fin-value { font-size: 1.6rem; }
            .yield-val-text { font-size: 2rem; }
            #display_km { font-size: 2.2rem !important; }
            .shield-yield-panel > div { border: none !important; padding: 0 !important; padding-bottom: 20px !important; border-bottom: 1px dashed var(--border-ui) !important; margin-bottom: 20px !important; text-align: center; }
            .shield-yield-panel > div:last-child { border-bottom: none !important; margin-bottom: 0 !important; padding-bottom: 0 !important; }
            .vial-container-wrapper { flex-direction: column; height: auto !important; gap: 20px; align-items: center; }
            .vial-text-container { padding-left: 0 !important; text-align: center; }
            .vial { height: 150px; }
            .hero-profile { height: 300px; }
            .hero-overlay { flex-direction: column; align-items: flex-start; gap: 15px; padding: 20px; }
            .age-badge { width: 100%; text-align: center; box-sizing: border-box;}
            .brand-box { flex-direction: column; gap: 15px; }
            .theme-toggle { position: static; width: 100%; }
            .ledger-row { grid-template-columns: 1fr; gap: 8px; text-align: center; }
            .ledger-row > div:last-child { text-align: center !important; }
        }

        @media (max-width: 480px) {
            #ignition-chips, .ai-assistant-panel > div:nth-child(3) > div:nth-child(2) {
                padding-bottom: 15px;
            }
            .gospel-panel { padding: 20px; }
        }

        @keyframes urgent-pulse-input {
            0% { box-shadow: 0 0 0 0 rgba(211, 47, 47, 0.7); border-color: var(--critical-red); background-color: rgba(211, 47, 47, 0.15); transform: scale(1); }
            50% { box-shadow: 0 0 20px 10px rgba(211, 47, 47, 0); border-color: var(--integrity-gold); background-color: var(--input-bg); transform: scale(1.02); }
            100% { box-shadow: 0 0 0 0 rgba(211, 47, 47, 0); border-color: var(--critical-red); background-color: rgba(211, 47, 47, 0.15); transform: scale(1); }
        }
        .urgent-input-flash { animation: urgent-pulse-input 0.6s 5; }

        .covenant-modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(4px); }
        .covenant-modal-box { background: #0a0f14; border: 2px solid var(--integrity-gold); border-radius: 8px; width: 90%; max-width: 500px; padding: 30px; box-shadow: 0 0 20px rgba(197, 160, 89, 0.2); color: #fff; max-height: 80vh; overflow-y: auto; }
        .covenant-title { color: var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-size: 1.5rem; text-transform: uppercase; margin-top: 0; border-bottom: 1px solid #333; padding-bottom: 10px; }
        .covenant-text { font-family: 'Courier Prime', monospace; font-size: 0.9rem; line-height: 1.6; color: #ccc; }
        .covenant-tier { background: #111; padding: 10px; margin-top: 10px; border-left: 3px solid var(--integrity-gold); }
        .btn-understand { width: 100%; background: var(--integrity-gold); color: #000; border: none; padding: 15px; font-family: 'Montserrat', sans-serif; font-weight: 900; margin-top: 20px; cursor: pointer; text-transform: uppercase; border-radius: 4px; transition: 0.3s; }
        .btn-understand:hover { background: #b38b47; }

        .rosetta-sub { display: block; font-family: 'Inter', sans-serif; font-size: 0.75rem; color: #888; text-transform: none; font-weight: normal; margin-top: 5px; letter-spacing: 0; }
        body[data-rosetta="off"] .rosetta-sub { display: none; }

        .gospel-tooltip { position: relative; display: inline-block; cursor: help; border-bottom: 1px dotted #888; }
        .gospel-tooltip .tooltip-text { visibility: hidden; width: 240px; background-color: #111; color: #e0e0e0; text-align: center; border-radius: 4px; padding: 10px 12px; position: absolute; z-index: 100; bottom: 130%; left: 50%; margin-left: -120px; opacity: 0; transition: opacity 0.2s ease-in-out; font-size: 0.85rem; font-weight: normal; border: 1px solid #333; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5); text-transform: none; line-height: 1.4; }
        .gospel-tooltip .tooltip-text::after { content: ""; position: absolute; top: 100%; left: 50%; margin-left: -6px; border-width: 6px; border-style: solid; border-color: #111 transparent transparent transparent; }
        .gospel-tooltip:hover .tooltip-text { visibility: visible; opacity: 1; }

        #ignition-chips::-webkit-scrollbar { display: none; }
        #ignition-chips { -ms-overflow-style: none; scrollbar-width: none; }

        /* Centered Professional Layout Fix */
        .cockpit-split { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40px; width: 100%; max-width: 950px; margin: 0 auto; box-sizing: border-box; }

       /* =========================================
   PERFECT SCORE: STICKY NAV ENGINE
