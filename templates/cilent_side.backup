</head>
<body class="p-4 md:p-8">
    <main id="main-content">
        <div id="asset-config"
             data-id="{{ r.id if r is defined else 0 }}"
             data-base-odometer="{{ r.base_mileage | default(0) | int if r is defined else 0 }}"
             style="display:none;">
        </div>
        {% set chrono_months = ((days_active | default(0)) / 30) | int %}

        <div id="gospel-toast" class="gospel-toast"></div>

        {% with messages = get_flashed_messages(with_categories=true) %}
          {% if messages %}
            <div class="flash-container" style="position: fixed; top: 0; width: 100%; z-index: 10000;">
            {% for category, message in messages %}
              <div style="background: {% if category == 'error' %}var(--critical-red){% else %}var(--integrity-green){% endif %}; color: #fff; text-align: center; padding: 15px; font-family: 'Montserrat'; font-weight: 900; text-transform: uppercase; letter-spacing: 2px;">{{ message }}</div>
            {% endfor %}
            </div>
          {% endif %}
        {% endwith %}
<div class="vault-container">
    <nav class="sticky-nav-wrapper">
        <div class="logo-container">
            <img src="{{ url_for('static', filename='Laveto_logo-01.png') }}" alt="Laveto System Restoration">
        </div>

        <div class="nav-actions">
            <button class="theme-toggle btn-gold" onclick="toggleRosetta()">
                <span>💬</span> TRANSLATE
            </button>
            <button class="theme-toggle" onclick="toggleVaultTheme()">
                <span>🌓</span> INTERFACE
            </button>
            <a href="#" class="theme-toggle btn-red">
                <span>⏏️</span> EGRESS
            </a>
        </div>
    </nav>
</div>

            <!-- CONTRACTUAL STATUS (Moved OUT of sticky wrapper so it scrolls away naturally) -->
            <div style="position: relative; max-width: 1400px; margin: 0 auto; margin-bottom: 30px; margin-top: 20px;">
                <div style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #000; border: 1px solid var(--integrity-gold); color: var(--integrity-gold); padding: 4px 20px; border-radius: 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.85rem; letter-spacing: 3px; z-index: 10; text-transform: uppercase; box-shadow: 0 0 15px rgba(197, 160, 89, 0.4);">
                    CLASS {{ r.vehicle_class | default('UNASSIGNED') }}
                </div>

                <div class="integrity-panel" style="border: 1px solid var(--integrity-gold); padding: 35px 20px 20px 20px; text-align: center; background: linear-gradient(145deg, var(--card-bg) 0%, rgba(197, 160, 89, 0.03) 100%); border-radius: 2px;">
                    <div style="font-family: 'Courier Prime'; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 10px;">Contractual Status</div>

                    {% if status == 'WARNING' %}
                        <h3 style="color: var(--warning-orange); font-family: 'Montserrat'; font-size: 1.1rem; margin: 10px 0;">ACTION REQUIRED: REPAYMENT WINDOW OPEN</h3>
                        <p style="font-size: 0.8rem; color: var(--text-main);">Your loan maturation is due in {{ days }} days. Maintain your sovereign standing by initiating a clearance.</p>
                        <a href="{{ url_for('hangar.initiate_repayment') }}" class="btn-touch" style="background: var(--integrity-gold); color: #000; padding: 12px 25px; display: inline-block; text-decoration: none; font-weight: 900; font-family: 'Montserrat'; border-radius: 2px; text-transform: uppercase;">CLEAR DEBT / MAINTAIN UPLINK</a>

                    {% elif status == 'CRITICAL' %}
                        <h3 style="color: var(--critical-red); font-family: 'Montserrat'; font-size: 1.1rem; margin: 10px 0;">SYSTEM LOCKOUT IMMINENT</h3>
                        <p style="font-size: 0.8rem; color: var(--text-main);">Your account has breached the maturation threshold. Please contact Command immediately to restore your UPLINK.</p>

                    {% else %}
                        <h3 style="color: var(--integrity-green); font-family: 'Montserrat'; font-size: 1.1rem; margin: 10px 0;">CONTRACTUAL INTEGRITY: OPTIMAL</h3>
                        <p style="font-size: 0.8rem; color: var(--text-muted);">All systems nominal. No repayment actions required at this time.</p>
                    {% endif %}
                </div>
            </div>
            <a href="javascript:void(0)" onclick="openVideoGuide()" class="btn-urgent-action" style="background: linear-gradient(90deg, var(--sanctified-blue), #001a33); border-color: var(--integrity-gold);">
                💡 PILOT ORIENTATION: WATCH THE SOVEREIGN OS GUIDE
                <span class="click-badge">WATCH VIDEO ➡</span>
            </a>

           <!-- 🛑 CLIENT HUB MATRIX: GOSPEL OS + AI SENTINEL -->
        <div class="client-matrix-grid">

            <!-- 🟢 GOSPEL PANEL -->
            <div class="gospel-panel" style="border-top: 5px solid var(--integrity-gold);">
                <div class="gospel-tab-container">
                    <button type="button" id="tab-link-doctrine" class="gospel-tab-btn active" onclick="switchGospelTab('doctrine')">📜 The Gospel Doctrine</button>
                    <button type="button" id="tab-link-roadmap" class="gospel-tab-btn" onclick="switchGospelTab('roadmap')">🗺️ The Sanctification Roadmap</button>
