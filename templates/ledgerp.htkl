{% extends "base.html" %}

{% block content %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div id="dashboard-wrapper">

<style>
    :root {
        --sanctified-blue: #003366; --integrity-gold: #C5A059; --integrity-green: #28a745;
        --critical-red: #ff0000; --whatsapp-green: #25D366; --bg-main: #0a0a0a;
        --text-main: #F9F9F9; --card-bg: #1a1a1a; --border-ui: #333333; --panel-bg: #000000;
        --table-bg: #111111; --table-header: #222222; --input-bg: #000000; --log-bg: #000000;
        --gold-text: #C5A059; --text-muted: #888888; --stat-bg-1: #003366;
        --stat-bg-2: #111111; --stat-bg-3: #051505;
    }
    [data-theme="light"] {
        --bg-main: #f8f9fa; --text-main: #1a1a1a; --card-bg: #ffffff; --border-ui: #dddddd;
        --panel-bg: #ffffff; --table-bg: #ffffff; --table-header: #f1f1f1;
        --input-bg: #ffffff; --log-bg: #fafafa; --gold-text: #a8823a;
        --text-muted: #555555; --stat-bg-1: #ffffff; --stat-bg-2: #ffffff; --stat-bg-3: #ffffff;
    }

    .interaction-node { pointer-events: auto !important; position: relative !important; z-index: 9999 !important; }

    @media print {
        .dashboard-header, .controls-bar, .carouselControls, .secure-modal, .action-btn-row, .btn-ribbon, .modal-overlay { display: none !important; }
        #dashboard-wrapper { display: block !important; margin: 0 !important; padding: 0 !important; }
    }

    /* Ledger Trigger Interaction */
    .ledger-trigger {
        position: relative !important;
        z-index: 999999 !important;
        pointer-events: auto !important;
        cursor: pointer !important;
        display: inline-block !important;
        background: transparent !important;
        padding: 10px 5px !important;
    }

    .action-btn-row {
        position: relative;
        z-index: 9999;
        pointer-events: auto !important;
    }

    /* Core Components */
    body { background-color: var(--bg-main); color: var(--text-main); transition: 0.4s ease; }
    .dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid var(--sanctified-blue); padding-bottom: 10px; position: relative; z-index: 1000; }
    .camera-trigger { display: block; background: var(--input-bg); border: 1px solid var(--sanctified-blue); color: var(--sanctified-blue); padding: 10px; border-radius: 2px; text-align: center; font-size: 0.6rem; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: 0.3s; margin-bottom: 5px; width: 100%; box-sizing: border-box; }
    .camera-trigger:hover { background: var(--sanctified-blue); color: white; }
    .camera-trigger.active { border-color: var(--integrity-green) !important; color: var(--integrity-green) !important; background: rgba(40, 167, 69, 0.05); }
    .velocity-card { background: linear-gradient(145deg, var(--card-bg), var(--panel-bg)); border: 1px solid var(--border-ui); border-radius: 2px; padding: 40px; margin-bottom: 30px; display: grid; grid-template-columns: 1fr 2px 1.5fr; align-items: center; gap: 40px; }
    .velocity-left { text-align: left; border-left: 5px solid var(--integrity-gold); padding-left: 25px; }
    .velocity-divider { background: var(--border-ui); height: 80%; width: 2px; }
    .velocity-right { display: flex; flex-direction: column; justify-content: center; width: 100%; }
    .trinity-bar-wrapper { display: flex; justify-content: space-between; align-items: flex-end; height: 120px; gap: 20px; }
    .bar-segment { flex: 1; display: flex; flex-direction: column; align-items: center; }
    .bar-fill { width: 100%; border-radius: 2px 2px 0 0; transition: height 1s ease-out; min-height: 8px; }
    .bar-label { font-family: 'Courier Prime', monospace; font-size: 0.65rem; color: var(--text-muted); margin-top: 12px; font-weight: bold; letter-spacing: 1px; }
    .bg-tvl { background-color: var(--sanctified-blue); } .bg-debt { background-color: var(--critical-red); } .bg-saas { background-color: var(--integrity-green); }
    .theme-toggle-command { background: transparent; border: 1px solid var(--integrity-gold); color: var(--gold-text); padding: 8px 15px; border-radius: 2px; font-size: 0.7rem; font-weight: bold; cursor: pointer; text-transform: uppercase; font-family: 'Montserrat', sans-serif; transition: 0.3s; height: fit-content; }
    .theme-toggle-command:hover { background: var(--integrity-gold); color: black; }
    .stat-box { background: var(--stat-bg-1); color: var(--text-main); padding: 15px; border-radius: 2px; text-align: center; flex: 1; margin: 0 10px; border: 1px solid var(--border-ui); }
    .stat-value { font-size: 1.5rem; font-weight: bold; font-family: 'Courier Prime', monospace; font-variant-numeric: tabular-nums; letter-spacing: -0.5px; }
    .yield-engine-panel { background: var(--panel-bg); border: 2px solid var(--integrity-green); padding: 25px; border-radius: 2px; margin-bottom: 30px; position: relative; overflow: hidden; box-sizing: border-box; width: 100%; }
    @keyframes sentinel-pulse { 0% { box-shadow: 0 0 0 0 rgba(0, 51, 102, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(0, 51, 102, 0); } 100% { box-shadow: 0 0 0 0 rgba(0, 51, 102, 0); } }
    .sentinel-orb { width: 12px; height: 12px; background-color: var(--sanctified-blue); border-radius: 50%; display: inline-block; margin-right: 8px; animation: sentinel-pulse 2s infinite; }
    .action-panel { display: none; margin-top: 10px; background: var(--panel-bg); padding: 15px; border-radius: 2px; border: 1px solid var(--integrity-gold); color: var(--text-main); max-height: 380px; overflow-y: auto; box-sizing: border-box; }
    .action-panel::-webkit-scrollbar { width: 4px; }
    .action-panel::-webkit-scrollbar-thumb { background: var(--integrity-gold); border-radius: 2px; }
    .edit-input { width: 100%; padding: 6px; margin-bottom: 5px; background: var(--input-bg); border: 1px solid var(--border-ui); color: var(--text-main); font-family: 'Courier Prime', monospace; font-size: 0.7rem; box-sizing: border-box; border-radius: 2px; }
    @keyframes critical-blink { 0% { background: var(--critical-red); } 50% { background: #8B0000; } 100% { background: var(--critical-red); } }
    .inert-tag { background: var(--critical-red); color: white; padding: 2px 6px; border-radius: 2px; font-size: 0.6rem; font-weight: 900; margin-left: 10px; animation: critical-blink 2s infinite; }
    .projection-panel { background: var(--panel-bg); color: var(--text-main); padding: 25px; border-radius: 2px; margin-bottom: 30px; border-left: 10px solid var(--integrity-gold); border-top: 1px solid var(--border-ui); border-right: 1px solid var(--border-ui); border-bottom: 1px solid var(--border-ui); font-family: 'Montserrat', sans-serif; box-sizing: border-box; width: 100%; }
    .projection-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 15px; }
    .projection-stat h4 { color: var(--text-muted); font-size: 0.65rem; margin: 0; text-transform: uppercase; letter-spacing: 2px; }
    .projection-stat div { font-family: 'Courier Prime'; font-size: 1.6rem; font-weight: bold; color: var(--text-main); margin-top: 5px; font-variant-numeric: tabular-nums; letter-spacing: -0.5px; }
    .progress-track { width: 100%; height: 8px; background: var(--panel-bg); border-radius: 2px; margin-top: 20px; overflow: hidden; border: 1px solid var(--border-ui); }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--integrity-gold), var(--text-main)); transition: 1s ease-out; }
    .market-controller { margin-top: 15px; padding-top: 15px; border-top: 1px solid var(--border-ui); }
    .price-input { padding: 8px; border: 1px solid var(--border-ui); border-radius: 2px; width: 100%; font-family: 'Courier Prime'; font-weight: bold; margin-bottom: 5px; background: var(--input-bg); color: var(--text-main); box-sizing: border-box; }
    .mini-log-container { background: var(--log-bg); border: 1px solid var(--border-ui); border-radius: 2px; margin-top: 15px; max-height: 120px; overflow-y: auto; font-size: 0.65rem; font-family: 'Inter', sans-serif; }
    .mini-log-row { display: grid; grid-template-columns: 60px 1fr 60px; gap: 10px; padding: 6px 10px; border-bottom: 1px solid var(--border-ui); }

    /* Carousel Interactivity Layout Anchors */
    .asset-card { background: var(--card-bg); border: 1px solid var(--border-ui); border-radius: 4px; margin-bottom: 30px; padding: 25px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2); box-sizing: border-box; width: 100%; display: none; }
    .asset-card.is-active { display: block !important; }

    .secure-modal { display: none; position: fixed; z-index: 20000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.90); align-items: center; justify-content: center; backdrop-filter: blur(4px); }
    .modal-content-box { background: var(--panel-bg); border: 2px solid var(--integrity-gold); padding: 40px; border-radius: 4px; max-width: 600px; width: 90%; color: var(--text-main); position: relative; box-shadow: 0 0 30px rgba(197, 160, 89, 0.15); max-height: 90vh; overflow-y: auto; }
    .modal-close-btn { position: absolute; top: 15px; right: 15px; background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); cursor: pointer; padding: 5px 10px; font-weight: 900; border-radius: 2px; font-family: 'Montserrat', sans-serif; transition: 0.3s; }
    .modal-close-btn:hover { background: var(--critical-red); color: white; }
    .airlock-queue-panel { background: var(--panel-bg); border: 1px solid var(--border-ui); border-left: 5px solid var(--integrity-gold); padding: 25px; border-radius: 2px; margin-bottom: 30px; box-sizing: border-box; width: 100%; }
    .airlock-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .airlock-table th { background: var(--table-header); color: var(--text-muted); font-family: 'Montserrat'; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; padding: 12px; text-align: left; }
    .airlock-table td { padding: 12px; border-bottom: 1px solid var(--border-ui); font-family: 'Courier Prime'; font-size: 0.85rem; }
    .intent-tag { padding: 4px 8px; border-radius: 2px; font-size: 0.7rem; font-weight: bold; font-family: 'Montserrat'; text-transform: uppercase; }
    .intent-ROUTINE { background: rgba(40, 167, 69, 0.1); color: var(--integrity-green); border: 1px solid var(--integrity-green); }
    .intent-EMERGENCY { background: rgba(255, 0, 0, 0.1); color: var(--critical-red); border: 1px solid var(--critical-red); animation: sentinel-pulse 2s infinite; }
    .triage-ribbon { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 15px; align-items: center; }
    .btn-ribbon { background: var(--panel-bg); border: 1px solid var(--border-ui); color: var(--text-muted); padding: 8px 15px; border-radius: 2px; cursor: pointer; font-family: 'Montserrat', sans-serif; font-size: 0.7rem; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ribbon:hover { border-color: var(--integrity-gold); color: var(--gold-text); }
    .btn-ribbon.active { background: rgba(197, 160, 89, 0.1); border-color: var(--integrity-gold); color: var(--gold-text); }
    .btn-action-required { background: rgba(255, 0, 0, 0.1); border: 1px solid var(--critical-red); color: var(--critical-red); }
    .btn-action-required:hover { background: var(--critical-red); color: white; }
    .btn-action-required.active { background: var(--critical-red); color: white; box-shadow: 0 0 15px rgba(255,0,0,0.5); }
    .escrow-locked-badge { display: inline-block; background-color: rgba(197, 160, 89, 0.15); border: 1px solid var(--integrity-gold); color: var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.65rem; letter-spacing: 1px; text-transform: uppercase; padding: 4px 8px; border-radius: 2px; margin-top: 5px; box-shadow: 0 0 10px rgba(197, 160, 89, 0.2); }
    .secure-file-card { width: 120px; height: 80px; background: var(--input-bg); border: 1px solid var(--border-ui); border-radius: 4px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s; text-decoration: none; color: var(--gold-text); font-family: 'Courier Prime', monospace; }
    .secure-file-icon { font-size: 1.5rem; margin-bottom: 8px; }
    .secure-file-text { font-size: 0.6rem; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;}
    .hangar-grid { max-width: 100%; margin: 0 auto; padding: 0; display: grid; grid-template-columns: 2.5fr 1fr; gap: 30px; }
    .main-column { display: flex; flex-direction: column; gap: 30px; }
    .sidebar { display: flex; flex-direction: column; gap: 30px; position: sticky; top: 20px; height: fit-content; }
    .vam-class-header { font-family: 'Montserrat', sans-serif; font-weight: 900; margin-bottom: 8px; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; }
    .vam-text { font-size: 0.8rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 5px; font-family: 'Inter', sans-serif; }
    .queue-header { font-family: 'Courier Prime', monospace; font-size: 1.2rem; font-weight: 900; color: var(--integrity-gold); margin-bottom: 20px; letter-spacing: 2px; text-align: center; border-bottom: 1px solid var(--border-ui); padding-bottom: 15px; }
    .queue-card { background: rgba(0, 51, 102, 0.1); border: 1px solid var(--sanctified-blue); padding: 25px; border-radius: 4px; margin-bottom: 20px; }
    .queue-data { display: grid; grid-template-columns: 1fr; gap: 10px; font-size: 0.85rem; font-family: 'Inter', sans-serif; }
    .queue-data strong { color: var(--text-muted); }
    .queue-data span { color: var(--text-main); font-weight: 600; font-family: 'Courier Prime', monospace; }
    .btn-grade { display: block; text-align: center; padding: 15px; margin-top: 20px; border: 1px solid var(--integrity-gold); color: var(--integrity-gold); text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 900; border-radius: 4px; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; }
    .btn-grade:hover { background: var(--integrity-gold); color: black; }
    .btn-approve { display: block; width: 100%; text-align: center; padding: 15px; margin-top: 15px; background: var(--integrity-green); color: white; border: none; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 900; border-radius: 4px; transition: 0.3s; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; }
    .btn-approve:hover { background: #1e7e34; box-shadow: 0 0 15px rgba(40, 167, 69, 0.4); }
    .scroll-hide::-webkit-scrollbar { height: 4px; width: 4px; }
    .scroll-hide::-webkit-scrollbar-thumb { background: var(--border-ui); border-radius: 2px; }
    @media (max-width: 1024px) { .hangar-grid { grid-template-columns: 1fr; } .sidebar { position: relative; top: 0; } }
</style>


<div class="dashboard-header" style="background: var(--card-bg); border: 1px solid var(--border-ui); border-left: 5px solid var(--integrity-gold); padding: 15px 25px; border-radius: 2px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; box-sizing: border-box; width: 100%;">
    <div style="display: flex; flex-direction: column;">
        <span style="font-family: 'Courier Prime', monospace; font-size: 0.65rem; color: var(--text-muted); letter-spacing: 3px; text-transform: uppercase;">Laveto Internal // Admin Hub</span>
        <h2 style="color: var(--text-main); margin: 5px 0 0 0; font-family: 'Montserrat', sans-serif; font-size: 1.4rem; font-weight: 900; letter-spacing: 2px; text-transform: uppercase;">ADMIN <span style="color: var(--gold-text);">// DASHBOARD</span></h2>
    </div>
  <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
    {% set total_unhealthy = (quarantine_count or 0) + (liquidation_requests or 0) + (loan_notifications or 0) + (compliance_requests or 0) %}
    <a href="?filter=ACTION_REQUIRED" style="background: var(--critical-red); color: white; border: 1px solid var(--critical-red); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase; transition: 0.3s; box-shadow: 0 0 15px rgba(255,0,0,0.4);">🚧 FAILED INSPECTIONS ({% if quarantine_count %}{{ quarantine_count }}{% else %}0{% endif %})</a>
    <a href="{{ url_for('hangar.registry') }}" style="background: var(--integrity-gold); color: black; padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase;">📋 REGISTRY</a>
    <a href="{{ url_for('hangar.silk_road') }}" style="background: var(--panel-bg); border: 1px solid var(--integrity-gold); color: var(--gold-text); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase; transition: 0.3s;">🌍 PROCUREMENT</a>
    <a href="{{ url_for('hangar.open_bay_01') }}" style="background: var(--integrity-green); color: white; border: 1px solid var(--integrity-green); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: 900; font-size: 0.7rem; text-transform: uppercase; transition: 0.3s; box-shadow: 0 0 10px rgba(40, 167, 69, 0.4);">🔧 OPEN BAY 01</a>
    <a href="{{ url_for('hangar.corporate_treasury') }}" style="background: var(--panel-bg); border: 1px solid var(--border-ui); color: var(--text-main); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase; transition: 0.3s;">💰 TREASURY</a>
    <a href="{{ url_for('hangar.settings') }}" style="background: var(--panel-bg); border: 1px solid var(--border-ui); color: var(--text-muted); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase;">⚙️ SETTINGS</a>
    <a href="{{ url_for('hangar.payroll_matrix') }}" style="background: var(--input-bg); border: 1px solid var(--whatsapp-green); color: var(--whatsapp-green); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase; transition: 0.3s;">🏢 B2B PAYROLL</a>
    <a href="{{ url_for('hangar.audit_logs') }}" style="background: var(--panel-bg); border: 1px solid var(--border-ui); color: var(--text-main); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.7rem; text-transform: uppercase;">📜 LOGS</a>
   <button onclick="var m=document.getElementById('armoryModal'); if(m){m.style.display='flex';} else {alert('Scripts Module Offline');}" style="background: transparent; border: 2px solid var(--text-main); color: var(--text-main); padding: 8px 15px; border-radius: 2px; cursor: pointer; font-weight: bold; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">📜 SCRIPTS</button>

<button onclick="var m=document.getElementById('masterKeyModal'); if(m){m.style.display='flex';} else {alert('Admin PIN Module Offline');}" style="background: transparent; border: 2px solid var(--integrity-gold); color: var(--gold-text); padding: 8px 15px; border-radius: 2px; cursor: pointer; font-weight: bold; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">🔑 ADMIN PIN</button>

<button onclick="var m=document.getElementById('sopModal'); if(m){m.style.display='flex';} else {alert('Photo SOP Module Offline');}" style="background: transparent; border: 2px dashed var(--integrity-gold); color: var(--gold-text); padding: 8px 15px; border-radius: 2px; cursor: pointer; font-weight: bold; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">📸 PHOTO SOP</button>
    <a href="{{ url_for('hangar.debug_env') }}" style="background: {% if bleeding_count and bleeding_count > 0 %}var(--critical-red){% else %}var(--input-bg){% endif %}; color: {% if bleeding_count and bleeding_count > 0 %}white{% else %}var(--integrity-green){% endif %}; border: 1px solid {% if bleeding_count and bleeding_count > 0 %}var(--critical-red){% else %}var(--integrity-green){% endif %}; padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: 900; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; font-family: 'Courier Prime', monospace; transition: 0.3s; {% if bleeding_count and bleeding_count > 0 %} animation: severe-strobe 1s infinite; box-shadow: 0 0 20px rgba(255,0,0,0.6); {% endif %}">
    🛰️ SYSTEM HEALTH {% if bleeding_count and bleeding_count > 0 %}({{ bleeding_count }} ALERTS){% endif %}
    </a>
    <a href="{{ url_for('hangar.loan_terminal') }}" style="background: var(--sanctified-blue); color: white; border: 1px solid var(--sanctified-blue); padding: 8px 15px; border-radius: 2px; text-decoration: none; font-weight: bold; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">🏦 LOANS</a>
    <button onclick="toggleTheme()" id="themeToggleBtn" class="theme-toggle-command">☀️ LIGHT MODE</button>
  </div>
</div>

{% set ns_treasury = namespace(shield_total=0, sovereign_total=0) %}
{% for r in all_records %}
    {% set shield = (r.shield_reservoir or 0) | float %}
    {% set sovereign = (r.savings_balance or 0) | float %}

    {% set ns_treasury.shield_total = ns_treasury.shield_total + shield %}
    {% set ns_treasury.sovereign_total = ns_treasury.sovereign_total + sovereign %}
{% endfor %}

<div style="box-sizing: border-box; width: 100%; border: 2px solid var(--critical-red); padding: 20px; background: rgba(255,0,0,0.05); margin-bottom: 30px; border-radius: 4px; overflow-wrap: break-word; overflow-x: hidden;">
    <h2 style="color: var(--critical-red); margin-top: 0; font-family: 'Courier Prime', monospace; letter-spacing: 2px;">⚠️ TRIAGE ALERT: CRITICAL ASSETS DETECTED</h2>

    {% set ns_radar = namespace(critical_found=false) %}

    {% for r in all_records %}
        {% set safe_status = (r.current_status or '') | upper %}

        {% if (r.pending_loan_amount and r.pending_loan_amount > 0) or 'MAYDAY' in safe_status or (r.health_score and r.health_score <= 20) %}
            {% set ns_radar.critical_found = true %}

            <div style="border-top: 1px solid rgba(255, 77, 77, 0.3); padding-top: 15px; margin-top: 15px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px;">
                <div style="flex: 1; min-width: 250px;">
                    <h3 style="margin: 0; color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 1.2rem;">{{ r.vin_dna }}</h3>
                    <div style="font-size: 0.7rem; color: var(--text-main); font-family: 'Montserrat'; font-weight: bold; margin-bottom: 5px;">{{ r.member_name or 'UNKNOWN CLIENT' }} | 📞 {{ r.member_phone or 'NO PHONE' }}</div>

                    {% if r.pending_loan_amount and r.pending_loan_amount > 0 %}
                        <div style="color: var(--critical-red); font-weight: bold; font-size: 0.9rem; margin-top: 5px; text-transform: uppercase;">LOAN REQUISITION: P{{ "{:,.2f}".format(r.pending_loan_amount or 0) }}</div>
                    {% endif %}

                    {% if 'MAYDAY' in safe_status or (r.health_score and r.health_score <= 20) %}
                        <div style="color: var(--critical-red); font-weight: 900; font-size: 1rem; margin-top: 5px; animation: pulse-text 1.5s infinite;">🚨 MAYDAY BEACON FIRED</div>
                    {% endif %}

                    <div style="margin-top: 10px;">
                        {% if r.latitude and r.longitude %}
                            <a href="https://www.google.com/maps/search/?api=1&query={{ r.latitude }},{{ r.longitude }}" target="_blank" style="color: #fff; background: #dc3545; padding: 8px 12px; border-radius: 2px; text-decoration: none; font-size: 0.7rem; font-weight: bold;">📍 VIEW LOCATION ON MAP</a>
                        {% else %}
                            <div style="color: #ff3333; font-size: 0.7rem; font-family: monospace;">
                                AWAITING TELEMETRY...<br>
                                [DEBUG: Lat="{{ r.latitude }}", Lon="{{ r.longitude }}"]
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px; min-width: 200px;">
                    <a href="?search={{ r.vin_dna }}" style="text-align: center; color: white; background: var(--critical-red); padding: 10px; border-radius: 2px; text-decoration: none; font-weight: 900; font-family: 'Montserrat', sans-serif; font-size: 0.75rem;">👁️ OPEN VAULT</a>

                    {% if 'MAYDAY' in safe_status %}
                        {% set clean_phone = r.member_phone|replace(' ', '')|replace('+', '') if r.member_phone else '' %}
                        <a href="https://wa.me/{{ clean_phone }}?text=%F0%9F%9A%A8%20*LAVETO%20COMMAND%3A*%20Mayday%20Beacon%20Acknowledged." target="_blank" style="text-decoration: underline; color: #888; {% if not r.member_phone %} pointer-events: none; opacity: 0.5; {% endif %}">Ping Member</a>

                        {% set clean_phone = r.member_phone|replace(' ', '')|replace('+', '') if r.member_phone else '' %}
                        {% set maps_link = "https://www.google.com/maps/search/?api=1&query=" ~ r.latitude ~ "," ~ r.longitude %}
                        {% set raw_text = "🚨 *LAVETO COMMAND DISPATCH* 🚨\n\n*TARGET VIN:* " ~ r.vin_dna ~ "\n*CLIENT:* " ~ r.member_name ~ "\n\n📍 *ACQUIRED TARGET LOCATION:*\n" ~ maps_link ~ "\n\nAgent scrambled to these coordinates. Please secure the perimeter." %}
                        {% set dossier_text = raw_text | urlencode %}

                        <form action="{{ url_for('hangar.dispatch_agent') }}" method="POST" style="margin: 0;" id="dispatchForm_{{ r.id }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="entry_id" value="{{ r.id }}">
                            <input type="hidden" id="wa_text_{{ r.id }}" value="🚨 *LAVETO COMMAND DISPATCH* 🚨%0A%0A*TARGET VIN:* {{ r.vin_dna }}%0A*CLIENT:* {{ r.member_name }}%0A%0A📍 *ACQUIRED TARGET LOCATION:*%0Ahttps://maps.google.com/?q={{ r.latitude }},{{ r.longitude }}%0A%0AAgent scrambled to these coordinates. Please secure the perimeter.">

                            <div style="background: rgba(0, 255, 0, 0.05); border: 1px solid var(--integrity-green); padding: 12px; border-radius: 4px; text-align: left; margin-top: 15px;">
                                <div style="font-size: 0.7rem; color: var(--integrity-green); font-weight: 900; margin-bottom: 8px; font-family: 'Courier Prime', monospace;">
                                    📡 FIELD AGENT HANDOFF:
                                </div>
                                <input type="text" id="wa_num_{{ r.id }}" value="267" placeholder="Enter Agent WA Number" style="width: 100%; box-sizing: border-box; padding: 10px; background: #0a0a0a; border: 1px solid var(--integrity-green); color: #fff; margin-bottom: 12px; font-family: monospace; font-size: 1rem;">
                                <button type="button" onclick="
                                    var phone = document.getElementById('wa_num_{{ r.id }}').value.replace(/[^0-9]/g, '');
                                    if (phone.length < 8) { alert('🚨 ERROR: Enter a valid Agent WhatsApp number.'); return; }
                                    var payload = document.getElementById('wa_text_{{ r.id }}').value;
                                    window.open('https://wa.me/' + phone + '?text=' + payload, '_blank');
                                    var form = document.getElementById('dispatchForm_{{ r.id }}');
                                    setTimeout(function(){ form.submit(); }, 800);
                                " style="width: 100%; color: var(--integrity-green); background: transparent; border: 1px solid var(--integrity-green); padding: 12px; border-radius: 2px; font-weight: 900; font-family: 'Montserrat', sans-serif; font-size: 0.8rem; cursor: pointer; transition: 0.3s;"
                                onmouseover="this.style.background='var(--integrity-green)'; this.style.color='black';"
                                onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-green)';"
                                >
                                    🕵️‍♂️ DISPATCH AGENT & RESOLVE
                                </button>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    {% endfor %}
</div>

{% if not ns_radar.critical_found %}
    <div style="color: var(--integrity-green); font-family: 'Courier Prime', monospace; text-align: center; margin-top: 15px;">[ ALL SOVEREIGN ASSETS STABLE. NO TRIAGE REQUIRED. ]</div>
{% endif %}

<form action="{{ url_for('hangar.launch_flare') }}" method="POST" id="flareForm">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <button type="submit" style="background:none; border:none; cursor:pointer; color:var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.8rem; letter-spacing: 1px;">
        🚨 LOST SOVEREIGN KEY? LAUNCH A PRIORITY FLARE
    </button>
</form>

{% if priority_flares %}
    <div style="background: rgba(255, 0, 0, 0.05); border: 2px solid var(--critical-red); padding: 25px; margin-top: 30px; margin-bottom: 30px; border-radius: 4px; box-shadow: 0 0 20px rgba(255, 0, 0, 0.2);">
        <div style="font-family: 'Courier Prime', monospace; font-size: 1.2rem; font-weight: 900; color: var(--critical-red); margin-bottom: 20px; letter-spacing: 2px; text-align: center; border-bottom: 1px dashed var(--critical-red); padding-bottom: 15px;">
            🚨 INCOMING PRIORITY FLARES DETECTED
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 20px;">
            {% for flare in priority_flares %}
                {% set ns_flare = namespace(key='UNVERIFIED', member='UNKNOWN', phone='') %}
                {% set safe_flare_vin = (flare.vin_dna|string|trim|upper) %}

                {% for r in all_records %}
                    {% set safe_r_vin = (r.vin_dna|string|trim|upper) %}
                    {% if safe_r_vin == safe_flare_vin and safe_flare_vin != 'NONE' and safe_flare_vin != '' %}
                        {% set ns_flare.key = r.sovereign_key %}
                        {% set ns_flare.member = r.member_name %}
                        {% set ns_flare.phone = r.member_phone %}
                    {% endif %}
                {% endfor %}

                <div style="background: var(--panel-bg); border-left: 4px solid var(--critical-red); padding: 20px; border-radius: 2px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);">
                    <div style="font-family: 'Courier Prime', monospace; font-size: 0.8rem; color: var(--text-main); line-height: 1.5; margin-bottom: 10px;">{{ flare.action }}</div>
                    <div style="font-size: 0.65rem; color: var(--text-muted); font-family: 'Courier Prime'; margin-bottom: 15px;">
                        TIMESTAMP: {{ flare.timestamp.strftime('%Y-%m-%d %H:%M:%S') if flare.timestamp else 'UNKNOWN' }}<br>
                        TARGET VIN: <span style="color: var(--gold-text); font-weight: bold;">{{ flare.vin_dna or 'MISSING' }}</span>
                    </div>

                    {% if ns_flare.key != 'UNVERIFIED' %}
                        <div style="background: rgba(197, 160, 89, 0.05); border: 1px solid var(--integrity-gold); padding: 12px; margin-bottom: 15px; border-radius: 2px; text-align: center;">
                            <div style="font-size: 0.6rem; color: var(--gold-text); text-transform: uppercase; font-family: 'Montserrat', sans-serif; letter-spacing: 1px; margin-bottom: 5px;">RECOVERED SOVEREIGN KEY</div>
                            <div style="font-family: 'Courier Prime', monospace; font-size: 1.4rem; font-weight: bold; color: var(--text-main); letter-spacing: 3px;">{{ ns_flare.key }}</div>
                        </div>
                        <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                            {% set clean_phone = ns_flare.phone|replace(' ', '')|replace('+', '') if ns_flare.phone else '' %}
                            {% set wa_text = "🛡️ *LAVETO SYSTEM RESTORATION*\n\nPriority Flare Acknowledged, " ~ ns_flare.member ~ ".\n\nYour recovered Sovereign Key for VIN [" ~ safe_flare_vin ~ "] is:\n*" ~ ns_flare.key ~ "*\n\nPlease store this securely. Access your vault at: https://www.laveto.net" %}
                            <a href="https://wa.me/{{ clean_phone }}?text={{ wa_text | urlencode }}" target="_blank" style="flex: 1; background: var(--whatsapp-green); color: #000; text-align: center; text-decoration: none; padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; border-radius: 2px; text-transform: uppercase;">💬 WHATSAPP KEY</a>
                            <button type="button" onclick="navigator.clipboard.writeText('{{ ns_flare.key }}'); alert('Sovereign Key Copied');" style="flex: 1; background: transparent; border: 1px solid var(--integrity-gold); color: var(--gold-text); cursor: pointer; padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; border-radius: 2px;">📋 COPY KEY</button>
                        </div>
                    {% else %}
                        <div style="background: rgba(255,0,0,0.1); border: 1px dashed var(--critical-red); color: var(--critical-red); padding: 15px; text-align: center; font-size: 0.7rem; margin-bottom: 15px; font-family: 'Courier Prime', monospace;">
                            ⚠️ VIN NOT DETECTED IN LEDGER.
                        </div>
                    {% endif %}
                    <form action="{{ url_for('hangar.resolve_flare_log', log_id=flare.id) }}" method="POST" style="margin: 0;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" style="display: block; width: 100%; text-align: center; padding: 12px; background: transparent; color: var(--text-muted); border: 1px dashed var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; border-radius: 2px; cursor: pointer;">🛡️ ACKNOWLEDGE & CLEAR</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

<div id="priorityFlareModal" style="display: none; position: fixed; z-index: 999999; left: 0; top: 0; width: 100vw; height: 100vh; background: rgba(10, 10, 10, 0.95); justify-content: center; align-items: center; padding: 20px; box-sizing: border-box;">
    <div style="width: 100%; max-width: 500px; background: #ffffff; box-shadow: 0 25px 80px rgba(0,0,0,0.6); border-top: 6px solid #ff4444; border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; text-align: left;">
        <div style="background: #fffafb; border-bottom: 1px solid #ffcccc; display: flex; justify-content: space-between; align-items: center; padding: 30px 40px 20px;">
            <h2 style="font-family: 'Playfair Display', serif; color: #ff4444; margin: 0; font-size: 1.5rem; font-weight: 900; letter-spacing: 1px;">📡 Priority Flare</h2>
            <span onclick="document.getElementById('priorityFlareModal').style.display='none'" style="color: #777; font-size: 22px; cursor: pointer; font-family: sans-serif; font-weight: 400; line-height: 1;">✕</span>
        </div>

        <div style="padding: 35px; background: #fafafa;">
            <p style="font-size: 0.9em; color: #555; margin-bottom: 25px; line-height: 1.6; font-family: 'Inter', sans-serif;">
                <strong>ACCESS LOCKOUT DETECTED.</strong><br>
                If your Sovereign Key is lost or compromised, enter your mechanical DNA and registered contact number below. The Architect will intercept this signal, verify your identity, and manually issue a replacement key.
            </p>

            <form action="{{ url_for('hangar.launch_flare') }}" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>

                <label style="display: block; font-weight: bold; font-size: 0.85em; margin-bottom: 8px; color: #222; font-family: 'Montserrat', sans-serif;">VEHICLE VIN-DNA</label>
                <input type="text" name="vin_dna" required placeholder="Enter 17-character sequence" style="width: 100%; padding: 12px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 4px; font-family: 'Courier Prime', monospace; font-size: 1.1em; text-transform: uppercase; box-sizing: border-box;">

                <label style="display: block; font-weight: bold; font-size: 0.85em; margin-bottom: 8px; color: #222; font-family: 'Montserrat', sans-serif;">REGISTERED PHONE NUMBER</label>
                <input type="text" name="contact_info" required placeholder="e.g. +267..." style="width: 100%; padding: 12px; margin-bottom: 30px; border: 1px solid #ccc; border-radius: 4px; font-family: 'Inter', sans-serif; font-size: 1.1em; box-sizing: border-box;">

                <button type="submit" style="width: 100%; background: #ff4444; color: white; padding: 15px; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; border: none; border-radius: 4px; cursor: pointer; transition: background 0.3s;">
                    TRANSMIT SIGNAL TO ARCHITECT
                </button>
            </form>
        </div>
    </div>
</div>

{% if module_reviews %}
    <div style="font-family: 'Courier Prime', monospace; font-size: 1.2rem; font-weight: 900; color: #fd7e14; margin-top: 30px; margin-bottom: 20px; letter-spacing: 2px; text-align: center; border-bottom: 1px solid var(--border-ui); padding-bottom: 15px;">
        📡 PENDING APPRENTICE PROGRESSION REVIEWS
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
        {% for req in module_reviews %}
            <div style="background: var(--panel-bg); border: 1px solid #fd7e14; padding: 20px; border-radius: 4px; box-shadow: 0 4px 15px rgba(253, 126, 20, 0.15);">
                <div style="font-family: 'Courier Prime', monospace; font-size: 0.85rem; color: var(--text-main); line-height: 1.5; margin-bottom: 15px;">
                    {{ req.action }}
                    </div>
                <div style="font-size: 0.7rem; color: var(--text-muted); font-family: 'Courier Prime'; margin-bottom: 15px;">
                    TIMESTAMP: {{ req.timestamp.strftime('%Y-%m-%d %H:%M:%S') if req.timestamp else 'UNKNOWN' }}
                </div>
                <form action="{{ url_for('hangar.approve_module_review', log_id=req.id) }}" method="POST">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" style="display: block; width: 100%; text-align: center; padding: 12px; background: #fd7e14; color: black; border: none; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.8rem; border-radius: 2px; letter-spacing: 1px; cursor: pointer; text-transform: uppercase; transition: 0.3s;" onmouseover="this.style.background='#e06d0f'" onmouseout="this.style.background='#fd7e14'">
                        🔓 SIGN OFF & AUTHORIZE PROGRESSION
                    </button>
                </form>
            </div>
        {% endfor %}
    </div>
{% endif %}

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 30px; margin-bottom: 30px;">
   <div style="background: linear-gradient(145deg, #0d1117 0%, #050505 100%); border: 1px solid #1f2328; border-top: 4px solid var(--sanctified-blue, #0055ff); padding: 30px; border-radius: 6px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 15px 35px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.03); width: 100%; box-sizing: border-box; gap: 20px; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -50px; left: -50px; width: 150px; height: 150px; background: var(--sanctified-blue, #0055ff); filter: blur(80px); opacity: 0.15; z-index: 0;"></div>
   <div style="position: relative; z-index: 1;">
    <h3 style="margin: 0 0 5px 0; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: #7a8b99; text-transform: uppercase; letter-spacing: 3px; font-weight: 700;">🏦 Master Treasury</h3>
    <h2 style="margin: 0; font-family: 'Courier Prime', monospace; font-size: 3.5rem; font-weight: 900; color: #f0f6fc; text-shadow: 0 0 25px rgba(0, 85, 255, 0.3);">P{{ "{:,.2f}".format(total_motshelo or 0) }}</h2>
    <p style="margin: 10px 0 0 0; font-size: 0.8rem; font-family: 'Inter', sans-serif; color: #7a8b99;">Total verified Laveto operational liquidity.</p>
</div>
    <div style="display: flex; gap: 15px; position: relative; z-index: 1;">
        <div style="flex: 1; background: linear-gradient(180deg, rgba(0, 210, 106, 0.05) 0%, rgba(0, 0, 0, 0) 100%); border: 1px solid rgba(0, 210, 106, 0.15); border-left: 3px solid #00d26a; padding: 15px; border-radius: 4px; text-align: right;">
            <div style="color: #00d26a; font-family: 'Courier Prime', monospace; font-weight: bold; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 10px; opacity: 0.8;">Avg Monthly Yield (5% Est)</div>
            <div style="color: #00ff88; font-size: 1.5rem; font-family: 'Courier Prime', monospace; font-weight: 900; text-shadow: 0 0 10px rgba(0, 255, 136, 0.2);">+P{{ "{:,.2f}".format((total_motshelo or 0) * 0.05) }}</div>
        </div>
    </div>
</div>

    <div class="projection-panel" style="margin-bottom: 0;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <h3 style="margin: 0; color: var(--gold-text); letter-spacing: 3px; font-size: 0.9rem;">🛰️ REVENUE PROJECTION ENGINE</h3>
            <div style="display: flex; gap: 10px; align-items: center;">
                <span style="font-size: 0.6rem; background: var(--integrity-green); color: white; padding: 5px 12px; border-radius: 2px; font-weight: 900; display: flex; align-items: center;">
                    <div class="sentinel-orb"></div> SYSTEM: ONLINE
                </span>
            </div>
        </div>
        <div class="projection-grid">
            <div class="projection-stat">
                <h4>Platform Valuation</h4>
                <div style="color: var(--text-main);">P{{ "{:,.2f}".format((projection.valuation | default(0)) | float) }}</div>
            </div>
            <div class="projection-stat">
                <h4>Gap to Million</h4>
                <div style="color: var(--critical-red);">P{{ "{:,.2f}".format((projection.gap_to_million | default(0)) | float) }}</div>
            </div>
            <div class="projection-stat">
                <h4>Hangar Capacity</h4>
                <div style="color: var(--text-main); font-size: 1.6rem; font-family: 'Courier Prime'; font-weight: bold;">{{ active_nodes }} <span style="font-size: 0.8rem; color: var(--text-muted);">/ 500 MAX</span></div>
                <div style="width: 100%; height: 4px; background: var(--border-ui); margin-top: 8px; border-radius: 2px; overflow: hidden;">
                    <div style="height: 100%; width: {{ ((active_nodes / 500) * 100) if active_nodes else 0 }}%; background: {% if active_nodes >= 500 %}var(--critical-red){% else %}var(--integrity-gold){% endif %}; transition: 0.5s;"></div>
                </div>
            </div>
            <div class="projection-stat">
                <h4>Global Liquidity (L_s)</h4>
                <div style="color: {% if system_ls and system_ls > 2.0 %}var(--integrity-green){% elif system_ls and system_ls > 1.2 %}var(--gold-text){% else %}var(--critical-red){% endif %};">{{ system_ls|round(2) if system_ls else '0.00' }}</div>
            </div>
        </div>
        <div class="progress-track"><div class="progress-fill" style="width: {{ ((projection.valuation or 0) / 1000000 * 100)|round(2) }}%;"></div></div>
    </div>
</div>

<div class="velocity-card">
    <div class="velocity-left">
        <div style="font-family: 'Courier Prime', monospace; font-size: 0.65rem; color: var(--text-muted); margin-bottom: 5px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase;">Business Profit Margin</div>
        <div style="font-family: 'Courier Prime', monospace; font-size: 3.5rem; font-weight: 700; color: var(--text-main); font-variant-numeric: tabular-nums; letter-spacing: -0.5px; line-height: 1;">{{ ((saas_total / total_motshelo * 100) if total_motshelo and total_motshelo > 0 else 0)|round(2) }}%</div>
        <div style="font-family: 'Courier Prime', monospace; font-size: 0.7rem; color: var(--integrity-green); margin-top: 10px; font-weight: bold;">
            SYSTEM STATUS: <span style="letter-spacing: 2px;">HEALTHY</span>
        </div>
    </div>
    <div class="velocity-divider"></div>
    <div class="velocity-right">
        <div class="trinity-bar-wrapper">
            <div class="bar-segment">
                <div class="bar-fill bg-tvl" style="height: 100%;"></div>
                <span class="bar-label">SAVINGS</span>
            </div>
            <div class="bar-segment">
                {% set debt_pct = (total_debt / total_motshelo * 100) if total_motshelo and total_motshelo > 0 else 0 %}
                <div class="bar-fill bg-debt" style="height: {{ debt_pct }}%;"></div>
                <span class="bar-label">DEBT</span>
            </div>
            <div class="bar-segment">
                {% set yield_pct = (saas_total / total_motshelo * 300) if total_motshelo and total_motshelo > 0 else 0 %}
                <div class="bar-fill bg-saas" style="height: {{ [yield_pct, 100]|min }}%;"></div>
                <span class="bar-label">PROFIT</span>
            </div>
        </div>
    </div>
</div>

<div class="top-stats-container" style="display: flex; margin-bottom: 30px; gap: 10px;">
   <div class="stat-box" style="background: var(--stat-bg-1); border-color: var(--sanctified-blue);">
    <div style="font-family: 'Montserrat', sans-serif; font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px;">Total Member Savings</div>
    <div class="stat-value" style="color: var(--text-main);">P{{ "{:,.2f}".format(total_motshelo or 0) }}</div>
</div>
    <div class="stat-box" style="background: var(--stat-bg-2); border-color: var(--critical-red);">
        <div style="font-family: 'Montserrat', sans-serif; font-size: 0.6rem; color: var(--critical-red); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px;">Total Outstanding Debt</div>
        <div class="stat-value" style="color: var(--critical-red);">P{{ "{:,.2f}".format(total_debt or 0) }}</div>
    </div>
    <div class="stat-box" style="background: var(--stat-bg-3); border-color: var(--integrity-green);">
        <div style="font-family: 'Montserrat', sans-serif; font-size: 0.6rem; color: var(--integrity-green); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px;">Total Profit Revenue</div>
        <div class="stat-value" style="color: var(--integrity-green);">P{{ "{:,.2f}".format(saas_total or 0) }}</div>
    </div>
</div>

{% if stability and stability.red_soil_mode %}
<div style="background: var(--critical-red); color: white; padding: 15px; text-align: center; font-family: 'Montserrat', sans-serif; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 30px; border-radius: 2px; animation: critical-blink 2s infinite;">
    ⚠️ ECONOMIC RED SOIL: STAGGERED RELEASE ACTIVE (90-DAY GATE)
</div>
{% endif %}

<div style="background: #050505; border: 1px solid var(--border-ui); border-top: 3px solid var(--integrity-gold); border-radius: 4px; padding: 20px; margin-bottom: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); width: 100%; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1a1a1a; padding-bottom: 15px; margin-bottom: 15px;">
        <h3 style="margin: 0; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; color: var(--gold-text); text-transform: uppercase; letter-spacing: 2px; display: flex; align-items: center; gap: 10px;">
            <div class="sentinel-orb"></div> Global Warden Telemetry
        </h3>
        <div style="font-family: 'Courier Prime', monospace; font-size: 0.65rem; color: var(--integrity-green); font-weight: bold; letter-spacing: 1px; animation: pulse-text 2s infinite;">
            LIVE FEED SECURED
        </div>
    </div>

    <div class="scroll-hide" style="max-height: 250px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; font-family: 'Courier Prime', monospace; font-size: 0.7rem; padding-right: 10px;">
        {% set all_events = [] %}
        {% for r in all_records %}
            {% if r.transactions %}
                {% for tx in r.transactions %}
                    {% if tx.timestamp %}
                        {% set _ = all_events.append({'time': tx.timestamp, 'intent': tx.intent, 'vin': r.vin_dna, 'amount': tx.amount}) %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}
        {% set sorted_events = all_events | sort(attribute='time', reverse=true) %}

        {% if sorted_events|length > 0 %}
            {% for event in sorted_events[:50] %}
            <div style="display: grid; grid-template-columns: 100px 110px 1fr; gap: 15px; padding: 8px 12px; background: rgba(255,255,255,0.02); border-left: 2px solid {% if event.amount and event.amount > 0 %}var(--integrity-green){% elif 'FAILED' in event.intent or 'REJECTED' in event.intent %}var(--critical-red){% else %}var(--sanctified-blue){% endif %}; border-radius: 2px; align-items: center; transition: 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='rgba(255,255,255,0.02)'">
                <div style="color: var(--text-muted); font-size: 0.65rem;">{{ event.time.strftime('%b %d, %H:%M') }}</div>
                <div><a href="?search={{ event.vin }}" style="color: var(--gold-text); font-weight: bold; letter-spacing: 1px; text-decoration: none; border-bottom: 1px dashed var(--gold-text);">[{{ event.vin }}]</a></div>
                <div style="color: #FFFFFF; white-space: nowrap;overflow: hidden; text-overflow: ellipsis;" title="{{ event.intent }}">{{ event.intent }}</div>
            </div>
            {% endfor %}
        {% else %}
            <div style="text-align: center; padding: 30px; color: var(--text-muted); font-style: italic; letter-spacing: 1px;">[ SILENCE DETECTED ON ALL FREQUENCIES ]</div>
        {% endif %}
    </div>
</div>

<div class="queue-header" style="margin-top: 20px;">PENDING INTAKE PROSPECTS</div>
    {% if prospects and prospects|length > 0 %}
        {% for p in prospects %}
            <div class="queue-card">
                <div style="font-family: 'Courier Prime', monospace; font-size: 1.2rem; font-weight: 900; color: var(--integrity-gold); margin-bottom: 15px; letter-spacing: 2px; text-align: center; border-bottom: 1px solid var(--border-ui); padding-bottom: 15px;">{{ p.vin_dna }}</div>

                <div class="queue-data" style="margin-bottom: 20px; font-family: 'Inter', sans-serif; font-size: 0.9rem;">
                    <div style="margin-bottom: 6px; color: #888;"><strong style="color: #bbb;">MEMBER:</strong> <span style="color: #e0e0e0; margin-left: 5px;">{{ p.full_name or p.member_name }}</span></div>
                    <div style="margin-bottom: 6px; color: #888;"><strong style="color: #bbb;">PHONE:</strong> <span style="color: #e0e0e0; margin-left: 5px;">{{ p.phone_number or 'N/A' }}</span></div>
                    <div style="margin-bottom: 6px; color: #888;"><strong style="color: #bbb;">EMAIL:</strong> <span style="color: #e0e0e0; margin-left: 5px;">{{ p.email or 'N/A' }}</span></div>
                </div>

                <div style="background: rgba(0, 0, 0, 0.4); border: 1px dashed var(--sanctified-blue); padding: 15px; border-radius: 4px;">
                    <div style="font-size: 0.65rem; color: var(--integrity-gold); font-family: 'Montserrat'; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px;">Covenant Terms</div>

                    <div class="queue-data" style="font-family: 'Inter', sans-serif; font-size: 0.85rem;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px; color: #888;"><strong style="color: #bbb;">Class:</strong> <span style="color: #e0e0e0;">CLASS {{ p.vehicle_class|default('B', true) }}</span></div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px; color: #888;"><strong style="color: #bbb;">Funding:</strong> <span style="color: #e0e0e0;">{{ p.funding_method|default('EFT', true)|replace('_', ' ') }}</span></div>
                        <div style="display: flex; justify-content: space-between; color: #888;"><strong style="color: #bbb;">Cohort:</strong> <span style="color: var(--sanctified-white); font-weight: 700;">{{ p.corporate_cohort|default('INDIVIDUAL', true) }}</span></div>
                    </div>
                </div>

               <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; align-items: center;">

    <form action="{{ url_for('hangar.approve_intake', prospect_id=p.id) }}" method="POST" style="margin: 0;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <button type="submit" style="width: 100%; padding: 15px; font-weight: 900; background: #28a745; color: #000; border: none; border-radius: 4px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;">
            🔓 APPROVE
        </button>
    </form>

    <form action="{{ url_for('hangar.disapprove_intake', prospect_id=p.id) }}" method="POST" style="margin: 0;" onsubmit="return confirm('⚠️ WELDING ALERT: Are you sure you want to permanently purge this intake record?');">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
       <button type="button"
        onclick="openRejectionModal('{{ p.id }}', '{{ p.phone_number }}')"
        style="width: 100%; padding: 15px; font-weight: 900; background: #dc3545; color: #fff; border: none; border-radius: 4px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px;">
    🚨 DISAPPROVE & SIGNAL
</button>
    </form>

</div>
{% endfor %}
{% else %}
    <div style="text-align: center; padding: 30px; background: var(--panel-bg); color: var(--text-muted); font-family: 'Courier Prime', monospace; border: 1px dashed var(--border-ui); border-radius: 4px; margin-bottom: 20px;">
        [ 📭 NO PENDING PROSPECTS IN THE QUEUE ]
    </div>

{% endif %}

<div id="liquidation-queue" style="background: #1a1a1a; border: 2px solid var(--integrity-gold); padding: 25px; margin-top: 20px; margin-bottom: 30px;">
    <h3 style="color: var(--integrity-gold); margin-top: 0; font-family: 'Montserrat', sans-serif; letter-spacing: 2px;">📥 LIQUIDATION REQUEST QUEUE</h3>
    {% set found = [] %}
    {% for r in all_records %}
        {% set check_status = (r.status or r.current_status or '') | upper %}
        {% if 'SALE' in check_status or 'PENDING' in check_status or 'LIQUIDATION' in check_status or 'PAYOUT' in check_status %}
            {% set _ = found.append(1) %}
            <div style="background: rgba(197, 160, 89, 0.1); border: 1px solid var(--integrity-gold); padding: 20px; margin-top: 15px; border-radius: 4px;">
                <div style="color: #fff; font-weight: 900; font-size: 1.1rem; text-transform: uppercase;">
                    Client: {{ r.member_name or 'UNVERIFIED' }} | VIN: {{ r.vin_dna }}
                </div>
                <div style="color: #ffcc00; font-size: 0.8rem; margin-bottom: 15px; font-family: 'Courier Prime', monospace; font-weight: bold;">
                    DETECTED STATUS: {{ check_status }}
                </div>

<div style="margin: 10px 0; border-top: 1px solid #30363d; padding-top: 10px;">

    <a href="javascript:void(0);" onclick="document.getElementById('manual_upload_{{ r.id }}').style.display = document.getElementById('manual_upload_{{ r.id }}').style.display === 'none' ? 'block' : 'none';"
       style="color: #66b3ff; font-family: 'Montserrat', sans-serif; font-size: 0.7rem; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; display: flex; align-items: center;">
       <span style="margin-right: 5px;">⚠️</span> MANUAL UPLOAD (OVERRIDE VISUALS)
    </a>

    <div id="manual_upload_{{ r.id }}" style="display: none; margin-top: 10px; padding: 15px; background: rgba(255,0,0,0.05); border: 1px dashed var(--critical-red); border-radius: 2px; box-sizing: border-box; width: 100%;">
        <form action="{{ url_for('hangar.upload_forensics', entry_id=r.id) }}" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <label style="font-family: 'Montserrat', sans-serif; font-size: 0.6rem; color: var(--critical-red); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; display: block; font-weight: bold;">ADMIN OVERRIDE: BYPASS WARDEN CAPTURE</label>
            <div style="display: grid; grid-template-columns: 1fr; gap: 5px; box-sizing: border-box; width: 100%;">

                <label for="market1_{{ r.id }}" class="camera-trigger" id="label_market1_{{ r.id }}" style="box-sizing: border-box; width: 100%; background: #111; color: #fff; padding: 10px; border: 1px solid #333; text-align: center; cursor: pointer;">📂 UPLOAD STANCE (FRONT)</label>
                <input type="file" id="market1_{{ r.id }}" name="marketplace_image" accept="image/*" style="display: none;" onchange="this.previousElementSibling.style.borderColor='var(--integrity-green)'; this.previousElementSibling.innerHTML='✅ FRONT SELECTED';">

                <label for="market2_{{ r.id }}" class="camera-trigger" id="label_market2_{{ r.id }}" style="box-sizing: border-box; width: 100%; background: #111; color: #fff; padding: 10px; border: 1px solid #333; text-align: center; cursor: pointer;">📂 UPLOAD HEART (SIDE)</label>
                <input type="file" id="market2_{{ r.id }}" name="marketplace_image_2" accept="image/*" style="display: none;" onchange="this.previousElementSibling.style.borderColor='var(--integrity-green)'; this.previousElementSibling.innerHTML='✅ SIDE SELECTED';">

                <label for="market3_{{ r.id }}" class="camera-trigger" id="label_market3_{{ r.id }}" style="box-sizing: border-box; width: 100%; background: #111; color: #fff; padding: 10px; border: 1px solid #333; text-align: center; cursor: pointer;">📂 UPLOAD SANCTITY (INTERIOR)</label>
                <input type="file" id="market3_{{ r.id }}" name="marketplace_image_3" accept="image/*" style="display: none;" onchange="this.previousElementSibling.style.borderColor='var(--integrity-green)'; this.previousElementSibling.innerHTML='✅ INTERIOR SELECTED';">

                <button type="submit" style="background-color: var(--critical-red); color: white; border: none; padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 2px; transition: 0.2s; font-size: 0.65rem; width: 100%; margin-top: 10px; box-sizing: border-box;">FORCE UPLOAD VISUALS</button>
            </div>
        </form>
    </div>

</div>

                <div style="background: #0d1117; border: 1px solid #30363d; padding: 15px; margin: 15px 0; border-radius: 4px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <span style="font-family: 'Montserrat', sans-serif; font-size: 0.7rem; color: #8b949e; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase;">Sovereign Valuation Engine</span>
                    </div>
                    <form action="#" onsubmit="alert('Listing engine offline'); return false;" method="POST" id="valuationForm_{{ r.id }}" style="margin: 0;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <div style="display: flex; gap: 10px; align-items: stretch;">
                            <input type="number" id="baseMarketVal_{{ r.id }}" name="base_market_value" placeholder="Base Market Value (P)" required style="flex: 2; margin: 0; background: #010409; color: #f0f6fc; border: 1px solid #30363d; padding: 10px 12px; font-family: 'Courier Prime', monospace; font-size: 0.85rem; border-radius: 2px; outline: none;">
                            <button type="button" onclick="calculateSovereignMarketValue('{{ r.id }}', {{ r.calculated_integrity | default(0.85) }}, {{ r.shield_reservoir or 0 }}, {{ r.active_loan_principal or 0 }})" style="flex: 1; background: var(--sanctified-blue); color: white; border: none; padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.65rem; letter-spacing: 1px; border-radius: 2px; cursor: pointer; text-transform: uppercase;">CALCULATE</button>
                        </div>
                    </form>
                </div>

                <div style="display: flex; gap: 10px;">
                    <a href="{{ url_for('hangar.generate_liquidation_payout', entry_id=r.id) }}" style="background: var(--integrity-gold); color: #000; padding: 10px 20px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.8rem; border-radius: 2px;">APPROVE & GENERATE PAYOUT</a>
                    <form action="{{ url_for('hangar.override_asset') }}" method="POST" style="margin: 0;">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="entry_id" value="{{ r.id }}">
                        <input type="hidden" name="status" value="STABLE">
                        <button type="submit" style="background: transparent; color: #ff4d4d; border: 1px solid #ff4d4d; padding: 10px 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.8rem; cursor: pointer; border-radius: 2px;">REJECT REQUEST</button>
                    </form>
                </div>
            </div>
        {% endif %}
    {% endfor %}

    {% if found|length == 0 %}
        <div style="color: #888; font-family: 'Courier Prime', monospace; margin-top: 15px; font-style: italic; letter-spacing: 1px;">[ NO PENDING LIQUIDATIONS DETECTED ]</div>
    {% endif %}
</div>

<div id="fleet-registry" style="background: var(--panel-bg); border: 1px solid var(--border-ui); border-top: 4px solid var(--sanctified-blue); border-radius: 4px; padding: 25px; margin-bottom: 30px; width: 100%; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-ui); padding-bottom: 15px; margin-bottom: 15px; flex-wrap: wrap; gap: 15px;">
        <h3 style="color: var(--sanctified-blue); margin: 0; font-family: 'Montserrat', sans-serif; text-transform: uppercase; font-size: 1.1rem; letter-spacing: 2px;">📋 MASTER FLEET REGISTRY</h3>
        <input type="text" id="intakeRadarSearch" onkeyup="runIntakeRadarFilter()" placeholder="🔍 Search Member or VIN..." style="padding: 10px; background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-ui); font-family: 'Courier Prime', monospace; border-radius: 2px; min-width: 280px; box-sizing: border-box;">
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-family: 'Inter', sans-serif; font-size: 0.8rem; text-align: left;">
            <thead>
       <tr style="background: var(--table-header, #222222); color: #ffffff; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 1px; font-size: 0.7rem;">
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">VIN DNA</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">Pilot / Member</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">Class</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">Shield (40%)</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">LVT Utility</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">Debt / Loan</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); color: #ffffff;">Status</th>
        <th style="padding: 12px; border-bottom: 2px solid var(--sanctified-blue); text-align: center; color: #ffffff;">Client Vault</th>
    </tr>
<tbody id="intakeTableBody">
    {% for r in results.items %}
    {% set ns_parts = namespace(needs_order=false) %}

    <tr class="intake-telemetry-row" data-search-payload="{{ r.vin_dna|upper }} {{ (r.member_name or '')|upper }}">
        <td style="padding: 12px; font-family: 'Courier Prime', monospace; font-weight: bold; color: var(--integrity-gold);">
            <a href="?search={{ r.vin_dna }}" style="color: inherit; text-decoration: none; border-bottom: 1px dashed var(--integrity-gold);">{{ r.vin_dna }}</a>
        </td>
        <td style="padding: 12px; color: var(--text-main); font-weight: 600;">{{ r.member_name or 'UNVERIFIED' }}</td>
        <td style="padding: 12px; font-family: 'Courier Prime', monospace; font-weight: bold; color: var(--integrity-gold);">
            CLASS {% if r.vehicle_class and r.vehicle_class|string|trim != '' %}{{ r.vehicle_class | upper }}{% else %}B{% endif %}
        </td>
        <td style="padding: 12px; font-family: 'Courier Prime', monospace; color: var(--integrity-green); font-weight: bold;">P{{ "{:,.2f}".format(r.shield_reservoir or 0) }}</td>

        <td style="padding: 12px; font-family: 'Courier Prime', monospace; color: var(--integrity-gold); font-weight: bold;">
            {{ "{:,.2f}".format(r.lvt_balance or 0) }} LVT
        </td>

        <td style="padding: 12px; font-family: 'Courier Prime', monospace; color: {% if r.active_loan_principal and r.active_loan_principal > 0 %}var(--critical-red){% else %}var(--text-muted){% endif %}; font-weight: bold;">
            P{{ "{:,.2f}".format(r.active_loan_principal or 0) }}
        </td>
        <td style="padding: 12px;">
            <span style="font-size: 0.65rem; font-family: 'Montserrat', sans-serif; font-weight: bold; padding: 4px 8px; border-radius: 2px; text-transform: uppercase; display: inline-block; background: {% if 'FAIL' in (r.status or '')|upper %}rgba(255,0,0,0.1){% elif 'PAYMENT' in (r.status or '')|upper %}rgba(197,160,89,0.1){% else %}rgba(40,167,69,0.1){% endif %}; color: {% if 'FAIL' in (r.status or '')|upper %}var(--critical-red){% elif 'PAYMENT' in (r.status or '')|upper %}var(--integrity-gold){% else %}var(--integrity-green){% endif %}; border: 1px solid currentColor;">
                {{ (r.status or 'PENDING')[:15] }}
            </span>
        </td>
        <td style="padding: 12px; text-align: center;">
            <a href="{{ url_for('hangar.client_vault', asset_id=r.vin_dna) }}" style="background: rgba(0, 85, 255, 0.1); color: var(--sanctified-blue); border: 1px solid var(--sanctified-blue); padding: 5px 12px; border-radius: 2px; text-decoration: none; font-family: 'Montserrat', sans-serif; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; transition: 0.2s;" onmouseover="this.style.background='var(--sanctified-blue)'; this.style.color='#fff';" onmouseout="this.style.background='rgba(0, 85, 255, 0.1)'; this.style.color='var(--sanctified-blue)';">📂 OPEN VAULT</a>
        </td>
    </tr>
    {% endfor %}

    {% if not results.items %}
    <tr>
        <td colspan="8" style="padding: 20px; text-align: center; color: var(--text-muted); font-family: 'Courier Prime', monospace;">[ NO REGISTRY DATA FOUND ]</td>
    </tr>
    {% endif %}
</tbody>
        </table>
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 15px; border-top: 1px dashed var(--border-ui); font-family: 'Courier Prime', monospace; font-size: 0.75rem; color: var(--text-muted); box-sizing: border-box; width: 100%;">
    <div>
        SHOWING <span style="color: var(--text-main); font-weight: bold;">{{ (results.page - 1) * results.per_page + 1 if results.total > 0 else 0 }}</span> -
        <span style="color: var(--text-main); font-weight: bold;">{{ (results.page - 1) * results.per_page + results.items|length }}</span> OF
        <span style="color: var(--integrity-gold); font-weight: bold;">{{ results.total }}</span> ASSETS
    </div>

    <div style="display: flex; gap: 10px; align-items: center;">
        {% if results.has_prev %}
            <a href="{{ url_for('hangar.view_ledger', page=results.prev_num, filter=status_filter, search=search_query) }}"
               style="background: transparent; border: 1px solid var(--border-ui); color: var(--text-main); padding: 5px 10px; cursor: pointer; border-radius: 2px; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 0.65rem; text-decoration: none; transition: 0.3s;"
               onmouseover="this.style.background='var(--border-ui)';"
               onmouseout="this.style.background='transparent';">
                « PREV
            </a>
        {% else %}
            <span style="opacity: 0.3; border: 1px solid var(--border-ui); color: var(--text-muted); padding: 5px 10px; border-radius: 2px; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 0.65rem; cursor: not-allowed; pointer-events: none;">« PREV</span>
        {% endif %}

        <span>PAGE <span style="color: var(--text-main); font-weight: bold;">{{ results.page }}</span> / <span style="color: var(--text-main); font-weight: bold;">{{ results.pages if results.pages > 0 else 1 }}</span></span>

        {% if results.has_next %}
            <a href="{{ url_for('hangar.view_ledger', page=results.next_num, filter=status_filter, search=search_query) }}"
               style="background: transparent; border: 1px solid var(--border-ui); color: var(--text-main); padding: 5px 10px; cursor: pointer; border-radius: 2px; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 0.65rem; text-decoration: none; transition: 0.3s;"
               onmouseover="this.style.background='var(--border-ui)';"
               onmouseout="this.style.background='transparent';">
                NEXT »
            </a>
        {% else %}
            <span style="opacity: 0.3; border: 1px solid var(--border-ui); color: var(--text-muted); padding: 5px 10px; border-radius: 2px; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 0.65rem; cursor: not-allowed; pointer-events: none;">NEXT »</span>
        {% endif %}
    </div>
</div>
</div>
<div style="background: var(--card-bg, #161b22); border: 1px solid var(--border-ui, #30363d); border-top: 4px solid var(--integrity-gold); border-radius: 4px; padding: 30px; margin-bottom: 50px; width: 100%; box-sizing: border-box; box-shadow: 0 15px 35px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 20px; flex-wrap: wrap; gap: 15px;">
        <h3 style="color: var(--integrity-gold); margin: 0; font-family: 'Montserrat', sans-serif; text-transform: uppercase; font-size: 1.1rem; letter-spacing: 2px; display: flex; align-items: center; gap: 12px; text-shadow: 0 0 15px rgba(197, 160, 89, 0.2);">
            <span style="display: inline-block; width: 8px; height: 8px; background: var(--integrity-gold); border-radius: 50%; box-shadow: 0 0 10px var(--integrity-gold); animation: pulse-icon 2s infinite;"></span>
            COMMUNICATIONS HUB
        </h3>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <input type="text" id="commsRadarSearch"
                   onkeyup="runCommsRadarFilter()"
                   placeholder="🔍 Quick Find Pilot..." style="padding: 12px 15px; background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-ui); font-family: 'Courier Prime', monospace; font-size: 0.85rem; border-radius: 2px; min-width: 280px; box-sizing: border-box; outline: none; transition: 0.3s;" onfocus="this.style.borderColor='var(--integrity-gold)'; this.style.boxShadow='0 0 15px rgba(197, 160, 89, 0.1)';" onblur="this.style.borderColor='var(--border-ui)'; this.style.boxShadow='none';">

            <button type="button"
                    onclick="let c=document.getElementById('comms-fleet-container'); let i=document.getElementById('comms-icon'); if(c.style.display==='none'||c.style.display===''){c.style.display='block';i.innerText='🔼';}else{c.style.display='none';i.innerText='🔽';}"
                    style="background: var(--sanctified-blue); border: 1px solid var(--sanctified-blue); color: white; padding: 12px 20px; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 900; cursor: pointer; border-radius: 2px; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 5px 15px rgba(0, 85, 255, 0.2);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 20px rgba(0, 85, 255, 0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 5px 15px rgba(0, 85, 255, 0.2)';">
                <span id="comms-icon" style="display: inline-block; transition: transform 0.3s ease; margin-right: 8px;">🔽</span> EXPAND FLEET
            </button>
    </div>

    <div id="comms-fleet-container" style="display: none; padding-top: 25px;">
        <div id="comms-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px; max-height: 450px; overflow-y: auto; padding-right: 10px; padding-bottom: 10px;">
            {% for r in all_records %}
            <div class="comms-card" style="background: var(--input-bg); border: 1px solid var(--border-ui); padding: 20px; border-radius: 4px; border-left: 4px solid var(--sanctified-blue);">
                <div class="pilot-name" style="font-family: 'Montserrat', sans-serif; font-weight: 900; color: var(--text-main); font-size: 1rem; text-transform: uppercase;">
                    {{ r.member_name or 'UNVERIFIED PILOT' }}
                </div>
                <div class="pilot-vin" style="font-family: 'Courier Prime', monospace; color: var(--text-muted); font-size: 0.8rem; margin-top: 5px;">
                    VIN: {{ r.vin_dna }}
                </div>
                <div style="margin-top: 15px; display: flex; gap: 10px;">
                    {% if r.member_phone %}
                    <a href="https://wa.me/{{ r.member_phone|replace('+', '')|replace(' ', '') }}" target="_blank" style="background: rgba(37, 211, 102, 0.1); color: #25D366; border: 1px solid #25D366; padding: 8px; font-size: 0.7rem; font-family: 'Montserrat', sans-serif; font-weight: 900; text-align: center; text-decoration: none; flex: 1;">💬 WHATSAPP</a>
                    {% endif %}
                    <a href="{{ url_for('hangar.client_vault', asset_id=r.vin_dna) }}" target="_blank" style="background: transparent; color: var(--sanctified-blue); border: 1px solid var(--sanctified-blue); padding: 8px; font-size: 0.7rem; font-family: 'Montserrat', sans-serif; font-weight: 900; text-align: center; text-decoration: none; flex: 1;">📂 VAULT</a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% if not all_records %}
            <div style="text-align: center; color: var(--text-muted); font-family: 'Courier Prime', monospace; padding: 20px; font-weight: bold;">[ NO PILOTS DETECTED IN LEDGER ]</div>
        {% endif %}
    </div>
</div>

<div class="carouselControls" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; background: var(--panel-bg); padding: 10px 20px; border: 1px solid var(--border-ui); border-left: 5px solid var(--integrity-gold); border-radius: 4px; box-sizing: border-box;">
    <button type="button" onclick="window.changeCarouselPage(-1)" style="background: var(--sanctified-blue); color: white; border: none; padding: 10px 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; cursor: pointer; border-radius: 2px; text-transform: uppercase; transition: 0.3s; font-size: 0.75rem;">« PREVIOUS ASSET</button>

   <div class="carouselIndicator" style="font-family: 'Courier Prime', monospace; font-size: 1.1rem; font-weight: bold; color: var(--text-main); letter-spacing: 2px;">
    ASSET <span class="carousel-current-indicator" style="color: var(--integrity-gold);">1</span> OF <span class="carousel-total-indicator">{{ all_records|length }}</span>
</div>

    <button type="button" onclick="window.changeCarouselPage(1)" style="background: var(--sanctified-blue); color: white; border: none; padding: 10px 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; cursor: pointer; border-radius: 2px; text-transform: uppercase; transition: 0.3s; font-size: 0.75rem;">NEXT ASSET »</button>
</div>

<a href="#" onclick="dispatchEmailBlast(event, this)" data-url="{{ url_for('hangar.mass_email_statements') }}" style="background-color: var(--sanctified-blue); color: white; border: 1px solid var(--sanctified-blue); padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; border-radius: 2px; transition: 0.3s; font-size: 0.7rem; text-align: center; text-decoration: none; display: block; margin-bottom: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);">📧 EMAIL ALL STATEMENTS</a>


<div class="controls-bar" style="margin-bottom: 30px;">
    <div style="display: flex; gap: 10px; align-items: center; width: 100%; flex-wrap: wrap;">
        <div class="triage-ribbon" style="width: 100%; display: flex; gap: 8px; flex-wrap: wrap;">
            {% set total_critical = (quarantine_count or 0) + (liquidation_requests or 0) + (loan_notifications or 0) + (compliance_requests or 0) %}

            <a href="?filter=ACTION_REQUIRED" class="btn-ribbon {% if status_filter == 'ACTION_REQUIRED' %}active{% endif %}">
                ⚠️ ACTION REQUIRED {% if total_critical > 0 %}({{ total_critical }}){% endif %}
            </a>

            <button type="button" onclick="window.location.href='{{ url_for('hangar.view_ledger') }}?filter=ALL'" class="btn-ribbon">
                🌐 ALL ACCOUNTS
            </button>
        </div>

       <div style="display: flex; gap: 15px; align-items: center; width: 100%; flex-wrap: wrap; margin-top: 10px;">
    <div style="display: flex; gap: 10px; width: 100%; margin-top: 10px;">
    <input type="text"
           id="globalFleetSearchInput"
           placeholder="Quick Scan (Type VIN or Name)..."
           oninput="runGlobalFleetSearch()"
           style="background: #000; border: 1px solid var(--border-ui); color: white; padding: 12px; width: 80%; font-family: 'Courier Prime', monospace; box-sizing: border-box; outline: none;">

    <button type="button" onclick="runGlobalFleetSearch()" style="background: var(--sanctified-blue); color: white; border: none; padding: 10px 25px; font-family: 'Montserrat', sans-serif; font-weight: bold; font-size: 0.75rem; text-transform: uppercase; cursor: pointer; letter-spacing: 1px;">
        SEARCH
    </button>
</div>

    <form action="{{ url_for('hangar.update_contact') }}" method="POST" style="margin: 0; flex: 1; display: flex; justify-content: flex-end;">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>

        <button type="button" onclick="triggerPulse(event)"
                style="background: var(--integrity-gold); color: #000000; border: 1px solid var(--integrity-gold); padding: 12px 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 2px; box-shadow: 0 0 15px rgba(197, 160, 89, 0.5); transition: 0.3s;"
                onmouseover="this.style.background='#a8823a'; this.style.boxShadow='0 0 25px rgba(197, 160, 89, 0.8)';"
                onmouseout="this.style.background='var(--integrity-gold)'; this.style.boxShadow='0 0 15px rgba(197, 160, 89, 0.5)';">
            ⚡ EXECUTE PAYROLL PULSE
        </button>
    </form>
</div>
</div>
</div>
{% for r in all_records %}
    {% set ns_parts = namespace(needs_order=false) %}
    {% for ghost in r.ghost_orders %}
        {% if ghost.status in ['PENDING ORDER', 'FUNDS CLEARED', 'AWAITING PAYMENT'] %}
            {% set ns_parts.needs_order = true %}
        {% endif %}
    {% endfor %}

    {% set safe_status = (r.status or r.current_status or '') | upper %}
    {% set is_liquidation_alert = ('SALE' in safe_status or 'LIQUIDATION' in safe_status) and not r.listed_for_sale %}

    {% set is_critical = is_liquidation_alert or
                         'PAYMENT' in safe_status or
                         'EMERGENCY' in safe_status or
                         'FAIL' in safe_status or
                         'PROCUREMENT' in safe_status or
                         'MAYDAY' in safe_status or
                         'COMPLIANCE' in safe_status or
                         (r.pending_loan_amount and r.pending_loan_amount > 0) or
                         (r.health_score and r.health_score <= 20) or
                         ns_parts.needs_order %}

    {% if status_filter == 'ALL' or not status_filter or r.status == status_filter or (status_filter == 'ACTION_REQUIRED' and is_critical) %}

       <div id="asset-card-{{ loop.index }}" class="asset-card" data-vin="{{ r.vin_dna|lower }}" data-status="{{ safe_status|lower }}" data-parts-pending="{{ 'true' if ns_parts.needs_order else 'false' }}" data-listed="{{ 'true' if r.listed_for_sale else 'false' }}" style="background: var(--card-bg); border-left: 8px solid {% if is_critical %}var(--critical-red){% elif 'FAILED' in safe_status %}#8B0000{% elif r.listed_for_sale %}#1E8E3E{% elif r.provenance_locked %}var(--integrity-gold){% else %}var(--sanctified-blue){% endif %}; border-radius: 2px; margin-bottom: 25px; padding: 25px; box-sizing: border-box; width: 100%; display: {% if loop.index == 1 %}block{% else %}none{% endif %} !important;">

            <div style="display: grid; grid-template-columns: 1.2fr 0.8fr 1fr 1.5fr 1.8fr 1fr; gap: 15px; align-items: start; min-width: 0; box-sizing: border-box;">

                <div style="display: flex; flex-direction: column; justify-content: flex-start; gap: 15px; height: 100%; min-width: 0; box-sizing: border-box;">

                    <div style="background: var(--panel-bg); padding: 12px; border-radius: 2px; border: 1px solid var(--border-ui); text-align: center;">
                        <div style="font-family: 'Courier Prime', monospace; font-size: 1.1rem; font-weight: 900; color: var(--gold-text); letter-spacing: 1px; word-break: break-all;">
                            {{ r.vin_dna }}
                            {% if (r.shield_reservoir or 0) <= 0 %}<span class="inert-tag">🚨 INACTIVE</span>{% endif %}
                        </div>
                        <div style="font-family: 'Courier Prime', monospace; font-size: 0.75rem; color: var(--text-main); margin-top: 5px; font-weight: bold; text-transform: uppercase;">
                            {{ r.vehicle_year if r.vehicle_year and r.vehicle_year != 'None' else '' }} {{ r.vehicle_make if r.vehicle_make and r.vehicle_make != 'None' else '' }} {{ r.vehicle_model if r.vehicle_model and r.vehicle_model != 'None' else 'UNKNOWN VEHICLE' }}
                        </div>
                        <div style="font-family: 'Montserrat', sans-serif; font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; margin-top: 5px;">🔑 PIN: {{ r.sovereign_key }}</div>

                        {% set base_health = ((r.calculated_integrity | default(0.85)) * 100)|int %}
                        {% set final_health = 85 if ns_parts.needs_order and base_health > 85 else base_health %}
                        <div style="margin-top: 5px; font-size: 0.7rem; font-family: 'Courier Prime', monospace; font-weight: bold; color: {% if final_health >= 90 %}var(--integrity-green){% else %}var(--critical-red){% endif %};">
                            ACCOUNT HEALTH: {{ final_health }}%
                        </div>

                        <div style="font-size: 0.65rem; color: var(--text-main); background: var(--input-bg); padding: 8px; border-radius: 2px; margin-top: 10px; border: 1px dashed var(--border-ui); position: relative;">
                            <div style="color: var(--text-main); font-weight: 900; font-family: 'Montserrat'; font-size: 0.8rem; margin-bottom: 5px; text-transform: uppercase;">
                                {{ r.member_name or 'UNNAMED MEMBER' }}
                            </div>
                            <div style="font-size: 0.6rem; color: var(--text-muted);">
                                📞 {{ r.member_phone or '00000000' }}
                            </div>
                            <div style="font-size: 0.65rem; color: var(--sanctified-blue); font-weight: 900; margin-top: 5px; text-transform: uppercase;">
                                🏢 {{ r.corporate_cohort or 'INDIVIDUAL CLIENT' }}
                            </div>
                        </div>
                    </div>

                    <div style="background: var(--panel-bg); padding: 12px; border-radius: 2px; border: 1px solid var(--border-ui); text-align: center;">
                        <div style="display: flex; gap: 10px; font-family: 'Courier Prime', monospace; font-size: 0.75rem; justify-content: center; align-items: center;">
                            <span onclick="toggleActionPanel('edit_form_{{ r.id }}')" style="color: var(--integrity-gold); cursor: pointer; font-weight: bold; transition: 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--integrity-gold)'">EDIT</span>
                            <span style="color: var(--border-ui);">|</span>
                            <span onclick="toggleActionPanel('transfer_form_{{ r.id }}')" style="color: var(--integrity-gold); cursor: pointer; font-weight: bold; transition: 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--integrity-gold)'">TRANSFER</span>
                            <span style="color: var(--border-ui);">|</span>
                            <span onclick="toggleActionPanel('override_form_{{ r.id }}')" style="color: var(--critical-red); cursor: pointer; font-weight: bold; transition: 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--critical-red)'">OVERRIDE</span>
                            <span style="color: var(--border-ui);">|</span>

                        </div>
                    </div>

                    <form id="form_edit_{{ r.id }}" action="{{ url_for('hangar.edit_asset', asset_id=r.id) }}" method="POST">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="entry_id" value="{{ r.id }}">
                    </form>

                    <div id="edit_form_{{ r.id }}" class="action-panel" style="display: none;">
                        <input type="text" form="form_edit_{{ r.id }}" name="member_name" class="edit-input" value="{{ r.member_name or '' }}" placeholder="Name">
                        <input type="text" form="form_edit_{{ r.id }}" name="member_phone" class="edit-input" value="{{ r.member_phone or '' }}" placeholder="Phone">
                        <input type="email" form="form_edit_{{ r.id }}" name="member_email" class="edit-input" value="{{ r.member_email or '' }}" placeholder="Email">
                        <input type="text" form="form_edit_{{ r.id }}" name="corporate_cohort" class="edit-input" value="{{ r.corporate_cohort or '' }}" placeholder="Corporate Cohort" style="border-color: var(--sanctified-blue);">

                        <select form="form_edit_{{ r.id }}" name="funding_method" class="edit-input" style="border-color: var(--integrity-green);">
                            <option value="PAYROLL > Corporate Payroll Deduction" {% if r.funding_method == 'PAYROLL > Corporate Payroll Deduction' or not r.funding_method %}selected{% endif %}>PAYROLL > Corporate Payroll Deduction</option>
                            <option value="DIRECT > Cash / EFT" {% if r.funding_method == 'DIRECT > Cash / EFT' %}selected{% endif %}>DIRECT > Cash / EFT (Legacy)</option>
                        </select>

                        <input type="text" form="form_edit_{{ r.id }}" name="vehicle_year" class="edit-input" value="{{ r.vehicle_year or '' }}" placeholder="Year">
                        <input type="text" form="form_edit_{{ r.id }}" name="vehicle_make" class="edit-input" value="{{ r.vehicle_make or '' }}" placeholder="Make">
                        <input type="text" form="form_edit_{{ r.id }}" name="vehicle_model" class="edit-input" value="{{ r.vehicle_model or '' }}" placeholder="Model">

                        <select form="form_edit_{{ r.id }}" name="vehicle_class" class="edit-input">
                            <option value="A" {% if r.vehicle_class == 'A' %}selected{% endif %}>Class A</option>
                            <option value="B" {% if r.vehicle_class == 'B' %}selected{% endif %}>Class B</option>
                            <option value="C" {% if r.vehicle_class == 'C' %}selected{% endif %}>Class C</option>
                        </select>

                        <input type="text" form="form_edit_{{ r.id }}" name="fleet_pin" class="edit-input" value="{{ r.fleet_pin or '' }}" placeholder="Set 4-Digit PIN">
                        <input type="number" form="form_edit_{{ r.id }}" step="0.01" name="target_repair_cost" class="edit-input" value="{{ r.target_repair_cost or '' }}" placeholder="Repair Cost">

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <button type="submit" form="form_edit_{{ r.id }}" style="background-color: var(--sanctified-blue); color: white; border: none; padding: 8px; font-size: 0.7rem; font-weight: bold; cursor: pointer; border-radius: 2px;">SAVE</button>
                            <button type="button" onclick="toggleActionPanel('edit_form_{{ r.id }}')" style="background-color: transparent; color: var(--text-muted); border: 1px dashed var(--border-ui); padding: 8px; font-size: 0.7rem; font-weight: bold; cursor: pointer; border-radius: 2px;">CANCEL</button>
                        </div>
                    </div>

                    <div id="transfer_form_{{ r.id }}" class="action-panel">
                        <form action="{{ url_for('hangar.execute_transfer', entry_id=r.id) }}" method="POST" onsubmit="return confirm('⚠️ INITIATE SMART CONTRACT TRANSFER?');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="entry_id" value="{{ r.id }}">
                            <input type="email" name="buyer_email" class="edit-input" placeholder="Buyer's Email" required style="margin-bottom: 5px;">
                            <input type="text" name="new_phone" class="edit-input" placeholder="Buyer's Phone" required style="margin-bottom: 10px;">
                            <div style="display: grid; grid-template-columns: 1fr; gap: 10px;">
                                <button type="submit" style="background-color: var(--integrity-gold); color: black; border: 1px solid var(--integrity-gold); padding: 10px 20px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: 0.2s; font-size: 0.7rem; border-radius: 2px;">TRANSFER OWNERSHIP</button>
                                <button type="button" onclick="toggleActionPanel('transfer_form_{{ r.id }}')" style="background-color: transparent; color: var(--text-muted); border: 1px dashed var(--border-ui); padding: 8px; font-family: 'Montserrat', sans-serif; font-weight: 700; text-transform: uppercase; cursor: pointer; font-size: 0.7rem; border-radius: 2px;">CANCEL</button>
                            </div>
                        </form>
                    </div>

                    <div id="override_form_{{ r.id }}" class="action-panel" style="border-color: var(--critical-red);">
                        <div style="font-family: 'Montserrat', sans-serif; font-size: 0.65rem; color: var(--critical-red); font-weight: 900; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; text-align: center;">⚠️ Master Status Override</div>
                        <form action="{{ url_for('hangar.override_asset') }}" method="POST" style="margin-bottom: 10px;" onsubmit="return confirm('Force Approve this asset?');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="entry_id" value="{{ r.id }}">
                            <input type="hidden" name="status" value="APPROVED">
                            <button type="submit" style="width: 100%; background: var(--integrity-green); color: black; border: 1px solid var(--integrity-green); padding: 8px; font-family: 'Montserrat'; font-size: 0.65rem; font-weight: 900; cursor: pointer; text-transform: uppercase; border-radius: 2px;">🟢 FORCE APPROVE / REVIVE</button>
                        </form>
                        <form action="{{ url_for('hangar.override_asset') }}" method="POST" style="margin-bottom: 10px;" onsubmit="return confirm('Force Reject this asset?');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="entry_id" value="{{ r.id }}">
                            <input type="hidden" name="status" value="REJECTED">
                            <button type="submit" style="width: 100%; background: var(--critical-red); color: white; border: 1px solid var(--critical-red); padding: 8px; font-family: 'Montserrat'; font-size: 0.65rem; font-weight: 900; cursor: pointer; text-transform: uppercase; border-radius: 2px;">🔴 FORCE REJECT</button>
                        </form>
                        <button type="button" onclick="toggleActionPanel('override_form_{{ r.id }}')" style="width: 100%; background-color: transparent; color: var(--text-muted); border: 1px dashed var(--border-ui); padding: 8px; font-family: 'Montserrat'; font-size: 0.65rem; font-weight: 900; cursor: pointer; text-transform: uppercase; border-radius: 2px;">CANCEL</button>
                    </div>

                    <div style="background: var(--input-bg); border: 1px solid var(--border-ui); padding: 15px; border-radius: 2px; border-top: 3px solid var(--whatsapp-green);">
                            <h4 style="font-size: 0.65rem; color: var(--text-main); text-transform: uppercase; margin: 0 0 15px 0; letter-spacing: 2px; text-align: center; font-family: 'Montserrat', sans-serif;">📱 Communication Center</h4>

                            <a href="{{ url_for('hangar.public_passport', vin_dna=r.vin_dna) }}" target="_blank" style="background-color: transparent; color: var(--gold-text); border: 1px solid var(--integrity-gold); padding: 8px 16px; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 0px; transition: 0.2s; font-size: 0.65rem; text-align: center; text-decoration: none; display: block; box-sizing: border-box; width: 100%; margin-bottom: 5px;" onmouseover="this.style.background='rgba(197, 160, 89, 0.1)'" onmouseout="this.style.background='transparent'">🌐 VIEW PUBLIC PASSPORT</a>
                            <a href="{{ url_for('hangar.client_dossier', vin_dna=r.vin_dna, source='ledger') }}" target="_blank" style="background-color: transparent; color: var(--sanctified-blue); border: 1px solid var(--sanctified-blue); padding: 8px 16px; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 0px; transition: 0.2s; font-size: 0.65rem; text-align: center; text-decoration: none; display: block; box-sizing: border-box; width: 100%; margin-bottom: 10px;" onmouseover="this.style.background='rgba(0, 51, 102, 0.2)'" onmouseout="this.style.background='transparent'">📂 CLIENT DOSSIER</a>
                            <a href="{{ url_for('hangar.client_vault', asset_id=r.vin_dna) }}" target="_blank" style="background-color: var(--sanctified-blue); color: white; border: 1px solid var(--sanctified-blue); padding: 8px 16px; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 0px; transition: 0.2s; font-size: 0.65rem; text-align: center; text-decoration: none; display: block; box-sizing: border-box; width: 100%; margin-bottom: 10px;">👁️ PREVIEW VAULT</a>

                            {% if r.member_phone %}
                            <a href="{{ url_for('hangar.master_fleet_dashboard', client_phone=r.member_phone | replace(' ', '') | replace('+', '')) }}" target="_blank" style="background: var(--sanctified-blue); border: 1px solid var(--integrity-gold); color: white; width: 100%; display: block; text-align: center; padding: 10px; font-size: 0.65rem; margin-top: 5px; margin-bottom: 10px; font-family: 'Montserrat', sans-serif; font-weight: 600; box-sizing: border-box; text-decoration: none; text-transform: uppercase; border-radius: 2px;">🛡️ VIEW BUSINESS DASHBOARD</a>
                            {% endif %}

                            <a href="{{ url_for('hangar.dispatch_covenant_whatsapp', asset_id=r.id) }}" target="_blank" class="btn-whatsapp" style="background: var(--integrity-gold); border: 1px solid var(--integrity-gold); color: black; margin-bottom: 10px; width: 100%; display: block; padding: 10px; font-weight: 900; cursor: pointer; text-align: center; text-decoration: none; box-sizing: border-box; text-transform: uppercase; border-radius: 2px; font-size: 0.65rem;">📜 SEND COVENANT VIA WHATSAPP</a>
                            <button onclick="blastStatement('{{ r.id }}', '{{ r.member_phone }}', '{{ r.vin_dna }}')" class="btn-whatsapp" style="background: var(--sanctified-blue); border: 1px solid var(--integrity-gold); color: white; margin-bottom: 5px; width: 100%; display: block; padding: 10px; font-weight: 900; cursor: pointer; box-sizing: border-box; text-transform: uppercase; border-radius: 2px; font-size: 0.65rem;">📄 WHATSAPP STATEMENT</button>

                            <form action="{{ url_for('hangar.dispatch_single_email', doc_type='STATEMENT', entry_id=r.id) }}" method="POST" onsubmit="return confirm('📧 Blast official Statement PDF to {{ r.member_email or "Client" }}?');" style="margin-bottom: 5px;">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" style="background-color: transparent; color: var(--text-main); border: 1px dashed var(--border-ui); padding: 8px 16px; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: 0.2s; font-size: 0.6rem; width: 100%; box-sizing: border-box; border-radius: 2px;">📧 EMAIL STATEMENT</button>
                            </form>

                            {% if safe_status == 'APPROVED' %}
                            <form action="{{ url_for('hangar.dispatch_single_email', doc_type='INVOICE', entry_id=r.id) }}" method="POST" onsubmit="return confirm('📧 Blast Final Invoice PDF to {{ r.member_email or "Client" }}?');" style="margin-bottom: 10px;">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit" style="background-color: transparent; color: var(--gold-text); border: 1px dashed var(--integrity-gold); padding: 8px 16px; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: 0.2s; font-size: 0.6rem; width: 100%; box-sizing: border-box; border-radius: 2px;">📧 EMAIL FINAL INVOICE</button>
                            </form>
                            {% endif %}

                            <a href="{{ url_for('hangar.dispatch_whatsapp', asset_id=r.id) }}?msg=welcome" target="_blank" style="display: block; text-align: center; font-size: 0.55rem; padding: 6px; margin-bottom: 5px; border: 1px solid var(--border-ui); background: transparent; color: var(--text-main); text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; box-sizing: border-box; border-radius: 2px;">💬 SEND WELCOME MESSAGE</a>
                            <a href="{{ url_for('hangar.dispatch_whatsapp', asset_id=r.id) }}?msg=status" target="_blank" style="display: block; text-align: center; font-size: 0.55rem; padding: 6px; margin-bottom: 5px; border: 1px solid var(--sanctified-blue); background: transparent; color: var(--sanctified-blue); text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; box-sizing: border-box; border-radius: 2px;">💬 SEND STATUS UPDATE</a>
                            <a href="{{ url_for('hangar.dispatch_whatsapp', asset_id=r.id) }}?msg=warning" target="_blank" style="display: block; text-align: center; font-size: 0.55rem; padding: 6px; margin-top: 5px; border: 1px solid var(--critical-red); background: transparent; color: var(--critical-red); text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; box-sizing: border-box; border-radius: 2px;">🚨 SEND INACTIVE WARNING</a>
                            <a href="{{ url_for('hangar.dispatch_whatsapp', asset_id=r.id) }}?msg=statement" target="_blank" style="display: block; text-align: center; font-size: 0.55rem; padding: 6px; margin-top: 5px; border: 1px solid var(--border-ui); background: transparent; color: var(--text-main); text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; box-sizing: border-box; border-radius: 2px;">💬 SEND ACCOUNT STATEMENT</a>
                            <a href="{{ url_for('hangar.dispatch_whatsapp', asset_id=r.id) }}?msg=invoice" target="_blank" style="display: block; text-align: center; font-size: 0.55rem; padding: 6px; margin-top: 5px; border: 1px solid var(--integrity-gold); background: transparent; color: var(--integrity-gold); text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 600; text-transform: uppercase; box-sizing: border-box; border-radius: 2px;">💬 SEND FINAL INVOICE</a>
                    </div>

                    <div style="background: rgba(197, 160, 89, 0.05); border: 1px dashed var(--integrity-gold); padding: 15px; border-radius: 2px; margin-top: 15px; display: flex; flex-direction: column; gap: 10px; width: 100%; box-sizing: border-box; min-width: 0;">
                        <div style="font-family: 'Montserrat', sans-serif; font-size: 0.65rem; color: var(--gold-text); font-weight: 900; text-transform: uppercase; text-align: center; letter-spacing: 1px;">⚡ Command Actions</div>

                        <a href="{{ url_for('hangar.client_vault', asset_id=r.vin_dna) }}"
                           onclick="window.location.href=this.href; return false;"
                           style="background-color: #050505; color: var(--integrity-gold); border: 1px solid var(--integrity-gold); font-weight: bold; text-transform: uppercase; padding: 10px; border-radius: 2px; cursor: pointer; text-align: center; text-decoration: none; transition: 0.3s; width: 100%; box-sizing: border-box; font-size: 0.75rem;"
                           onmouseover="this.style.background='var(--integrity-gold)'; this.style.color='#000';"
                           onmouseout="this.style.background='#050505'; this.style.color='var(--integrity-gold)';">
                        📂 OPEN FULL LEDGER
                        </a>

                       <form action="{{ url_for('treasury.process_vault_pulse', asset_id=r.id) }}" method="POST" style="display: flex; gap: 5px; width: 100%; box-sizing: border-box;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <input type="number" name="deposit_amount" placeholder="Inject (P)" required style="flex: 1; min-width: 0; padding: 8px; background: #111; color: #fff; border: 1px solid var(--integrity-gold); font-family: 'Courier Prime', monospace; font-size: 0.8rem; box-sizing: border-box; border-radius: 2px;">
    <button type="submit" style="background: var(--integrity-gold); color: #000; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; border: none; padding: 8px 12px; cursor: pointer; border-radius: 2px; transition: 0.3s;" onmouseover="this.style.filter='brightness(1.2)'" onmouseout="this.style.filter='brightness(1)'">INJECT</button>
</form>

                        <form action="{{ url_for('hangar.process_repair_deduction', asset_id=r.id) }}" method="POST" style="display: flex; gap: 5px; width: 100%; box-sizing: border-box; margin-top: 5px;" onsubmit="return confirm('Deduct from Shield Reservoir?');">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="number" name="deduct_amount" placeholder="Extract (P)" required style="flex: 1; min-width: 0; padding: 8px; background: #111; color: var(--critical-red); border: 1px solid var(--critical-red); font-family: 'Courier Prime', monospace; font-size: 0.8rem; box-sizing: border-box; border-radius: 2px;">
                            <button type="submit" style="background: transparent; color: var(--critical-red); border: 1px solid var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.7rem; padding: 8px 12px; cursor: pointer; border-radius: 2px; transition: 0.3s;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='var(--critical-red)';">DEDUCT</button>
                        </form>
                    </div>

                    {% if r.agent_bounty_locked and r.agent_bounty_locked > 0 %}
                    <div class="escrow-locked-badge" style="text-align: center;">🔒 BOUNTY ESCROWED: P{{ "{:,.2f}".format(r.agent_bounty_locked or 0) }}</div>
                    {% endif %}
                </div>

                <div style="grid-column: 2 / span 5; display: flex; flex-direction: column; gap: 10px;">
                    <div style="background: var(--integrity-white); color: black; padding: 4px 8px; font-weight: 900; font-size: 0.7rem; display: inline-block; font-family: 'Courier Prime', monospace; width: fit-content;">ACCOUNT #{{ r.id }}</div>

                    <div class="asset-inner-grid">

                        <div class="asset-inner-col">

                            <div style="background: var(--input-bg); border: 1px solid var(--border-ui); border-left: 4px solid var(--integrity-gold); border-radius: 4px; padding: 15px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 10px; margin-bottom: 10px;">
                                    <span style="font-family: 'Montserrat'; font-size: 0.75rem; color: var(--gold-text); font-weight: bold; letter-spacing: 1px; text-transform: uppercase;">Sovereign Account Balance & 60/40 Split</span>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px;">
                                    <div>
                                        <div style="font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase; display: flex; justify-content: space-between;">Maintenance (40%)</div>
                                        <div style="font-size: 1.2rem; font-family: 'Courier Prime'; font-weight: bold; color: var(--text-main);">P{{ "{:,.2f}".format(r.shield_reservoir or 0) }}</div>
                                        <div style="width: 100%; height: 3px; background: var(--border-ui); margin-top: 5px;">
                                            <div style="width: {% if r.shield_reservoir > 0 %}100%{% else %}0%{% endif %}; height: 100%; background: var(--integrity-gold);"></div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase;">Savings (60%)</div>
                                        <div style="font-size: 1.2rem; font-family: 'Courier Prime'; font-weight: bold; color: var(--integrity-green);">P{{ "{:,.2f}".format(r.savings_balance or 0) }}</div>
                                        <div style="width: 100%; height: 3px; background: var(--border-ui); margin-top: 5px;">
                                            <div style="width: 100%; height: 100%; background: var(--integrity-green);"></div>
                                        </div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase;">Interest Earned</div>
                                        <div style="font-size: 1.2rem; font-family: 'Courier Prime'; font-weight: bold; color: var(--integrity-green);">+P{{ "{:,.2f}".format(r.yield_interest or 0) }}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-metric-row" style="display: flex; justify-content: space-between; margin-top: 10px; font-family: 'Courier Prime', monospace;">
                                <div class="metric-label" style="color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase;">Utility Standing</div>
                                <div class="metric-value" style="color: var(--integrity-gold); font-weight: bold; font-size: 0.8rem;">
                                    {{ "{:,.2f}".format(r.lvt_balance or 0) }} LVT
                                </div>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                {% if safe_status == 'AWAITING PAYMENT' %}
                                    <div style="display: inline-block; background-color: rgba(255, 68, 68, 0.1); border-left: 4px solid var(--critical-red); color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; padding: 6px 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box; text-align: left;">⚠️ AWAITING PAYMENT</div>
                                {% elif 'AWAITING PROCUREMENT' in safe_status %}
                                    <div style="display: inline-block; background-color: rgba(255, 68, 68, 0.1); border-left: 4px solid var(--critical-red); color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; padding: 6px 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box; text-align: left; animation: critical-blink 2s infinite;">🚨 ORDER PARTS NOW</div>
                                {% elif 'EMERGENCY' in safe_status %}
                                    <div style="display: flex; flex-direction: column; gap: 8px; background-color: rgba(255, 0, 0, 0.05); border: 1px solid var(--critical-red); border-left: 4px solid var(--critical-red); border-right: 4px solid var(--critical-red); padding: 15px; margin-bottom: 10px; width: 100%; box-sizing: border-box; position: relative; animation: sentinel-pulse 1.5s infinite;">
                                        <h4 style="color: var(--critical-red); margin: 0 0 8px 0; font-size: 0.75rem; text-transform: uppercase; font-family:'Montserrat'; letter-spacing: 1px; text-align: center;">🗺️ MAYDAY BEACON LOCATION</h4>
                                        {% if r.gps_link and r.gps_link not in ['GPS UNAVAILABLE', 'GPS NOT SUPPORTED', 'COORDINATES_UNAVAILABLE'] %}
                                            <a href="{{ r.gps_link }}" target="_blank" style="display: block; background: rgba(255, 0, 0, 0.1); border: 1px solid var(--critical-red); border-left: 5px solid var(--critical-red); color: var(--critical-red); padding: 10px; text-align: center; font-family: 'Courier Prime', monospace; text-decoration: none; border-radius: 2px; margin-bottom: 10px; transition: 0.3s;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='#fff';" onmouseout="this.style.background='rgba(255,0,0,0.1)'; this.style.color='var(--critical-red)';">📍 SATELLITE LOCK: {{ r.gps_link }}<br><span style="font-size: 0.7rem; font-weight: bold; color: #fff;">[ CLICK TO OPEN MAP ]</span></a>
                                        {% else %}
                                            <div style="background: var(--input-bg); color: var(--text-muted); padding: 10px; text-align: center; border: 1px dashed var(--critical-red); border-radius: 2px; font-family: 'Courier Prime'; font-size: 0.65rem; margin-bottom: 10px;">[ 📡 GPS SIGNAL PENDING ]</div>
                                        {% endif %}
                                        <form action="{{ url_for('hangar.override_asset') }}" method="POST">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                            <input type="hidden" name="entry_id" value="{{ r.id }}">
                                            <input type="hidden" name="status" value="APPROVED">
                                            <button type="submit" style="width: 100%; background: var(--critical-red); color: white; border: 1px solid var(--critical-red); padding: 10px 20px; font-family: 'Montserrat', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 0px; transition: 0.2s; font-size: 0.65rem; text-align: center;">🕵️‍♂️ DISPATCH AGENT & RESOLVE</button>
                                        </form>
                                    </div>
                                {% elif 'FAIL' in safe_status %}
                                    <div style="display: inline-block; background-color: rgba(255, 68, 68, 0.1); border-left: 4px solid var(--critical-red); color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; padding: 6px 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box; text-align: left;">🛑 INSPECTION FAILED</div>
                                    {% set clean_phone = r.member_phone|replace(' ', '')|replace('+', '') if r.member_phone else '' %}
                                    <a href="https://wa.me/{{ clean_phone }}?text=%F0%9F%9A%A8%20*LAVETO%20COMMAND%3A*%20Vehicle%20triage%20is%20complete.%20Action%20required.%0A%0AAccess%20your%20Secure%20Vault%20immediately%20to%20review%20your%20Sovereign%20Diagnostics%20and%20authorize%20the%20repair%20mandate.%0A%0ALink%3A%20https%3A%2F%2Flaveto.net%2Fvault%2F{{ r.vin_dna }}" target="_blank" style="background: var(--warning-orange); color: black; border: 1px solid var(--warning-orange); width: 100%; display: block; text-align: center; text-decoration: none; padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; text-transform: uppercase; border-radius: 2px; margin-bottom: 10px; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">📲 PING MEMBER FOR AUTHORIZATION</a>
                                {% else %}
                                    <div style="display: inline-block; background-color: rgba(0, 51, 102, 0.1); border-left: 4px solid var(--sanctified-blue); color: var(--text-main); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; padding: 6px 12px; margin-bottom: 10px; width: 100%; box-sizing: border-box; text-align: left;">{{ r.status }}</div>
                                {% endif %}
                            </div>

                            {% if r.initial_notes %}
                            <div style="margin-bottom: 10px; padding: 15px; background: rgba(0, 51, 102, 0.1); border: 1px dashed var(--sanctified-blue); border-radius: 2px;">
                                <span style="font-size: 0.6rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">Initial Report:</span><br>
                                <span style="font-size: 0.8rem; color: var(--text-main); font-family: 'Courier Prime', monospace;">{{ r.initial_notes }}</span>
                            </div>
                            {% endif %}

                            <div style="font-size: 0.65rem; color: var(--gold-text); font-family: 'Courier Prime', monospace; font-weight: bold; border: 1px solid var(--integrity-gold); padding: 2px 6px; border-radius: 2px; display: inline-block; margin-bottom: 10px;">CLASS {{ r.vehicle_class or 'B' }}</div>

                           {% if ns_parts.needs_order %}
                                    <div style="background-color: rgba(255, 68, 68, 0.05); border: 1px dashed var(--critical-red); padding: 15px; margin-top: 15px; margin-bottom: 10px; border-radius: 4px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,0,0,0.2); padding-bottom: 10px; margin-bottom: 10px;">
                                            <span style="color: var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; animation: critical-blink 2s infinite;">
                                                🛒 PROCUREMENT REQUIRED
                                            </span>
                                        </div>

                                        <div style="margin-bottom: 15px;">
                                            <div style="font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase; margin-bottom: 5px;">Awaiting Silk Road Procurement:</div>
                                            <ul style="margin: 0; padding-left: 15px; font-family: 'Inter', sans-serif; font-size: 0.75rem; color: var(--text-main);">
                                                {% for ghost in r.ghost_orders %}
                                                    {% if ghost.status in ['PENDING ORDER', 'FUNDS CLEARED', 'AWAITING PAYMENT'] %}
                                                        <li style="margin-bottom: 4px;">
                                                            <strong>{{ ghost.component_name }}</strong>
                                                            <span style="color: #ff9999; font-size: 0.65rem; font-family: 'Courier Prime'; margin-left: 5px;">[{{ ghost.status }}]</span>
                                                        </li>
                                                    {% endif %}
                                                {% endfor %}
                                            </ul>
                                        </div>

                                        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                            <a href="{{ url_for('hangar.silk_road') }}?vin={{ r.vin_dna }}" style="flex: 2; background-color: var(--critical-red); color: white; border: 1px solid var(--critical-red); padding: 10px; text-align: center; text-decoration: none; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; border-radius: 2px; font-size: 0.7rem; transition: 0.3s; box-shadow: 0 4px 15px rgba(255, 0, 0, 0.2);" onmouseover="this.style.background='#cc0000'" onmouseout="this.style.background='var(--critical-red)'">
                                                🌍 OPEN SILK ROAD TERMINAL
                                            </a>

                                            <form action="{{ url_for('hangar.override_asset') }}" method="POST" style="flex: 1; margin: 0;" onsubmit="return confirm('Bypass Silk Road and mark all parts for this vehicle as ordered locally?');">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="entry_id" value="{{ r.id }}">
                                                <input type="hidden" name="status" value="LOCKED (WAITING PARTS)">
                                                <button type="submit" style="width: 100%; height: 100%; background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; border-radius: 2px; font-size: 0.7rem; cursor: pointer; transition: 0.3s;" onmouseover="this.style.background='rgba(255,0,0,0.1)'" onmouseout="this.style.background='transparent'">
                                                    ✅ MARK ORDERED
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                {% endif %}

                            {% if safe_status not in ['REJECTED', 'INSPECTION REJECTED'] %}
                                {% set repair_cost = r.target_repair_cost or 0 %}
                                {% set current_funds = r.shield_reservoir or 0 %}
                                {% set deficit = repair_cost - current_funds %}
                                {% set is_funded = deficit <= 0 %}
                                {% set is_zeroed = repair_cost == 0 %}

                                <div style="background: {% if is_zeroed or is_funded %}rgba(40, 167, 69, 0.05){% else %}rgba(255, 68, 68, 0.05){% endif %}; border: 1px solid {% if is_zeroed or is_funded %}var(--integrity-green){% else %}var(--critical-red){% endif %}; border-left: 4px solid {% if is_zeroed or is_funded %}var(--integrity-green){% else %}var(--critical-red){% endif %}; padding: 15px; border-radius: 2px;">
                                    <h4 style="color: {% if is_zeroed or is_funded %}var(--integrity-green){% else %}var(--critical-red){% endif %}; margin: 0 0 8px 0; font-size: 0.75rem; text-transform: uppercase; font-family:'Montserrat'; letter-spacing: 1px;">
                                        {% if is_zeroed %}✅ FUNDS EXTRACTED & ZEROED{% elif is_funded %}🛡️ REPAIR FUNDED & SECURED{% else %}🩸 REPAIR REQUIRED{% endif %}
                                    </h4>
                                    <div style="background: var(--input-bg); padding: 10px; border-radius: 2px; border: 1px dashed {% if is_zeroed or is_funded %}var(--integrity-green){% else %}var(--critical-red){% endif %}; text-align:center;">
                                        <span style="font-family: 'Courier Prime', monospace; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.5px; color: {% if is_zeroed %}var(--text-muted){% elif is_funded %}var(--integrity-green){% else %}var(--critical-red){% endif %}; font-size: 1.4rem;">P{{ "{:,.2f}".format(repair_cost or 0) }}</span>
                                    </div>
                                </div>

                                {% if is_zeroed %}
                                <form action="{{ url_for('hangar.approve_audit', asset_id=r.id) }}" method="POST" style="width: 100%; margin-top: 10px;" onsubmit="return confirm('Green-light repairs and dispatch to Silk Road?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="entry_id" value="{{ r.id }}">
                                    <input type="hidden" name="status" value="APPROVED">
                                    <button type="submit" style="width: 100%; background-color: var(--integrity-green); color: black; border: none; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 2px; padding: 12px; font-size: 0.75rem; transition: 0.3s; box-shadow: 0 0 15px rgba(40, 167, 69, 0.5);" onmouseover="this.style.background='#218838'" onmouseout="this.style.background='var(--integrity-green)'">🟢 GREEN-LIGHT: DISPATCH TO SILK ROAD</button>
                                </form>
                                {% elif deficit > 0 %}
                                <form action="{{ url_for('hangar.deduct_repairs') }}" method="POST" style="margin-top: 10px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="vin" value="{{ r.vin_dna }}">
                                    <input type="hidden" name="amount" value="{{ repair_cost or 0 }}">
                                    <button type="submit" style="background-color: var(--sanctified-blue); color: var(--text-main); border: 1px solid var(--sanctified-blue); padding: 10px; font-weight: 700; width: 100%; cursor: pointer; border-radius: 2px;">DEDUCT REPAIRS</button>
                                </form>
                                {% endif %}
                            {% endif %}

                            {% set loan_principal = r.active_loan_principal or 0 %}
                            {% set v_class = (r.vehicle_class or 'B')|upper %}
                            {% set base_fee = 100 if v_class == 'A' else 200 if v_class == 'C' else 150 %}
                            {% set total_monthly_due = base_fee %}

                            {% if loan_principal > 0 %}
                                {% set r_rate = 0.01 %}
                                {% set n_months = 24 if loan_principal >= 15000 else 6 %}
                                {% set x_val = (1 + r_rate) ** n_months %}
                                {% set amortized_payment = (loan_principal * x_val * r_rate) / (x_val - 1) %}
                                {% set total_monthly_due = base_fee + amortized_payment %}
                            {% endif %}

                            <div style="background: rgba(197, 160, 89, 0.03); border: 1px solid var(--integrity-gold); border-top: 3px solid var(--integrity-gold); border-radius: 4px; padding: 15px; margin-top: 15px; box-shadow: 0 5px 15px rgba(197,160,89,0.05);">
                                <h4 style="margin: 0 0 15px 0; color: var(--gold-text); font-family: 'Montserrat'; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; display: flex; justify-content: space-between; align-items: center;">
                                    <span>🏦 Vault Financials</span>
                                    {% if r.active_loan_principal and r.active_loan_principal > 0 %}
                                        <span style="color: var(--critical-red); font-family: 'Courier Prime'; font-size: 0.7rem;">DEBT: P{{ "{:,.2f}".format(r.active_loan_principal) }}</span>
                                    {% else %}
                                        <span style="color: var(--integrity-green); font-family: 'Courier Prime'; font-size: 0.7rem;">DEBT: ZERO</span>
                                    {% endif %}
                                </h4>

                                <div style="margin-bottom: 15px; background: var(--input-bg); border: 1px dashed var(--integrity-gold); padding: 12px; font-family: 'Courier Prime', monospace; border-radius: 2px;">
                                    <div style="font-size: 0.65rem; color: var(--integrity-gold); font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                                        MONTHLY MOTSHELO PULSE
                                    </div>

                                    {% set initial_laveto_fee = (total_monthly_due * 0.05) %}
                                    {% set initial_net = (total_monthly_due * 0.95) %}

                                    <div id="total-display_{{ r.id }}" style="font-size: 1.6rem; color: var(--text-main); font-weight: 900; margin: 5px 0;">P{{ "{:,.2f}".format(total_monthly_due) }}</div>

                                    <div style="margin-top: 10px; font-size: 0.65rem; color: var(--text-muted);">
                                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                                            <span>LAVETO NETWORK FEE (5%):</span>
                                            <span id="fee-display_{{ r.id }}" style="color: var(--critical-red);">P{{ "{:,.2f}".format(initial_laveto_fee) }}</span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between;">
                                            <span>NET TO MECHANICAL EQUITY:</span>
                                            <span id="net-display_{{ r.id }}" style="color: var(--integrity-green); font-weight: bold;">P{{ "{:,.2f}".format(initial_net) }}</span>
                                        </div>
                                    </div>

                                    {% if loan_principal > 0 %}
                                        <div style="font-size: 0.6rem; color: var(--text-muted); margin-top: 8px; border-top: 1px dashed rgba(255,255,255,0.1); padding-top: 6px; font-style: italic;">
                                            * Base Tier + Amortized M2M loan (Principal & Interest).
                                        </div>
                                    {% else %}
                                        <div style="font-size: 0.6rem; color: var(--integrity-green); margin-top: 8px; border-top: 1px dashed rgba(255,255,255,0.1); padding-top: 6px; font-weight: bold;">
                                            * 95% of contribution cleanly committed to Personal Reservoir.
                                        </div>
                                    {% endif %}
                                </div>

                                <form action="{{ url_for('hangar.process_payment', entry_id=r.id) }}" method="POST" id="payForm_{{ r.id }}" style="margin: 0;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                        <input type="number" step="0.01" name="payment_amount" id="pledge-input_{{ r.id }}" oninput="updateLavetoMath('{{ r.id }}')" placeholder="Payment Received (P)" value="{{ '{:.2f}'.format(total_monthly_due or 0) }}" required style="flex: 1.5; min-width: 120px; margin: 0; font-size: 0.8rem; padding: 10px; background: var(--input-bg); color: var(--integrity-green); border: 1px solid var(--integrity-green); font-family: 'Courier Prime', monospace; border-radius: 2px;">
                                        <select name="payment_type" style="flex: 1; min-width: 120px; padding: 10px; background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-ui); border-radius: 2px; font-family: 'Courier Prime', monospace; font-size: 0.7rem; cursor: pointer; outline: none;">
                                            <option value="DEPOSIT">PLEDGE (DEPOSIT)</option>
                                            <option value="INTEREST">LOAN (INTEREST)</option>
                                        </select>
                                        <button type="submit" style="flex: 1; min-width: 120px; background: var(--integrity-green); color: black; border: none; font-weight: 900; font-family: 'Montserrat'; font-size: 0.7rem; border-radius: 2px; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 0 15px rgba(40, 167, 69, 0.4); transition: 0.3s;" onmouseover="this.style.background='#218838'" onmouseout="this.style.background='var(--integrity-green)'">PROCESS</button>
                                    </div>
                                </form>
                            </div>

                            {% if r.pending_loan_amount and r.pending_loan_amount > 0 %}
                            <div style="background: rgba(197, 160, 89, 0.1); border: 2px solid var(--integrity-gold); border-left: 6px solid var(--integrity-gold); padding: 15px; border-radius: 4px; animation: pulse-gold 2s infinite; margin-top: 15px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <h4 style="color: var(--gold-text); margin: 0; font-size: 0.8rem; text-transform: uppercase; font-family:'Montserrat'; letter-spacing: 1px;">🏦 LOAN REQUISITION</h4>
                                    <span style="font-family: 'Courier Prime'; font-size: 1.2rem; font-weight: bold; color: var(--text-main);">P{{ "{:,.2f}".format(r.pending_loan_amount or 0) }}</span>
                                </div>
                                {% set payload_parts = r.pending_loan_intent.split(' | ') if r.pending_loan_intent else [] %}
                                {% if payload_parts|length >= 4 %}
                                    {% set status_flag = payload_parts[0] %}
                                    {% set term_str = payload_parts[1] %}
                                    {% set pmt_str = payload_parts[2] %}
                                    {% set raw_intent = payload_parts[3] %}
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                                        <div style="background: var(--input-bg); padding: 8px; border-radius: 2px; border: 1px dashed var(--border-ui);">
                                            <div style="font-size: 0.55rem; color: var(--text-muted); text-transform: uppercase; font-family: 'Courier Prime';">Suggested Term</div>
                                            <div style="font-size: 0.85rem; color: var(--text-main); font-weight: bold;">{{ term_str }}</div>
                                        </div>
                                        <div style="background: var(--input-bg); padding: 8px; border-radius: 2px; border: 1px dashed var(--border-ui);">
                                            <div style="font-size: 0.55rem; color: var(--text-muted); text-transform: uppercase; font-family: 'Courier Prime';">Monthly (12%)</div>
                                            <div style="font-size: 0.85rem; color: var(--text-main); font-weight: bold;">{{ pmt_str }}</div>
                                        </div>
                                    </div>
                                    <div style="font-size: 0.75rem; font-family: 'Courier Prime'; margin-bottom: 10px; padding: 6px; border-radius: 2px; font-weight: bold; text-align: center; background: {% if '✅' in status_flag %}rgba(40,167,69,0.2){% else %}rgba(255,68,68,0.2){% endif %}; color: {% if '✅' in status_flag %}var(--integrity-green){% else %}var(--critical-red){% endif %}; border: 1px solid {% if '✅' in status_flag %}var(--integrity-green){% else %}var(--critical-red){% endif %};">
                                        {{ status_flag }}
                                    </div>
                                    <div style="font-size: 0.7rem; color: var(--text-muted); font-family: 'Inter'; font-style: italic;">"{{ raw_intent }}"</div>
                                {% else %}
                                    <p style="font-size: 0.75rem; color: var(--text-main); font-family: 'Courier Prime';">{{ r.pending_loan_intent }}</p>
                                {% endif %}
                                <div style="display: flex; gap: 10px; margin-top: 15px;">
                                    <a href="{{ url_for('hangar.loan_terminal') }}" style="flex: 1; background: var(--integrity-gold); color: black; border: none; padding: 10px; text-align: center; text-decoration: none; font-family: 'Montserrat'; font-weight: bold; font-size: 0.7rem; text-transform: uppercase; border-radius: 2px;">PROCESS IN TERMINAL</a>
                                    <form action="{{ url_for('hangar.reject_loan_request', entry_id=r.id) }}" method="POST" style="flex: 1;" onsubmit="return confirm('Reject this loan application?');">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <input type="hidden" name="entry_id" value="{{ r.id }}">
                                        <input type="hidden" name="status" value="LOAN REJECTED">
                                        <button type="submit" style="width: 100%; background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); padding: 10px; font-family: 'Montserrat'; font-weight: bold; font-size: 0.7rem; text-transform: uppercase; border-radius: 2px; cursor: pointer;">REJECT REQUEST</button>
                                    </form>
                                </div>
                            </div>
                            {% endif %}

                            {% if safe_status == 'COMPLIANCE REQUESTED' %}
                            <div style="background: rgba(102, 179, 255, 0.05); border: 2px solid #66b3ff; border-left: 6px solid #66b3ff; padding: 15px; border-radius: 4px; margin-top: 15px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <h4 style="color: #66b3ff; margin: 0; font-size: 0.8rem; text-transform: uppercase; font-family:'Montserrat'; letter-spacing: 1px;">🛡️ VIP CONCIERGE: RENEWAL</h4>
                                </div>
                                <p style="font-size: 0.7rem; color: var(--text-muted); font-family: 'Inter'; margin-bottom: 15px;">Enter the total cost (Laveto Fee + License Disc + Fines) to deduct from the client's Maintenance Fund.</p>
                                <form action="{{ url_for('hangar.resolve_compliance', entry_id=r.id) }}" method="POST" style="display: flex; gap: 10px;" onsubmit="return confirm('Confirm total deduction from client account?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="number" step="0.01" name="total_compliance_cost" placeholder="Total Cost (P)" required style="flex: 1; padding: 10px; background: var(--input-bg); color: #66b3ff; border: 1px solid #66b3ff; font-family: 'Courier Prime', monospace; font-weight: bold; border-radius: 2px; font-size: 0.8rem;">
                                    <button type="submit" style="flex: 2; background: #66b3ff; color: #000; border: none; padding: 10px; font-family: 'Montserrat'; font-weight: 900; text-transform: uppercase; cursor: pointer; border-radius: 2px; transition: 0.3s;">✅ DEDUCT & CLEAR</button>
                                </form>
                            </div>
                            {% endif %}

                            <div style="background: rgba(40, 167, 69, 0.05); border: 1px dashed var(--integrity-green); padding: 15px; border-radius: 2px; margin-top: 15px;">
                                <h4 style="margin: 0 0 10px 0; color: var(--integrity-green); font-family: 'Montserrat'; font-size: 0.75rem; text-transform: uppercase;">🤝 Authorize Agent Bounty</h4>
                                <form action="{{ url_for('hangar.authorize_bounty', entry_id=r.id) }}" method="POST" style="width: 100%;" onsubmit="return confirm('Authorize Escrow payout to this Agent?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <input type="text" name="target_warden_id" placeholder="ENTER AGENT ID (e.g. WARDEN-01)" required style="width: 100%; padding: 10px; margin-bottom: 10px; background: var(--input-bg); color: var(--integrity-gold); border: 1px solid var(--integrity-green); font-family: 'Courier Prime', monospace; font-weight: bold; text-align: center; text-transform: uppercase; box-sizing: border-box; border-radius: 2px;">
                                    <button type="submit" style="background: var(--integrity-green); color: black; padding: 12px 20px; font-weight: 900; border: none; border-radius: 2px; cursor: pointer; width: 100%; font-family: 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: 1px; transition: 0.3s;" onmouseover="this.style.background='#218838'" onmouseout="this.style.background='var(--integrity-green)'">✅ RELEASE BOUNTY</button>
                                </form>
                            </div>

                            <div style="background: rgba(197, 160, 89, 0.05); border: 1px dashed var(--integrity-gold); padding: 15px; border-radius: 2px; margin-top: 15px;">
                                <h4 style="margin: 0 0 10px 0; color: var(--gold-text); font-family: 'Montserrat'; font-size: 0.75rem; text-transform: uppercase; display: flex; justify-content: space-between; align-items: center;">
                                    <span>🔧 Disburse Labour Funds</span><span style="font-family: 'Courier Prime'; font-size: 0.6rem; color: var(--text-muted);">TREASURY OUTFLOW</span>
                                </h4>
                                <form action="#" method="POST" style="width: 100%;" onsubmit="alert('Manual Disbursement offline.'); return false;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                    <div style="display: flex; gap: 5px; margin-bottom: 8px;">
                                        <input type="text" name="workshop_name" placeholder="Workshop (e.g. G-West Auto)" required style="flex: 1.5; padding: 8px; background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-ui); font-family: 'Courier Prime', monospace; font-size: 0.7rem; border-radius: 2px;">
                                        <input type="number" step="0.01" name="labour_amount" placeholder="Labour (P)" required style="flex: 1; padding: 8px; background: var(--input-bg); color: var(--integrity-gold); border: 1px solid var(--border-ui); font-family: 'Courier Prime', monospace; font-size: 0.7rem; font-weight: bold; border-radius: 2px;">
                                    </div>
                                    <button type="submit" style="background: var(--integrity-gold); color: black; padding: 10px; font-weight: 900; border: none; border-radius: 2px; cursor: pointer; width: 100%; font-family: 'Montserrat', sans-serif; text-transform: uppercase; font-size: 0.65rem; letter-spacing: 1px; transition: 0.3s;" onmouseover="this.style.background='#a8823a'" onmouseout="this.style.background='var(--integrity-gold)'">💸 AUTHORIZE WORKSHOP PAYOUT</button>
                                </form>
                            </div>
                        </div> <div class="asset-inner-col">



                            <div style="background: var(--input-bg); border: 1px solid var(--border-ui); border-left: 4px solid var(--integrity-gold); border-radius: 4px; padding: 15px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed var(--border-ui); padding-bottom: 10px; margin-bottom: 10px;">
                                    <span style="font-family: 'Montserrat'; font-size: 0.75rem; color: var(--sanctified-blue); font-weight: bold; letter-spacing: 1px; text-transform: uppercase;">📸 Triple-Hero Verification</span>
                                    <span style="font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime';">REGISTRY ASSETS</span>
                                </div>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 10px;">

                                    <div style="text-align: center;">
                                        <div style="font-size: 0.6rem; color: var(--gold-text); font-family: 'Montserrat'; font-weight: bold; margin-bottom: 5px;">1. STANCE</div>
                                        {% if r.marketplace_image and r.marketplace_image|string|trim != '' and r.marketplace_image|string|lower not in ['none', 'null'] %}
                                            {% set raw_url1 = r.marketplace_image|string|trim %}
                                            {% if 'drive.google.com' in raw_url1 %}
                                                {% set gdrive_id1 = raw_url1.split('/d/')[1].split('/')[0] if '/d/' in raw_url1 else raw_url1.split('id=')[1].split('&')[0] %}
                                                {% set img1 = 'https://drive.google.com/thumbnail?id=' ~ gdrive_id1 ~ '&sz=w600' %}
                                                {% set link1 = raw_url1 %}
                                            {% elif raw_url1.startswith('http') %}
                                                {% set img1 = raw_url1 %}
                                                {% set link1 = raw_url1 %}
                                            {% else %}
                                                {% set clean_img1 = raw_url1|replace('/static/', '')|replace('static/', '')|replace('static\\', '') %}
                                                {% set img1 = url_for('static', filename=clean_img1) %}
                                                {% set link1 = img1 %}
                                            {% endif %}
                                            <a href="{{ link1 }}" target="_blank" style="display: block; position: relative; height: 80px; border: 1px solid var(--border-ui); border-radius: 2px; overflow: hidden; background: var(--input-bg);" title="DB Path: {{ raw_url1 }}">
                                                <img src="{{ img1 }}" style="width: 100%; height: 100%; object-fit: cover; transition: 0.3s;"
                                                     onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div style="display: none; height: 100%; flex-direction: column; align-items: center; justify-content: center; font-size: 0.5rem; color: var(--critical-red); font-family: 'Courier Prime'; text-transform: uppercase; padding: 5px; text-align: center; line-height: 1.2;">
                                                    [ LOCKED ]<br>
                                                    <span style="color: var(--text-muted); font-size: 0.45rem; margin-top: 3px;">Click to Open</span>
                                                </div>
                                            </a>
                                        {% else %}
                                            <div style="height: 80px; background: var(--input-bg); border: 1px dashed var(--border-ui); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase;">[ NO DATA ]</div>
                                        {% endif %}
                                    </div>

                                    <div style="text-align: center;">
                                        <div style="font-size: 0.6rem; color: var(--gold-text); font-family: 'Montserrat'; font-weight: bold; margin-bottom: 5px;">2. HEART</div>
                                        {% if r.marketplace_image_2 and r.marketplace_image_2|string|trim != '' and r.marketplace_image_2|string|lower not in ['none', 'null'] %}
                                            {% set raw_url2 = r.marketplace_image_2|string|trim %}
                                            {% if 'drive.google.com' in raw_url2 %}
                                                {% set gdrive_id2 = raw_url2.split('/d/')[1].split('/')[0] if '/d/' in raw_url2 else raw_url2.split('id=')[1].split('&')[0] %}
                                                {% set img2 = 'https://drive.google.com/thumbnail?id=' ~ gdrive_id2 ~ '&sz=w600' %}
                                                {% set link2 = raw_url2 %}
                                            {% elif raw_url2.startswith('http') %}
                                                {% set img2 = raw_url2 %}
                                                {% set link2 = raw_url2 %}
                                            {% else %}
                                                {% set clean_img2 = raw_url2|replace('/static/', '')|replace('static/', '')|replace('static\\', '') %}
                                                {% set img2 = url_for('static', filename=clean_img2) %}
                                                {% set link2 = img2 %}
                                            {% endif %}
                                            <a href="{{ link2 }}" target="_blank" style="display: block; position: relative; height: 80px; border: 1px solid var(--border-ui); border-radius: 2px; overflow: hidden; background: var(--input-bg);" title="DB Path: {{ raw_url2 }}">
                                                <img src="{{ img2 }}" style="width: 100%; height: 100%; object-fit: cover; transition: 0.3s;"
                                                     onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div style="display: none; height: 100%; flex-direction: column; align-items: center; justify-content: center; font-size: 0.5rem; color: var(--critical-red); font-family: 'Courier Prime'; text-transform: uppercase; padding: 5px; text-align: center; line-height: 1.2;">
                                                    [ LOCKED ]<br>
                                                    <span style="color: var(--text-muted); font-size: 0.45rem; margin-top: 3px;">Click to Open</span>
                                                </div>
                                            </a>
                                        {% else %}
                                            <div style="height: 80px; background: var(--input-bg); border: 1px dashed var(--border-ui); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase;">[ NO DATA ]</div>
                                        {% endif %}
                                    </div>

                                    <div style="text-align: center;">
                                        <div style="font-size: 0.6rem; color: var(--gold-text); font-family: 'Montserrat'; font-weight: bold; margin-bottom: 5px;">3. SANCTITY</div>
                                        {% if r.marketplace_image_3 and r.marketplace_image_3|string|trim != '' and r.marketplace_image_3|string|lower not in ['none', 'null'] %}
                                            {% set raw_url3 = r.marketplace_image_3|string|trim %}
                                            {% if 'drive.google.com' in raw_url3 %}
                                                {% set gdrive_id3 = raw_url3.split('/d/')[1].split('/')[0] if '/d/' in raw_url3 else raw_url3.split('id=')[1].split('&')[0] %}
                                                {% set img3 = 'https://drive.google.com/thumbnail?id=' ~ gdrive_id3 ~ '&sz=w600' %}
                                                {% set link3 = raw_url3 %}
                                            {% elif raw_url3.startswith('http') %}
                                                {% set img3 = raw_url3 %}
                                                {% set link3 = raw_url3 %}
                                            {% else %}
                                                {% set clean_img3 = raw_url3|replace('/static/', '')|replace('static/', '')|replace('static\\', '') %}
                                                {% set img3 = url_for('static', filename=clean_img3) %}
                                                {% set link3 = img3 %}
                                            {% endif %}
                                            <a href="{{ link3 }}" target="_blank" style="display: block; position: relative; height: 80px; border: 1px solid var(--border-ui); border-radius: 2px; overflow: hidden; background: var(--input-bg);" title="DB Path: {{ raw_url3 }}">
                                                <img src="{{ img3 }}" style="width: 100%; height: 100%; object-fit: cover; transition: 0.3s;"
                                                     onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div style="display: none; height: 100%; flex-direction: column; align-items: center; justify-content: center; font-size: 0.5rem; color: var(--critical-red); font-family: 'Courier Prime'; text-transform: uppercase; padding: 5px; text-align: center; line-height: 1.2;">
                                                    [ LOCKED ]<br>
                                                    <span style="color: var(--text-muted); font-size: 0.45rem; margin-top: 3px;">Click to Open</span>
                                                </div>
                                            </a>
                                        {% else %}
                                            <div style="height: 80px; background: var(--input-bg); border: 1px dashed var(--border-ui); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: var(--text-muted); font-family: 'Courier Prime'; text-transform: uppercase;">[ NO DATA ]</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="quote-section" style="border: 1px solid var(--border-ui); border-top: 3px solid var(--critical-red); padding: 20px; background: var(--card-bg); border-radius: 4px; margin-top: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
                                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-ui); padding-bottom: 10px; margin-bottom: 15px;">
                                    <h3 style="color: var(--critical-red); text-transform: uppercase; letter-spacing: 2px; margin: 0; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 900;">
                                        🔍 ZERO-TRUST FORENSIC TRAIL
                                    </h3>
                                    <span style="font-size: 0.65rem; color: var(--text-main); font-family: 'Courier Prime', monospace; text-transform: uppercase;">
                                        Live Hardware Stream Data
                                    </span>
                                </div>

                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 15px;">
                                    {% set required_cats = ['Vehicle Profile', 'Identity', 'The Fault', 'The Swap', 'The Install', 'The Seating'] %}

                                    {% for cat in required_cats %}
                                        {% set proof = r.proofs|selectattr('category', 'equalto', cat)|first if r.proofs else None %}

                                        <div style="background: var(--input-bg); border: 1px solid var(--border-ui); border-radius: 4px; overflow: hidden; text-align: center; display: flex; flex-direction: column;">
                                            <div style="font-family: 'Courier Prime', monospace; font-size: 0.6rem; color: var(--text-muted); padding: 8px 5px; background: #111; border-bottom: 1px solid var(--border-ui); text-transform: uppercase; font-weight: bold; letter-spacing: 1px;">
                                                {{ loop.index }}. {{ cat }}
                                            </div>

                                            <div style="height: 100px; background: #000; display: flex; align-items: center; justify-content: center; position: relative;">
                                                {% if proof %}
                                                    <img src="{{ url_for('static', filename=proof.file_name) }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.8;" alt="{{ cat }}">
                                                {% else %}
                                                    <span style="color: #333; font-size: 1.5rem;">🔒</span>
                                                {% endif %}
                                            </div>

                                            <div style="padding: 6px; font-size: 0.6rem; font-weight: 900; font-family: 'Inter', sans-serif; letter-spacing: 1px; color: {% if proof %}#000{% else %}var(--warning-orange){% endif %}; background: {% if proof %}var(--integrity-green){% else %}transparent{% endif %};">
                                                {% if proof %}✅ VERIFIED{% else %}AWAITING LENS{% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>














                        <div class="asset-inner-col">
                            <div class="yield-engine-panel" style="background: var(--card-bg); border: 1px solid var(--border-ui); padding: 25px; border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); width: 100%; box-sizing: border-box;">
                                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px; border-bottom: 1px solid #333; padding-bottom: 15px;">
                                    <div style="width: 40px; height: 40px; background: var(--integrity-gold); display: flex; align-items: center; justify-content: center; font-weight: 900; color: #000; border-radius: 2px; font-size: 1.2rem;">L</div>
                                    <div>
                                        <h3 style="color: var(--integrity-gold); margin: 0; font-family: 'Montserrat', sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px;">LAVETO YIELD ENGINE</h3>
                                        <span style="font-family: 'Courier Prime', monospace; font-size: 0.6rem; color: var(--text-muted);">Sovereign Contract Calculator v2.0</span>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                                    <div>
                                        <label style="display: block; font-size: 0.6rem; color: #ffffff; font-weight: 900; text-transform: uppercase; margin-bottom: 5px;">Principal (Pula)</label>
                                        <input type="number" id="p_calc_{{ r.id }}" oninput="autoAdjustTerm('{{ r.id }}')" placeholder="" value="{{ r.active_loan_principal or 0 }}" style="width: 100%; padding: 12px; background: #666; color: var(--integrity-gold); border: 1px solid var(--border-ui); font-family: 'Courier Prime', monospace; font-weight: bold; border-radius: 2px; box-sizing: border-box; font-size: 1rem;">
                                    </div>
                                    <div>
                                        <label style="display: block; font-size: 0.6rem; color: #ffffff; font-weight: 900; text-transform: uppercase; margin-bottom: 5px;">Interest (%)</label>
                                        <input type="number" id="r_calc_{{ r.id }}" value="15" style="width: 100%; padding: 12px; background: #666; color: var(--text-main); border: 1px solid var(--border-ui); font-family: 'Courier Prime', monospace; border-radius: 2px; box-sizing: border-box; font-size: 1rem;">
                                    </div>
                                </div>

                                <label style="display: block; font-size: 0.6rem; color: #ffffff; font-weight: 900; text-transform: uppercase; margin-top: 15px; margin-bottom: 5px;">Term (Months)</label>
                                <input type="number" id="n_calc_{{ r.id }}" value="24" readonly style="width: 100%; padding: 12px; background: #666; color: var(--text-main); border: 1px solid var(--border-ui); border-radius: 2px; box-sizing: border-box; cursor: not-allowed; font-family: 'Courier Prime', monospace; font-size: 1rem;">

                                <button onclick="calculateStandalone('{{ r.id }}')" style="width: 100%; background: var(--integrity-gold); color: #000; padding: 15px; margin-top: 25px; font-family: 'Montserrat', sans-serif; font-weight: 900; border: none; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; border-radius: 2px; transition: 0.3s;" onmouseover="this.style.filter='brightness(1.2)'" onmouseout="this.style.filter='brightness(1)'">
                                    Execute Contract Math
                                </button>

                                <div id="standaloneResult_{{ r.id }}" style="display: none; margin-top: 25px; text-align: center; border: 2px dashed #C5A059; padding: 25px; background: #000; color: #fff;">
                                    <label style="color: #C5A059; font-size: 0.7rem; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 2px;">Estimated Monthly Installment</label>
                                    <h1 id="standaloneOut_{{ r.id }}" style="font-size: 2.8rem; margin: 15px 0; font-family: 'Courier Prime', monospace; color: #fff;">P0.00</h1>
                                    <div style="display: flex; gap: 15px; justify-content: center; margin-top: 20px;">
                                        <button onclick="printTerminalQuote('{{ r.id }}')" style="background: transparent; border: 1px solid #fff; color: #fff; padding: 10px 20px; font-size: 0.7rem; cursor: pointer; text-transform: uppercase; font-family: 'Montserrat'; font-weight: bold;">📥 PRINT QUOTE</button>
                                        <button onclick="shareViaWhatsApp('{{ r.id }}')" style="background: #25D366; border: none; color: #000; padding: 10px 20px; font-size: 0.7rem; cursor: pointer; font-weight: 900; text-transform: uppercase; font-family: 'Montserrat';">💬 SHARE WHATSAPP</button>
                                        <button onclick="document.getElementById('standaloneResult_{{ r.id }}').style.display='none'" style="background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); padding: 10px 20px; font-size: 0.7rem; cursor: pointer; font-weight: 900; text-transform: uppercase; font-family: 'Montserrat'; transition: 0.2s;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='var(--critical-red)';">❌ CANCEL</button>
                                    </div>
                                </div>
                            </div>

                            {% if r.listed_for_sale %}
                                <div style="background: rgba(40, 167, 69, 0.08); color: var(--integrity-green); font-family: 'Courier Prime', monospace; font-size: 0.8rem; padding: 10px; border-radius: 4px; font-weight: 900; text-align: center; border: 1px dashed var(--integrity-green); letter-spacing: 1px; text-shadow: 0 0 10px rgba(40,167,69,0.3); margin-top: 15px;">🛡️ LISTED FOR SALE @ P{{ "{:,.0f}".format(r.asking_price) }}</div>
                                <div style="display: flex; gap: 10px; margin-top: 10px;">
                                    <form action="#" method="POST" style="flex: 1; margin: 0;" onsubmit="alert('Listing engine offline'); return false;">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" style="background: transparent; color: var(--text-muted); border: 1px solid var(--border-ui); padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; font-size: 0.65rem; cursor: pointer; transition: 0.2s; width: 100%; border-radius: 2px;" onmouseover="this.style.borderColor='var(--critical-red)'; this.style.color='var(--critical-red)';" onmouseout="this.style.borderColor='var(--border-ui)'; this.style.color='var(--text-muted)';">❌ CANCEL</button>
                                    </form>
                                    <form action="{{ url_for('hangar.override_asset') }}" method="POST" style="flex: 1; margin: 0;" onsubmit="return confirm('Silence the Action Required alarm for this asset?');">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <input type="hidden" name="entry_id" value="{{ r.id }}">
                                        <input type="hidden" name="status" value="STABLE">
                                        <button type="submit" style="background: transparent; color: var(--integrity-green); border: 1px solid var(--integrity-green); padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; font-size: 0.65rem; cursor: pointer; transition: 0.2s; width: 100%; border-radius: 2px;" onmouseover="this.style.background='var(--integrity-green)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-green)';">✅ MARK HANDLED</button>
                                    </form>
                                </div>
                                <a href="#" onclick="alert('Settlement Payout Generator Offline'); return false;" target="_blank" style="background: var(--integrity-gold); color: #000; border: 1px solid var(--integrity-gold); padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 1px; cursor: pointer; transition: 0.2s; width: 100%; border-radius: 2px; text-align: center; text-decoration: none; display: block; box-sizing: border-box; box-shadow: 0 4px 10px rgba(197, 160, 89, 0.2); margin-top: 10px;">🧾 GENERATE SETTLEMENT PAYOUT</a>
                            {% else %}
                                {% if 'SALE' in safe_status or 'LIQUIDATION' in safe_status %}
                                    <div style="background: #0d1117; border: 1px solid #30363d; padding: 20px; border-radius: 4px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.5); margin-top: 15px;">
                                        <div style="background: rgba(197, 160, 89, 0.05); border-left: 4px solid var(--integrity-gold); border-radius: 2px; padding: 12px 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #30363d; border-right: 1px solid #30363d; border-bottom: 1px solid #30363d;">
                                            <span style="color: var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase; display: flex; align-items: center; gap: 8px;">
                                                <span style="display:inline-block; width:8px; height:8px; background:var(--integrity-gold); border-radius:50%; box-shadow:0 0 10px var(--integrity-gold); animation: pulse-icon 2s infinite;"></span>
                                                APPRAISAL REQUESTED
                                            </span>
                                            <form action="{{ url_for('hangar.override_asset') }}" method="POST" style="margin: 0;">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="entry_id" value="{{ r.id }}">
                                                <input type="hidden" name="status" value="STABLE">
                                                <button type="submit" style="background: transparent; border: 1px solid var(--integrity-gold); color: var(--integrity-gold); border-radius: 2px; cursor: pointer; font-size: 0.6rem; font-weight: 900; font-family: 'Montserrat', sans-serif; padding: 5px 10px; transition: 0.2s; text-transform: uppercase;" onmouseover="this.style.background='var(--integrity-gold)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-gold)';">FIX STUCK STATUS</button>
                                            </form>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endif %}

                            {% if r.transactions %}
                                <div style="background: rgba(102, 179, 255, 0.05); border: 1px solid #66b3ff; border-left: 4px solid #66b3ff; padding: 15px; border-radius: 2px; margin-bottom: 15px; box-shadow: 0 0 15px rgba(102, 179, 255, 0.15); margin-top: 15px;">
                                    <h4 style="color: #66b3ff; margin: 0 0 10px 0; font-size: 0.75rem; text-transform: uppercase; font-family:'Montserrat', sans-serif; letter-spacing: 1px;">📋 Transaction History & Logs</h4>
                                    <div class="mini-log-container scroll-hide" style="border-color: rgba(102, 179, 255, 0.2); background: var(--input-bg); margin-top: 0; max-height: 250px; overflow-y: auto;">
                                        {% for tx in r.transactions|reverse %}
                                            <div class="mini-log-row" style="border-bottom: 1px solid var(--border-ui); grid-template-columns: 85px 1fr 90px; display: grid; gap: 10px; padding: 8px 10px; align-items: center;">
                                                <div style="color: var(--text-muted); font-family: 'Courier Prime', monospace; font-size: 0.6rem;">{{ tx.timestamp.strftime('%b %d, %y') if tx.timestamp else 'NEW' }}</div>
                                                <div style="color: #FFFFFF; font-family: 'Courier Prime', monospace; font-size: 0.65rem; line-height: 1.4;">{{ tx.intent }}</div>
                                                <div style="text-align: right; font-family: 'Courier Prime', monospace; font-weight: bold; font-size: 0.65rem; color: {% if tx.amount > 0 %}#28a745{% elif tx.amount < 0 %}#ff4444{% else %}#888888{% endif %};">
                                                    {% if tx.amount != 0 %}{{ "P{:,.2f}".format(tx.amount) }}{% else %}[LOG]{% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="action-btn-row" style="display: flex; gap: 10px; margin-top: 30px; border-top: 1px dashed var(--border-ui); padding-top: 20px; width: 100%; box-sizing: border-box;">
                        <a href="{{ url_for('hangar.inspection_desk', entry_id=r.id) }}" style="flex: 1; padding: 12px; background: transparent; color: var(--integrity-gold); border: 1px solid var(--integrity-gold); font-family: 'Montserrat', sans-serif; font-size: 0.65rem; font-weight: 900; text-transform: uppercase; text-align: center; text-decoration: none; border-radius: 2px; transition: 0.2s;" onmouseover="this.style.background='var(--integrity-gold)'; this.style.color='#000';" onmouseout="this.style.background='transparent'; this.style.color='var(--integrity-gold)';">🔬 EDIT INSPECTION</a>
                        <form action="{{ url_for('hangar.purge_asset', entry_id=r.id) }}" method="POST" style="flex: 1; margin: 0; display: flex; flex-direction: column; gap: 5px;" onsubmit="return confirm('💀 FINAL WARNING: This action is irreversible. Proceed with Purge?');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <input type="password" name="admin_pin" placeholder="ENTER PIN" required style="width: 100%; padding: 8px; background: rgba(255,0,0,0.05); color: var(--critical-red); border: 1px solid var(--critical-red); font-family: 'Courier Prime', monospace; font-size: 0.65rem; border-radius: 2px; text-align: center; letter-spacing: 2px; box-sizing: border-box; outline: none; transition: 0.3s;" onfocus="this.style.background='var(--input-bg)';">
                            <button type="submit" style="width: 100%; padding: 10px; background: transparent; color: var(--critical-red); border: 1px solid var(--critical-red); font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; cursor: pointer; border-radius: 2px; transition: 0.2s;" onmouseover="this.style.background='var(--critical-red)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='var(--critical-red)';">💀 SECURE PURGE</button>
                        </form>
                        </div>

                <div id="ledgerModal_{{ r.id }}" class="secure-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.95); z-index: 999999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
                    <div style="background: #000; border: 2px solid var(--sanctified-blue); width: 100%; max-width: 800px; max-height: 80vh; display: flex; flex-direction: column; border-radius: 4px; box-shadow: 0 0 50px rgba(0, 85, 255, 0.3);">

        <div style="padding: 20px; overflow-y: auto; flex: 1;">
            <table style="width: 100%; border-collapse: collapse; color: var(--text-main);">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-ui);">
                        <th style="padding: 10px; text-align: left; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Date / Time</th>
                        <th style="padding: 10px; text-align: left; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Intent</th>
                        <th style="padding: 10px; text-align: right; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase;">Amount</th>
                    </tr>
                </thead>
                <tbody style="font-family: 'Courier Prime', monospace; font-size: 0.85rem;">
                    {% if r.transactions %}
                        {% for tx in r.transactions|reverse %}
                        <tr style="border-bottom: 1px solid #222;">
                            <td style="padding: 10px;">{{ tx.timestamp.strftime('%Y-%m-%d %H:%M') if tx.timestamp else 'N/A' }}</td>
                            <td style="padding: 10px;">{{ tx.intent }}</td>
                            <td style="padding: 10px; text-align: right; color: {{ '#28a745' if tx.amount > 0 else '#ff0000' }}; font-weight: bold;">
                                P{{ "{:,.2f}".format(tx.amount) }}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="3" style="padding: 30px; text-align: center; color: var(--text-muted); font-style: italic;">
                                [ NO TRANSACTION HISTORY DETECTED ]
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
                    <div id="manual_upload_{{ r.id }}" style="display: none; margin-top: 10px; padding: 15px; background: rgba(255,0,0,0.05); border: 1px dashed var(--critical-red); border-radius: 2px; box-sizing: border-box; width: 100%;">
                        <form action="#" method="POST" enctype="multipart/form-data" onsubmit="alert('Manual Image Upload API Offline'); return false;">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                            <label style="font-family: 'Montserrat', sans-serif; font-size: 0.6rem; color: var(--critical-red); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; display: block; font-weight: bold;">ADMIN OVERRIDE: BYPASS WARDEN CAPTURE</label>
                            <div style="display: grid; grid-template-columns: 1fr; gap: 5px; box-sizing: border-box; width: 100%;">
                                <label for="market1_{{ r.id }}" class="camera-trigger" id="label_market1_{{ r.id }}" style="box-sizing: border-box; width: 100%;">📂 UPLOAD STANCE (FRONT)</label>
                                <input type="file" id="market1_{{ r.id }}" name="marketplace_image" accept="image/*" style="display: none;" onchange="markCaptured('market1_{{ r.id }}')">
                                <label for="market2_{{ r.id }}" class="camera-trigger" id="label_market2_{{ r.id }}" style="box-sizing: border-box; width: 100%;">📂 UPLOAD HEART (SIDE)</label>
                                <input type="file" id="market2_{{ r.id }}" name="marketplace_image_2" accept="image/*" style="display: none;" onchange="markCaptured('market2_{{ r.id }}')">
                                <label for="market3_{{ r.id }}" class="camera-trigger" id="label_market3_{{ r.id }}" style="box-sizing: border-box; width: 100%;">📂 UPLOAD SANCTITY (INTERIOR)</label>
                                <input type="file" id="market3_{{ r.id }}" name="marketplace_image_3" accept="image/*" style="display: none;" onchange="markCaptured('market3_{{ r.id }}')">
                                <button type="submit" style="background-color: var(--critical-red); color: white; border: none; padding: 10px; font-family: 'Montserrat', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; border-radius: 2px; transition: 0.2s; font-size: 0.65rem; width: 100%; margin-top: 10px; box-sizing: border-box;">FORCE UPLOAD VISUALS</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    {% endif %}
{% endfor %}

<div id="masterKeyModal" class="secure-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 20000; align-items: center; justify-content: center;">
    <div class="modal-content-box" style="background: var(--panel-bg); border: 2px solid var(--integrity-gold); padding: 40px; border-radius: 4px; max-width: 600px; width: 90%; color: var(--text-main); position: relative;">
        <button class="modal-close-btn" onclick="document.getElementById('masterKeyModal').style.display='none'" style="position: absolute; top: 15px; right: 15px; background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); cursor: pointer; padding: 5px 10px; font-weight: 900;">X CLOSE</button>
        <h2 style="color: var(--gold-text); font-family: 'Montserrat', sans-serif; text-transform: uppercase; margin-top: 0; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px;">🔑 ARCHITECT ROOT ACCESS</h2>
        <form action="{{ url_for('hangar.verify_root') }}" method="POST" style="margin-top: 20px;">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="password" name="admin_pin" placeholder="****" required style="width: 100%; padding: 15px; background: var(--input-bg); color: var(--text-main); border: 2px solid var(--sanctified-blue); font-family: 'Courier Prime'; font-size: 2rem; text-align: center; letter-spacing: 15px; margin-bottom: 15px;">
            <button type="submit" style="width: 100%; background: var(--sanctified-blue); color: white; border: none; padding: 15px; font-weight: 900; cursor: pointer;">VERIFY UPLINK</button>
        </form>
    </div>
</div>

<div id="sopModal" class="secure-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 20000; align-items: center; justify-content: center;">
    <div class="modal-content-box" style="background: var(--panel-bg); border: 2px solid var(--integrity-gold); padding: 40px; border-radius: 4px; max-width: 600px; width: 90%; color: var(--text-main); position: relative;">
        <button class="modal-close-btn" onclick="document.getElementById('sopModal').style.display='none'" style="position: absolute; top: 15px; right: 15px; background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); cursor: pointer; padding: 5px 10px; font-weight: 900;">X CLOSE</button>
        <h2 style="color: var(--gold-text); font-family: 'Montserrat', sans-serif; text-transform: uppercase; margin-top: 0; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px;">📸 Triple-Hero Photo S.O.P.</h2>
        <div style="margin-top: 25px; display: flex; flex-direction: column; gap: 15px;">
            <div style="background: var(--input-bg); padding: 15px; border-left: 4px solid var(--integrity-gold);">
                <h4 style="margin: 0 0 5px 0; color: var(--text-main);">1. THE STANCE</h4>
                <p style="margin: 0; font-size: 0.75rem; color: var(--text-muted);">45-degree front-quarter capture.</p>
            </div>
            <div style="background: var(--input-bg); padding: 15px; border-left: 4px solid var(--integrity-gold);">
                <h4 style="margin: 0 0 5px 0; color: var(--text-main);">2. THE HEART</h4>
                <p style="margin: 0; font-size: 0.75rem; color: var(--text-muted);">Dead-on profile shot or engine bay.</p>
            </div>
            <div style="background: var(--input-bg); padding: 15px; border-left: 4px solid var(--integrity-gold);">
                <h4 style="margin: 0 0 5px 0; color: var(--text-main);">3. THE SANCTITY</h4>
                <p style="margin: 0; font-size: 0.75rem; color: var(--text-muted);">Centered interior dashboard capture.</p>
            </div>
        </div>
    </div>
</div>

<div id="armoryModal" class="secure-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 20000; align-items: center; justify-content: center;">
    <div class="modal-content-box" style="background: var(--panel-bg); border: 2px solid var(--integrity-gold); padding: 40px; border-radius: 4px; max-width: 600px; width: 90%; color: var(--text-main); position: relative;">
        <button class="modal-close-btn" onclick="document.getElementById('armoryModal').style.display='none'" style="position: absolute; top: 15px; right: 15px; background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); cursor: pointer; padding: 5px 10px; font-weight: 900;">X CLOSE</button>
        <h2 style="color: var(--gold-text); font-family: 'Montserrat', sans-serif; text-transform: uppercase; margin-top: 0; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px;">📜 COMMAND SCRIPTS</h2>
        <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 10px;">
            <button onclick="copyTacticalScript(this, 'Greetings from Laveto Command. Your vehicle is undergoing forensic audit.')" style="background: #111; border: 1px solid #444; color: #ccc; padding: 12px; text-align: left; cursor: pointer;">01. FORENSIC AUDIT INITIATED</button>
            <button onclick="copyTacticalScript(this, '⚠️ LAVETO TRIAGE ALERT: Asset locked in Bay 01 pending High Command authorization.')" style="background: #111; border: 1px solid #444; color: #ccc; padding: 12px; text-align: left; cursor: pointer;">02. ASSET TRIAGE LOCKDOWN</button>
            <button onclick="copyTacticalScript(this, '🚨 MAYDAY PROTOCOL ACTIVE: All Laveto Field Agents converge on broadcast coordinates.')" style="background: #111; border: 1px solid #444; color: #ccc; padding: 12px; text-align: left; cursor: pointer;">03. MAYDAY FIELD BROADCAST</button>
            <div id="scriptStatusTarget" style="color: #d4af37; font-size: 0.8rem; text-align: center; height: 15px; margin-top: 5px;"></div>
        </div>
    </div>
</div>

<div id="globalLedgerModal" class="secure-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.95); z-index: 999999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
    <div style="background: #000; border: 2px solid var(--sanctified-blue); width: 100%; max-width: 800px; max-height: 80vh; display: flex; flex-direction: column; border-radius: 4px; box-shadow: 0 0 50px rgba(0, 85, 255, 0.3);">
        <div style="padding: 20px 30px; border-bottom: 1px solid var(--border-ui); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 id="ledgerModalTitle" style="font-family: 'Playfair Display', serif; color: var(--sanctified-blue); margin: 0; font-size: 1.5rem; text-transform: uppercase;">SOVEREIGN LEDGER</h2>
            </div>
            <button onclick="document.getElementById('globalLedgerModal').style.display='none'" style="background: transparent; border: 1px solid var(--critical-red); color: var(--critical-red); cursor: pointer; padding: 8px 16px; font-weight: 900; font-family: 'Montserrat'; border-radius: 2px;">X CLOSE</button>
        </div>
        <div id="ledgerModalBody" style="padding: 20px; overflow-y: auto; flex: 1; color: var(--text-main);">
             <p style="text-align: center; color: var(--text-muted);">Select an asset to view transaction history.</p>
        </div>
    </div>
</div>

<div id="moduleModal" class="secure-modal">
    <div class="modal-content-box">
        <button class="modal-close-btn" onclick="document.getElementById('moduleModal').style.display='none'">X CLOSE</button>
        <h2 id="modalTitle" style="color: var(--integrity-gold); font-family: 'Montserrat', sans-serif; text-transform: uppercase; margin-top: 0; border-bottom: 1px dashed var(--border-ui); padding-bottom: 15px;"></h2>
        <div id="modalContent" style="color: var(--text-main); font-family: 'Inter', sans-serif; line-height: 1.6; margin-top: 20px;">
        </div>
    </div>
</div>

<div id="rejectionModal" class="modal-overlay" style="display: none; position: fixed; z-index: 20000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.90); align-items: center; justify-content: center;">
    <div class="modal-content" style="max-width: 450px; background: var(--panel-bg); border: 2px solid var(--critical-red); border-radius: 4px;">
        <div class="modal-header" style="background: var(--table-header); border-bottom: 1px solid var(--border-ui); display: flex; justify-content: space-between; padding: 20px;">
            <h2 style="font-family: 'Montserrat', sans-serif; color: #dc3545; margin: 0;">REJECTION SIGNAL</h2>
            <span class="close-trigger" style="cursor: pointer; color: var(--text-muted);" onclick="document.getElementById('rejectionModal').style.display='none'">✕</span>
        </div>
        <div class="modal-body-scroll" style="padding: 20px;">
            <form action="{{ url_for('hangar.disapprove_intake') }}" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="prospect_id" id="modalProspectId">
                <label style="color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase;">REJECTION REASON</label>
                <select name="reason" required style="width: 100%; padding: 12px; margin-bottom: 20px; background: var(--input-bg); color: var(--text-main); border: 1px solid var(--border-ui);">
                    <option value="VIN_INVALID">VIN/DNA Sequence Invalid</option>
                    <option value="CLASS_MISMATCH">Vehicle Class Mismatch</option>
                    <option value="DOSSIER_INCOMPLETE">Dossier Incomplete</option>
                    <option value="TRAUMA_UNCLEAR">Fault Report Unclear</option>
                    <option value="COVENANT_DECLINED">Covenant Terms Not Accepted</option>
                </select>
                <button type="submit" class="btn-solid" style="background: #dc3545; color: white; width: 100%; padding: 15px; border: none; font-weight: bold; cursor: pointer;">TRANSMIT REJECTION SIGNAL</button>
            </form>
        </div>
    </div>
</div>

<script>
    // Injects the route into the global browser context
    window.PULSE_URL = "{{ url_for('hangar.update_contact') }}";
</script>
<script src="{{ url_for('static', filename='js/ledger_engine.js') }}"></script>
{% endblock %}