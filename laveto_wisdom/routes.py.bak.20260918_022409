@wisdom_bp.route("/audit/<audit_id>")
def view_audit(audit_id):
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        row = cur.execute("SELECT * FROM wisdom_audits WHERE audit_id = ? OR audit_id LIKE ? OR audit_id LIKE ?", (audit_id, f"%{audit_id}%", f"{audit_id.replace('-V2', '').replace('-v2', '')}%")).fetchone()
    finally:
        conn.close()

    if not row:
        return render_template_string("""
        <div style="background:#050811; color:#F1F5F9; font-family:sans-serif; padding:2.5rem; text-align:center;">
            <h2 style="color:#EF4444; margin-bottom: 0.5rem;">Audit Record Not Found</h2>
            <p style="color:#94A3B8; font-size:0.95rem;">Registry record <code>{{ audit_id }}</code> could not be located in the ledger.</p>
            <a href="/wisdom/" style="display:inline-block; margin-top:1rem; background:#D97706; color:#000; padding:8px 16px; border-radius:4px; text-decoration:none; font-weight:700;">&larr; Return to Assurance Console</a>
        </div>
        """, audit_id=audit_id), 404

    row_dict = dict(row)
    try:
        audit_data = json.loads(row_dict["dossier_json"]) if row_dict.get("dossier_json") else {}
    except Exception:
        audit_data = {}

    audit_data.setdefault("audit_id", row_dict.get("audit_id", audit_id))
    audit_data.setdefault("posture", row_dict.get("final_posture", "HALT"))
    audit_data.setdefault("wisdom_quotient", row_dict.get("wisdom_quotient", 0.0))
    audit_data.setdefault("proposal", row_dict.get("proposal_text", ""))
    audit_data.setdefault("passes", {})
    if "creative_proposals" not in audit_data:
