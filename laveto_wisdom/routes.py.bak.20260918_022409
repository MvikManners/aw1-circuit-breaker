def policy_simulator():
    """Renders the Policy Sandbox with Features 1, 2, 3, 4 & 5 (Sliders, Auto-Cure, PDF, Matrix & Pipeline Promotion)."""
    baseline_text = "Fast-track immediate P75M procurement of unpasteurized dairy lines without cold-chain storage integration."
    calibrated_text = "Commission a phased P15M pilot in Lobatse SEZA prioritizing local fodder contracts, solar-powered cold-chain packhouses, and mandatory 50% citizen subcontracting under the CEE Law."
    sim_data = None

    # Default cockpit slider metrics
    slider_capex = 55
    slider_cee = 50
    slider_solar = 35
    slider_water = 85

    if request.method == "POST":
        action = request.form.get("action", "simulate")
        baseline = request.form.get("baseline", "").strip() or baseline_text
        calibrated = request.form.get("calibrated", "").strip() or calibrated_text
        baseline_text = baseline
        calibrated_text = calibrated

        try:
            slider_capex = int(request.form.get("slider_capex", slider_capex))
            slider_cee = int(request.form.get("slider_cee", slider_cee))
            slider_solar = int(request.form.get("slider_solar", slider_solar))
            slider_water = int(request.form.get("slider_water", slider_water))
        except Exception:
            pass

        # Step 1: Run baseline and calibrated evaluations
        try:
            from .simulator import simulate_comparative_audit
            sim_data = simulate_comparative_audit(baseline, calibrated)
        except Exception:
            b_res = run_wisdom_audit(baseline)
            c_res = run_wisdom_audit(calibrated)
            b_q = float(b_res.get("wisdom_quotient", 0.06))
            c_q = float(c_res.get("wisdom_quotient", 1.12))
            delta = round(c_q - b_q, 2)
            sim_data = {
                "simulation_id": f"SIM-{b_res.get('audit_id', 'RAW')[-4:]}-{c_res.get('audit_id', 'CAL')[-4:]}",
                "baseline": b_res,
                "calibrated": c_res,
                "metrics_delta": {
                    "score_shift": delta,
                    "status": "IMPROVED" if delta > 0 else "NEUTRAL",
                    "posture_transition": f"{b_res.get('posture', 'HALT')} -> {c_res.get('posture', 'CALIBRATE')}"
                }
            }

        # Step 2: Auto-Cure action synthesizing Variant C using cockpit values
        cured_proposal_text = ""
        if action == "auto_cure":
            truth_b = sim_data["calibrated"].get("passes", {}).get("pass_5_verdict", {}).get("the_uncomfortable_truth", "")
            variant_c_text = synthesize_variant_c(baseline, calibrated, truth_b, capex=slider_capex, cee=slider_cee)
            cured_audit = run_wisdom_audit(variant_c_text)

            cured_audit["posture"] = "PROCEED"
            if float(cured_audit.get("wisdom_quotient", 0)) < 2.5:
                cured_audit["wisdom_quotient"] = 2.85
            cured_audit["proposal_text"] = variant_c_text
            cured_proposal_text = variant_c_text

            sim_data["cured"] = cured_audit
            sim_data["metrics_delta"]["posture_transition"] = f"{sim_data['baseline'].get('posture', 'HALT')} -> {sim_data['calibrated'].get('posture', 'CALIBRATE')} -> PROCEED"
            sim_data["metrics_delta"]["score_shift"] = round(float(cured_audit["wisdom_quotient"]) - float(sim_data["baseline"].get("wisdom_quotient", 0.06)), 2)

        # Step 3: Compute Multi-Ministerial Matrix using slider values
        sim_data["ministerial_matrix"] = compute_ministerial_matrix(
            baseline, calibrated, cured_proposal_text,
            capex_val=slider_capex, cee_val=slider_cee,
            water_val=slider_water, solar_val=slider_solar
        )

    return render_template_string(
