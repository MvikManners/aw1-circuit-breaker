def analytics():
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        total_audits = cur.execute("SELECT COUNT(*) as count FROM wisdom_audits").fetchone()["count"]
        halt_audits = cur.execute("SELECT COUNT(*) as count FROM wisdom_audits WHERE final_posture = 'HALT'").fetchone()["count"]
        cal_audits = cur.execute("SELECT COUNT(*) as count FROM wisdom_audits WHERE final_posture = 'CALIBRATE'").fetchone()["count"]
        proc_audits = cur.execute("SELECT COUNT(*) as count FROM wisdom_audits WHERE final_posture = 'PROCEED'").fetchone()["count"]
        avg_w = cur.execute("SELECT AVG(wisdom_quotient) as avg_w FROM wisdom_audits").fetchone()["avg_w"] or 0.0
        api_calls = cur.execute("SELECT COUNT(*) as count FROM wisdom_api_usage WHERE timestamp >= datetime('now', 'start of month')").fetchone()["count"]

        recent_audits = cur.execute(
            "SELECT audit_id, created_at, proposal_text, final_posture, wisdom_quotient FROM wisdom_audits ORDER BY id DESC LIMIT 12"
        ).fetchall()

        tenant_telemetry = cur.execute("""
            SELECT c.institution_name, c.sector, c.tier, c.monthly_quota,
                   (c.monthly_quota - COUNT(u.id)) as remaining_quota,
                   COUNT(u.id) as current_month_usage
            FROM wisdom_api_clients c
            LEFT JOIN wisdom_api_usage u ON c.client_id = u.client_id AND u.timestamp >= datetime('now', 'start of month')
            GROUP BY c.client_id
            ORDER BY current_month_usage DESC
        """).fetchall()

        halt_rate = round((halt_audits / total_audits * 100), 1) if total_audits > 0 else 0.0
        halt_pct = round((halt_audits / total_audits * 100), 1) if total_audits > 0 else 0.0
        cal_pct = round((cal_audits / total_audits * 100), 1) if total_audits > 0 else 0.0
        proc_pct = round((proc_audits / total_audits * 100), 1) if total_audits > 0 else 0.0

        stats = {
