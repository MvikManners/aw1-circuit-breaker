@wisdom_bp.route("/ledger/verify")
def verify_ledger():
    conn = get_db_connection()
    rows = conn.cursor().execute("SELECT id, audit_id, version, prev_hash, audit_hash FROM wisdom_audits ORDER BY id ASC").fetchall()
    conn.close()
    blocks = []
    chain_intact = True
    for idx, r in enumerate(rows):
        link_intact = True
        if idx > 0 and r["prev_hash"] != rows[idx-1]["audit_hash"]:
            link_intact = False
            chain_intact = False
        blocks.append({
            "height": r["id"],
            "audit_id": r["audit_id"],
            "version": r["version"] or 1,
            "prev_hash": r["prev_hash"] or "GENESIS",
            "audit_hash": r["audit_hash"] or "N/A",
            "link_intact": link_intact,
            "hash_intact": True
        })
    report = {
        "chain_intact": chain_intact,
        "total_blocks": len(blocks),
        "blocks": blocks
    }
    return render_template_string(HTML_LEDGER_VIEW, report=report)

