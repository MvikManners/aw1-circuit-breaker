        .slider-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 10px; }
        .slider-box { background: #0B1120; border: 1px solid #1E293B; border-radius: 6px; padding: 12px; }
        .slider-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .slider-header span { font-size: 0.75rem; font-weight: 700; color: #CBD5E1; text-transform: uppercase; }
        .slider-header strong { font-size: 0.9rem; color: #FBBF24; font-family: monospace; }
        input[type=range] { width: 100%; -webkit-appearance: none; background: #1E293B; height: 6px; border-radius: 3px; outline: none; margin: 8px 0; }
        input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #FBBF24; cursor: pointer; border: 2px solid #000; }
        .status-pill { font-size: 0.68rem; padding: 2px 6px; border-radius: 3px; display: inline-block; font-weight: bold; }
        .pill-pass { background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid #059669; }
        .pill-warn { background: rgba(234, 179, 8, 0.2); color: #FBBF24; border: 1px solid #D97706; }
        .pill-fail { background: rgba(220, 38, 38, 0.2); color: #F87171; border: 1px solid #DC2626; }
    </style>
</head>
<body>
<div class="container">
    <!-- UNCLUSTERED CLEAN BRANDING HEADER -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 2rem; background: #0D131F; border: 1px solid #1E293B; padding: 1.25rem 1.75rem; border-radius: 10px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <span style="font-size: 1.4rem; font-weight: 900; color: #FFFFFF; letter-spacing: 0.05em;">LAVETO</span>
            <span style="font-size: 1.4rem; font-weight: 900; color: #D97706; letter-spacing: 0.05em;">WISDOM</span>
            <span style="background: #1E293B; color: #FBBF24; border: 1px solid #D97706; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">AW</span>
            <span style="font-size: 0.75rem; color: #94A3B8; border-left: 1px solid #334155; padding-left: 12px; text-transform: uppercase; letter-spacing: 0.05em;">Policy Sandbox &amp; Simulator</span>
        </div>
        <a href="/wisdom/" style="color: #FBBF24; text-decoration: none; font-size: 0.9rem; font-weight: 600;">&larr; Assurance Console</a>
    </div>

    <div class="card">
        <div style="margin-bottom: 1.25rem;">
            <strong style="font-size: 0.85rem; color: #CBD5E1; display: block; margin-bottom: 8px;">⚡ Quick Presets (Click to Load):</strong>
            <button type="button" class="preset-btn" onclick="loadPreset('dairy')">🥛 Dairy Supply Deficit</button>
            <button type="button" class="preset-btn" onclick="loadPreset('tannery')">💧 Water &amp; Tannery Scarcity</button>
            <button type="button" class="preset-btn" onclick="loadPreset('solar')">☀️ SEZA Foreign IPP Solar</button>
        </div>

        <form method="POST" action="/wisdom/sandbox">
            <input type="hidden" name="action" value="simulate">

            <!-- FEATURE 4: INTERACTIVE POLICY CONSTRAINT SLIDERS (LIVE COCKPIT) -->
            <div class="cockpit-card">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 8px;">
                    <div>
                        <strong style="color: #FBBF24; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">
                            <span>🎛️</span> Statutory Policy Constraint Cockpit (Live Sliders)
                        </strong>
                        <div style="font-size: 0.75rem; color: #94A3B8;">Adjust regulatory thresholds in real-time before executing simulation</div>
                    </div>
                    <button type="button" onclick="injectSlidersIntoVariantB()" class="preset-btn" style="background: #111827; border: 1px solid #D97706; color: #FBBF24; margin: 0; padding: 4px 10px; font-size: 0.75rem;">
                        🔄 Auto-Inject Sliders into Variant B &rarr;
                    </button>
                </div>

                <div class="slider-row">
                    <!-- SLIDER 1: CAPEX -->
                    <div class="slider-box">
                        <div class="slider-header">
                            <span>Consortium CapEx</span>
                            <strong id="val-capex">BWP {{ slider_capex }}M</strong>
                        </div>
                        <input type="range" id="slider-capex" name="slider_capex" min="5" max="150" value="{{ slider_capex }}" oninput="updateSliders()">
                        <div id="badge-capex" class="status-pill {% if slider_capex >= 50 %}pill-pass{% else %}pill-warn{% endif %}">
                            {% if slider_capex >= 50 %}✅ Cleared: Exceeds P50M SEZA Hurdle{% else %}⚠️ Deficit: Below P50M SEZA Min. Threshold{% endif %}
                        </div>
                    </div>

                    <!-- SLIDER 2: CEE -->
                    <div class="slider-box">
                        <div class="slider-header">
                            <span>CEE Subcontracting</span>
                            <strong id="val-cee">{{ slider_cee }}%</strong>
                        </div>
                        <input type="range" id="slider-cee" name="slider_cee" min="0" max="100" value="{{ slider_cee }}" oninput="updateSliders()">
                        <div id="badge-cee" class="status-pill {% if slider_cee >= 50 %}pill-pass{% else %}pill-fail{% endif %}">
                            {% if slider_cee >= 50 %}✅ Compliant: Ring-fenced for Citizen SMMEs{% else %}⚠️ Breach: Under 50% Citizen Quota{% endif %}
                        </div>
                    </div>

                    <!-- SLIDER 3: SOLAR -->
                    <div class="slider-box">
                        <div class="slider-header">
                            <span>Captive Solar Share</span>
                            <strong id="val-solar">{{ slider_solar }}%</strong>
                        </div>
                        <input type="range" id="slider-solar" name="slider_solar" min="0" max="100" value="{{ slider_solar }}" oninput="updateSliders()">
                        <div id="badge-solar" class="status-pill {% if slider_solar >= 30 %}pill-pass{% else %}pill-warn{% endif %}">
                            {% if slider_solar >= 30 %}✅ Clean Energy: Zero-rated VAT PV Eligible{% else %}⚠️ High Grid Load: Vulnerable to BPC Tariffs{% endif %}
                        </div>
                    </div>

                    <!-- SLIDER 4: WATER -->
                    <div class="slider-box">
                        <div class="slider-header">
                            <span>Closed-Loop Water</span>
                            <strong id="val-water">{{ slider_water }}%</strong>
                        </div>
                        <input type="range" id="slider-water" name="slider_water" min="0" max="100" value="{{ slider_water }}" oninput="updateSliders()">
                        <div id="badge-water" class="status-pill {% if slider_water >= 75 %}pill-pass{% else %}pill-fail{% endif %}">
                            {% if slider_water >= 75 %}✅ Closed-Loop: 75%+ Reclamation Verified{% else %}⚠️ Water Act Risk: Heavy Aquifer Drawdown{% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- PROPOSAL TEXTAREAS -->
            <div class="grid-inputs">
                <div>
                    <label style="font-weight: 700; color: #EF4444; display: block; margin-bottom: 6px; font-size: 0.9rem;">Variant A: Baseline Dilemma</label>
                    <textarea id="raw-input" name="baseline" placeholder="Enter baseline capital expenditure or policy decree..." required>{{ baseline_text }}</textarea>
                </div>
                <div>
                    <label style="font-weight: 700; color: #10B981; display: block; margin-bottom: 6px; font-size: 0.9rem;">Variant B: Calibrated Alternative</label>
                    <textarea id="cal-input" name="calibrated" placeholder="Enter hedged, phased, or citizen-empowered alternative..." required>{{ calibrated_text }}</textarea>
                </div>
            </div>
            <button type="submit" class="btn-primary">🚀 Execute Comparative Simulation</button>
        </form>
    </div>

    {% if sim %}
    <div class="card" style="border-left: 4px solid var(--gold);">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px;">
            <div>
                <span style="font-size: 0.78rem; color: #94A3B8; text-transform: uppercase;">Simulation Trajectory</span>
                <h3 style="margin: 2px 0 0 0; color: var(--gold-light);">Dossier Reference: {{ sim.simulation_id }}</h3>
            </div>

            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span class="badge" style="background: #1E293B; border: 1px solid #475569; color: #CBD5E1;">{{ sim.metrics_delta.posture_transition }}</span>
                <span class="badge" style="background: {% if sim.metrics_delta.score_shift > 0 %}#065F46{% else %}#7F1D1D{% endif %}; color: #FFF;">
                    Shift: {% if sim.metrics_delta.score_shift > 0 %}+{% endif %}{{ sim.metrics_delta.score_shift }}
                </span>

                <!-- FEATURE 2: EXPORT CABINET POLICY MEMORANDUM PDF -->
                <form method="POST" action="/wisdom/sandbox/pdf" target="_blank" style="margin: 0; display: inline;">
                    <input type="hidden" name="simulation_id" value="{{ sim.simulation_id }}">
                    <input type="hidden" name="baseline" value="{{ baseline_text }}">
                    <input type="hidden" name="calibrated" value="{{ calibrated_text }}">
                    <input type="hidden" name="cured_text" value="{{ sim.cured.proposal_text if sim.cured else '' }}">
                    <input type="hidden" name="b_posture" value="{{ sim.baseline.posture }}">
                    <input type="hidden" name="b_quotient" value="{{ sim.baseline.wisdom_quotient }}">
                    <input type="hidden" name="b_truth" value="{{ sim.baseline.passes.pass_5_verdict.the_uncomfortable_truth if (sim.baseline and sim.baseline.passes and sim.baseline.passes.pass_5_verdict) else '' }}">
                    <input type="hidden" name="c_posture" value="{{ sim.calibrated.posture }}">
                    <input type="hidden" name="c_quotient" value="{{ sim.calibrated.wisdom_quotient }}">
                    <input type="hidden" name="c_truth" value="{{ sim.calibrated.passes.pass_5_verdict.the_uncomfortable_truth if (sim.calibrated and sim.calibrated.passes and sim.calibrated.passes.pass_5_verdict) else '' }}">
                    <input type="hidden" name="cured_quotient" value="{{ sim.cured.wisdom_quotient if sim.cured else '' }}">
                    <input type="hidden" name="slider_capex" value="{{ slider_capex }}">
                    <input type="hidden" name="slider_cee" value="{{ slider_cee }}">
                    <input type="hidden" name="slider_water" value="{{ slider_water }}">
                    <input type="hidden" name="slider_solar" value="{{ slider_solar }}">
                    <button type="submit" class="preset-btn" style="background: #1E293B; color: #FBBF24; border: 1px solid #D97706; padding: 7px 14px; margin: 0; font-weight: 800; cursor: pointer;">
                        📄 Export Cabinet Memorandum (PDF) &rarr;
                    </button>
                </form>

                <!-- FEATURE 1: AUTO-CURE BUTTON -->
                {% if not sim.cured and sim.calibrated.posture in ['CALIBRATE', 'HALT', 'RECALIBRATE'] %}
                <form method="POST" action="/wisdom/sandbox" style="margin: 0; display: inline;">
                    <input type="hidden" name="action" value="auto_cure">
                    <input type="hidden" name="baseline" value="{{ baseline_text }}">
                    <input type="hidden" name="calibrated" value="{{ calibrated_text }}">
                    <input type="hidden" name="slider_capex" value="{{ slider_capex }}">
                    <input type="hidden" name="slider_cee" value="{{ slider_cee }}">
                    <button type="submit" class="preset-btn" style="background: linear-gradient(90deg, #059669, #10B981); color: #FFF; font-weight: 800; border: none; padding: 7px 14px; margin: 0; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);">
                        🧬 Auto-Cure &amp; Synthesize Variant C (Target: PROCEED) &rarr;
                    </button>
                </form>
                {% endif %}
            </div>
        </div>

        <!-- COMPARATIVE PROPOSAL CARDS WITH FEATURE 5 PROMOTION ACTIONS -->
        <div class="{% if sim.cured %}comp-grid-3{% else %}comp-grid-2{% endif %}">
            <!-- VARIANT A -->
            <div style="background: #0D131F; border: 1px solid #334155; padding: 1.25rem; border-radius: 6px; border-top: 3px solid #DC2626; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <strong style="color: #FCA5A5;">Variant A (Baseline)</strong>
                        <span class="badge badge-{{ sim.baseline.posture }}">{{ sim.baseline.posture }}</span>
                    </div>
                    <p style="margin: 5px 0; font-size: 0.88rem;"><strong>Wisdom Quotient (𝒲):</strong> {{ sim.baseline.wisdom_quotient }}</p>
                    <div style="margin-top: 10px; font-size: 0.84rem; color: #EF4444; font-style: italic; line-height: 1.5;">
                        "{{ sim.baseline.passes.pass_5_verdict.the_uncomfortable_truth if (sim.baseline and sim.baseline.passes and sim.baseline.passes.pass_5_verdict) else 'Unhedged baseline identified statutory failure modes.' }}"
                    </div>
                </div>
            </div>

            <!-- VARIANT B -->
            <div style="background: #0D131F; border: 1px solid #334155; padding: 1.25rem; border-radius: 6px; border-top: 3px solid #EAB308; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <strong style="color: #FDE047;">Variant B (Calibrated)</strong>
                        <span class="badge badge-{{ sim.calibrated.posture }}">{{ sim.calibrated.posture }}</span>
                    </div>
                    <p style="margin: 5px 0; font-size: 0.88rem;"><strong>Wisdom Quotient (𝒲):</strong> {{ sim.calibrated.wisdom_quotient }}</p>
                    <div style="margin-top: 10px; font-size: 0.84rem; color: #FBBF24; font-style: italic; line-height: 1.5;">
                        "{{ sim.calibrated.passes.pass_5_verdict.the_uncomfortable_truth if (sim.calibrated and sim.calibrated.passes and sim.calibrated.passes.pass_5_verdict) else 'Bottlenecks identified in initial calibration.' }}"
                    </div>
                </div>

                <!-- FEATURE 5 PROMOTION BAR FOR VARIANT B -->
                <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid #1E293B; display: flex; gap: 6px; flex-wrap: wrap;">
                    <form method="POST" action="/wisdom/" style="margin: 0; flex: 1;">
                        <input type="hidden" name="proposal" value="{{ calibrated_text }}">
                        <button type="submit" class="preset-btn" style="width: 100%; justify-content: center; background: #111827; border-color: #38BDF8; color: #38BDF8; margin: 0;">
                            ⚖️ Promote to Console
                        </button>
                    </form>
                    <a href="/wisdom/generate?intent={{ calibrated_text | urlencode }}" class="preset-btn" style="flex: 1; justify-content: center; background: #111827; border-color: #FBBF24; color: #FBBF24; margin: 0;">
                        💡 Incubate
                    </a>
                </div>
            </div>

            <!-- VARIANT C (CURED TO PROCEED) -->
            {% if sim.cured %}
            <div style="background: #061912; border: 1px solid #059669; padding: 1.25rem; border-radius: 6px; border-top: 3px solid #10B981; box-shadow: 0 4px 14px rgba(16,185,129,0.15); display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <strong style="color: #34D399;">Variant C (Auto-Cured)</strong>
                        <span class="badge badge-PROCEED">PROCEED</span>
                    </div>
                    <p style="margin: 5px 0; font-size: 0.88rem;"><strong>Wisdom Quotient (𝒲):</strong> <span style="color: #34D399; font-weight: bold;">{{ sim.cured.wisdom_quotient }}</span></p>
                    <div style="margin-top: 8px; font-size: 0.82rem; color: #A7F3D0; line-height: 1.5;">
                        <strong>Statutory Resolution:</strong><br/>
                        {{ sim.cured.proposal_text }}
                    </div>
                    <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(16,185,129,0.3); font-size: 0.78rem; color: #6EE7B7;">
                        ✓ P50M SEZA Capital Threshold Cleared<br/>
                        ✓ Citizen Farming Cooperative Milk-Pooling Guaranteed<br/>
                        ✓ CEE 50% Subcontracting Mandate Sealed
                    </div>
                </div>

                <!-- FEATURE 5 PROMOTION BAR FOR VARIANT C -->
                <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid rgba(16,185,129,0.3); display: flex; gap: 6px; flex-wrap: wrap;">
                    <form method="POST" action="/wisdom/" style="margin: 0; flex: 1;">
                        <input type="hidden" name="proposal" value="{{ sim.cured.proposal_text }}">
                        <button type="submit" class="preset-btn" style="width: 100%; justify-content: center; background: #059669; border-color: #10B981; color: #FFF; font-weight: 800; margin: 0; box-shadow: 0 2px 6px rgba(16,185,129,0.4);">
                            ⚖️ Seal in Console &rarr;
                        </button>
                    </form>
                    <a href="/wisdom/generate?intent={{ sim.cured.proposal_text | urlencode }}" class="preset-btn" style="flex: 1; justify-content: center; background: #0D1F17; border-color: #059669; color: #6EE7B7; font-weight: 700; margin: 0;">
                        💡 Incubate PDF
                    </a>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- FEATURE 3: MULTI-MINISTERIAL TENSION SHIFT MATRIX -->
        {% if sim.ministerial_matrix %}
        <div style="margin-top: 1.75rem; border-top: 1px solid #1E293B; padding-top: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <div>
                    <h4 style="margin: 0; color: #FBBF24; font-size: 1.05rem; display: flex; align-items: center; gap: 6px;">
                        <span>🏛️</span> Multi-Ministerial Regulatory Tension Shift Matrix
                    </h4>
                    <p style="margin: 3px 0 0 0; font-size: 0.78rem; color: #94A3B8;">
                        Real-world statutory consensus transitions across key Botswana oversight authorities
                    </p>
                </div>
                <span style="font-size: 0.72rem; background: #0E1726; color: #94A3B8; border: 1px solid #1E293B; padding: 4px 8px; border-radius: 4px;">
                    Statutory Alignment Tracking Active
                </span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
                {% for key, min in sim.ministerial_matrix.items() %}
                <div style="background: #080D1A; border: 1px solid #1E293B; border-radius: 6px; padding: 12px; display: flex; flex-direction: column; justify-content: space-between;">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                            <strong style="color: #F1F5F9; font-size: 0.85rem;">{{ min.title }}</strong>
                        </div>
                        <div style="font-size: 0.72rem; color: #64748B; margin-bottom: 8px; line-height: 1.3;">
                            {{ min.mandate }}
                        </div>

                        <!-- Stance Progression -->
                        <div style="background: #030712; border: 1px solid #111827; border-radius: 4px; padding: 8px; margin-bottom: 8px; font-size: 0.75rem;">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                                <span style="color: #94A3B8;">Variant A:</span>
                                <span style="font-weight: bold; color: #EF4444;">{{ min.a_stance }} ❌</span>
                            </div>
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                                <span style="color: #94A3B8;">Variant B:</span>
                                <span style="font-weight: bold; color: {% if min.b_stance == 'ENDORSE' %}#10B981{% else %}#FBBF24{% endif %};">
                                    {{ min.b_stance }} {% if min.b_stance == 'ENDORSE' %}✅{% else %}⚠️{% endif %}
                                </span>
                            </div>
                            {% if sim.cured %}
                            <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px dashed #1F2937; padding-top: 4px;">
                                <span style="color: #94A3B8;">Variant C:</span>
                                <span style="font-weight: bold; color: #34D399;">{{ min.c_stance }} ✅</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    <div style="font-size: 0.75rem; color: {% if sim.cured %}#6EE7B7{% elif min.b_stance == 'ENDORSE' %}#CBD5E1{% else %}#FDE047{% endif %}; line-height: 1.35; font-style: italic;">
                        &ldquo;{% if sim.cured %}{{ min.c_note }}{% else %}{{ min.b_note }}{% endif %}&rdquo;
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}
</div>

<script>
const PRESETS = {
    dairy: {
        base: "Fast-track immediate P75M procurement of unpasteurized dairy lines without cold-chain storage integration.",
        cal: "Commission a phased P15M pilot in Lobatse SEZA prioritizing local fodder contracts, solar-powered cold-chain packhouses, and mandatory 50% citizen subcontracting under the CEE Law.",
        capex: 15, cee: 50, solar: 35, water: 80
    },
    tannery: {
        base: "Construct a P60M wet-blue commercial hide tannery in Lobatse drawing unmetered groundwater directly from local aquifers without closed-loop water treatment.",
        cal: "Construct a P50M tannery in Lobatse SEZA with mandatory closed-loop greywater recycling, effluent compliance under WUC standards, and local leather beneficiation.",
        capex: 50, cee: 50, solar: 25, water: 90
    },
    solar: {
        base: "Award a P120M turnkey grid-tied solar project to a foreign consortium without requiring local citizen sub-contracting or BERA net-metering review.",
        cal: "Deploy a P120M utility-scale solar facility adhering to BERA grid-code interconnection, utilizing zero-rated VAT components, and guaranteeing 50% citizen technical subcontracts.",
        capex: 120, cee: 50, solar: 100, water: 75
    }
};

function loadPreset(key) {
    if (PRESETS[key]) {
        var p = PRESETS[key];
        document.getElementById('raw-input').value = p.base;
        document.getElementById('cal-input').value = p.cal;
        document.getElementById('slider-capex').value = p.capex;
        document.getElementById('slider-cee').value = p.cee;
        document.getElementById('slider-solar').value = p.solar;
        document.getElementById('slider-water').value = p.water;
        updateSliders();
    }
}

function updateSliders() {
    var capex = document.getElementById('slider-capex').value;
    var cee = document.getElementById('slider-cee').value;
    var solar = document.getElementById('slider-solar').value;
    var water = document.getElementById('slider-water').value;

    document.getElementById('val-capex').innerText = 'BWP ' + capex + 'M';
    document.getElementById('val-cee').innerText = cee + '%';
    document.getElementById('val-solar').innerText = solar + '%';
    document.getElementById('val-water').innerText = water + '%';

    // CapEx Badge
    var bCapex = document.getElementById('badge-capex');
    if (parseInt(capex) < 50) {
        bCapex.className = 'status-pill pill-warn';
        bCapex.innerHTML = '⚠️ Deficit: Below P50M SEZA Min. Threshold';
    } else {
        bCapex.className = 'status-pill pill-pass';
        bCapex.innerHTML = '✅ Cleared: Exceeds P50M SEZA Hurdle';
    }

    // CEE Badge
    var bCee = document.getElementById('badge-cee');
    if (parseInt(cee) < 50) {
        bCee.className = 'status-pill pill-fail';
        bCee.innerHTML = '⚠️ Breach: Under 50% Citizen Quota';
    } else {
        bCee.className = 'status-pill pill-pass';
