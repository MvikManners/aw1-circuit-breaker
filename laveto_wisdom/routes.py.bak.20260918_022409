            if "text/html" in content_type or not content_type:
                html = response.get_data(as_text=True)
                widget_tag = '<script src="/wisdom/static/support_widget.js?v=20260918_clean"></script>'
                if 'support_widget.js' not in html:
                    match = re.search(r'</body\s*>', html, re.IGNORECASE)
                    if match:
                        idx = match.start()
                        html = html[:idx] + f"\n{widget_tag}\n" + html[idx:]
                        response.set_data(html)
                        response.headers.pop('Content-Length', None)
                    elif '</html>' in html:
                        html = html.replace('</html>', f'{widget_tag}\n</html>', 1)
